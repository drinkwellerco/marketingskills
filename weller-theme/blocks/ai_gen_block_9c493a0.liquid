{% doc %}
  @prompt
    I want a section that allows me to display the different articles that have been written online by prestigious magazines and news sites. A logo and a button that takes them to the article! make it nice and clean! Want alot of customization!
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-press-mentions-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-press-mentions__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-press-mentions__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-press-mentions__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    font-weight: {{ block.settings.heading_weight }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    text-transform: {{ block.settings.heading_text_transform }};
  }

  .ai-press-mentions__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    font-weight: {{ block.settings.subheading_weight }};
  }

  .ai-press-mentions__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_top_spacing }}px;
  }

  .ai-press-mention-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    border: {{ block.settings.card_border_width }}px {{ block.settings.card_border_style }} {{ block.settings.card_border_color }};
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.card_content_alignment }};
    text-align: {{ block.settings.card_text_alignment }};
    transition: all {{ block.settings.hover_transition_speed }}s ease;
    {% if block.settings.enable_card_shadow %}
      box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    {% endif %}
  }

  {% if block.settings.enable_hover_effect %}
    .ai-press-mention-card-{{ ai_gen_id }}:hover {
      transform: translateY({{ block.settings.hover_lift_amount }}px);
      {% if block.settings.enable_hover_shadow %}
        box-shadow: {{ block.settings.hover_shadow_x }}px {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_color }};
      {% endif %}
      {% if block.settings.enable_hover_background %}
        background-color: {{ block.settings.hover_background_color }};
      {% endif %}
    }
  {% endif %}

  .ai-press-mention-card__logo-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.logo_height }}px;
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.card_content_alignment }};
    margin-bottom: {{ block.settings.logo_spacing }}px;
  }

  .ai-press-mention-card__logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_max_width }}px;
    max-height: {{ block.settings.logo_height }}px;
    width: auto;
    height: auto;
    object-fit: contain;
    {% if block.settings.enable_logo_grayscale %}
      filter: grayscale({{ block.settings.logo_grayscale_amount }}%);
      transition: filter {{ block.settings.hover_transition_speed }}s ease;
    {% endif %}
  }

  {% if block.settings.enable_logo_grayscale and block.settings.enable_logo_hover_color %}
    .ai-press-mention-card-{{ ai_gen_id }}:hover .ai-press-mention-card__logo-{{ ai_gen_id }} {
      filter: grayscale(0%);
    }
  {% endif %}

  .ai-press-mention-card__logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_background }};
    border-radius: {{ block.settings.placeholder_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-press-mention-card__logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-press-mention-card__content-{{ ai_gen_id }} {
    flex-grow: 1;
    width: 100%;
  }

  .ai-press-mention-card__title-{{ ai_gen_id }} {
    color: {{ block.settings.article_title_color }};
    font-size: {{ block.settings.article_title_size }}px;
    font-weight: {{ block.settings.article_title_weight }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.3;
  }

  .ai-press-mention-card__excerpt-{{ ai_gen_id }} {
    color: {{ block.settings.excerpt_color }};
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.5;
    margin: 0 0 {{ block.settings.excerpt_spacing }}px;
  }

  .ai-press-mention-card__date-{{ ai_gen_id }} {
    color: {{ block.settings.date_color }};
    font-size: {{ block.settings.date_size }}px;
    margin: 0 0 {{ block.settings.date_spacing }}px;
    font-style: {{ block.settings.date_style }};
  }

  .ai-press-mention-card__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    transition: all {{ block.settings.hover_transition_speed }}s ease;
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
  }

  .ai-press-mention-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    {% if block.settings.enable_button_hover_transform %}
      transform: translateX({{ block.settings.button_hover_shift }}px);
    {% endif %}
  }

  .ai-press-mention-card__button-icon-{{ ai_gen_id }} {
    width: {{ block.settings.button_icon_size }}px;
    height: {{ block.settings.button_icon_size }}px;
    transition: transform {{ block.settings.hover_transition_speed }}s ease;
  }

  {% if block.settings.enable_button_icon_animation %}
    .ai-press-mention-card__button-{{ ai_gen_id }}:hover .ai-press-mention-card__button-icon-{{ ai_gen_id }} {
      transform: translateX(4px);
    }
  {% endif %}

  .ai-press-mentions__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.subheading_color }};
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-press-mentions__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-press-mentions__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-press-mentions-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-press-mentions__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-press-mentions__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-press-mention-card__logo-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.logo_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<press-mentions-{{ ai_gen_id }} class="ai-press-mentions-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-press-mentions__container-{{ ai_gen_id }}">
    {% if block.settings.show_heading %}
      <div class="ai-press-mentions__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-press-mentions__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-press-mentions__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% assign has_content = false %}
    {% for i in (1..12) %}
      {% assign logo_key = 'press_' | append: i | append: '_logo' %}
      {% assign url_key = 'press_' | append: i | append: '_url' %}
      {% if block.settings[logo_key] != blank or block.settings[url_key] != blank %}
        {% assign has_content = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_content %}
      <div class="ai-press-mentions__grid-{{ ai_gen_id }}">
        {% for i in (1..12) %}
          {% liquid
            assign logo_key = 'press_' | append: i | append: '_logo'
            assign title_key = 'press_' | append: i | append: '_title'
            assign excerpt_key = 'press_' | append: i | append: '_excerpt'
            assign date_key = 'press_' | append: i | append: '_date'
            assign url_key = 'press_' | append: i | append: '_url'
            assign button_text_key = 'press_' | append: i | append: '_button_text'

            assign logo = block.settings[logo_key]
            assign title = block.settings[title_key]
            assign excerpt = block.settings[excerpt_key]
            assign date = block.settings[date_key]
            assign url = block.settings[url_key]
            assign button_text = block.settings[button_text_key]
          %}

          {% if logo != blank or url != blank %}
            <div class="ai-press-mention-card-{{ ai_gen_id }}">
              <div class="ai-press-mention-card__logo-wrapper-{{ ai_gen_id }}">
                {% if logo != blank %}
                  <img
                    src="{{ logo | image_url: width: 600 }}"
                    alt="{{ title | default: 'Press logo' | escape }}"
                    class="ai-press-mention-card__logo-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ logo.width }}"
                    height="{{ logo.height }}"
                  >
                {% else %}
                  <div class="ai-press-mention-card__logo-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-press-mention-card__content-{{ ai_gen_id }}">
                {% if block.settings.show_date and date != blank %}
                  <div class="ai-press-mention-card__date-{{ ai_gen_id }}">{{ date }}</div>
                {% endif %}

                {% if block.settings.show_title and title != blank %}
                  <h3 class="ai-press-mention-card__title-{{ ai_gen_id }}">{{ title }}</h3>
                {% endif %}

                {% if block.settings.show_excerpt and excerpt != blank %}
                  <div class="ai-press-mention-card__excerpt-{{ ai_gen_id }}">{{ excerpt }}</div>
                {% endif %}

                {% if block.settings.show_button and url != blank %}
                  <a
                    href="{{ url }}"
                    class="ai-press-mention-card__button-{{ ai_gen_id }}"
                    {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                  >
                    {{ button_text | default: block.settings.default_button_text }}
                    {% if block.settings.show_button_icon %}
                      <svg class="ai-press-mention-card__button-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    {% endif %}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-press-mentions__empty-state-{{ ai_gen_id }}">
        Add your press mentions to showcase your media coverage
      </div>
    {% endif %}
  </div>
</press-mentions-{{ ai_gen_id }}>

<script>
  (function() {
    class PressMentions{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeCards();
      }

      initializeCards() {
        const cards = this.querySelectorAll('.ai-press-mention-card-{{ ai_gen_id }}');
        cards.forEach((card, index) => {
          card.style.animationDelay = `${index * 0.1}s`;
        });
      }
    }

    customElements.define('press-mentions-{{ ai_gen_id }}', PressMentions{{ ai_gen_id }});
  })();
</script>

