{% doc %}
  @prompt
    i need a section with as many buttons as i want that I can fully customize and put links to
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-button-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-button-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.button_spacing }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-button-grid__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    transition: all 0.3s ease;
    cursor: pointer;
    text-align: center;
    width: 100%;
  }

  .ai-button-grid__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-button-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      width: 100%;
    }
  }
{% endstyle %}

<custom-button-grid-{{ ai_gen_id }} class="ai-button-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-button-grid__container-{{ ai_gen_id }}">
    {% for i in (1..12) %}
      {% liquid
        assign button_text_key = 'button_' | append: i | append: '_text'
        assign button_url_key = 'button_' | append: i | append: '_url'
        assign button_enabled_key = 'button_' | append: i | append: '_enabled'
        
        assign button_text = block.settings[button_text_key]
        assign button_url = block.settings[button_url_key]
        assign button_enabled = block.settings[button_enabled_key]
      %}
      
      {% if button_enabled and button_text != blank %}
        <a 
          href="{{ button_url }}" 
          class="ai-button-grid__button-{{ ai_gen_id }}"
        >
          {{ button_text }}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</custom-button-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomButtonGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('custom-button-grid-{{ ai_gen_id }}', CustomButtonGrid{{ ai_gen_id }});
  })();
</script>

