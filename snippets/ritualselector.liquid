{%- comment -%}
  WELLER CO. — Ritual Selector (unified block)
  Flavor picker + Subscribe/One-time plans + Gifts + Add to cart — all in one block.
  Flavors always rendered. Theme (light/dark) controlled by block.settings.theme.
{%- endcomment -%}

{%- assign p = product -%}
{%- assign cv = p.selected_or_first_available_variant | default: p.variants.first -%}
{%- assign sym = block.settings.currency_symbol | default: '$' -%}
{%- assign has_plans = false -%}
{%- if p.selling_plan_groups.size > 0 -%}{%- assign has_plans = true -%}{%- endif -%}

{%- assign gift_total = 0 -%}
{%- for i in (1..4) -%}
  {%- assign gnk = 'gift_' | append: i | append: '_name' -%}
  {%- assign gvk = 'gift_' | append: i | append: '_value' -%}
  {%- if block.settings[gnk] != blank -%}
    {%- assign gift_total = gift_total | plus: block.settings[gvk] -%}
  {%- endif -%}
{%- endfor -%}

{%- assign flavor_count = 0 -%}
{%- for i in (1..4) -%}
  {%- assign fnk = 'flavor_' | append: i | append: '_name' -%}
  {%- if block.settings[fnk] != blank -%}{%- assign flavor_count = flavor_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}

{%- assign rc_theme = block.settings.theme | default: 'dark' -%}

{%- capture rc_ico_scoop -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13.5a5.5 5.5 0 0 1 5.5-5.5H12v11H9.5A5.5 5.5 0 0 1 4 13.5Z"/><path d="M12 8l3.8-3.8a2.6 2.6 0 1 1 3.7 3.7L16 11.4"/></svg>{%- endcapture -%}
{%- capture rc_ico_pouch -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 8h11l-.7 11.2a1.8 1.8 0 0 1-1.8 1.8H9a1.8 1.8 0 0 1-1.8-1.8L6.5 8Z"/><path d="M6.5 8 8.2 4.8a1.5 1.5 0 0 1 1.3-.8h5a1.5 1.5 0 0 1 1.3.8L17.5 8"/><path d="M9.5 12.5h5"/></svg>{%- endcapture -%}
{%- capture rc_ico_guide -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h10a1.5 1.5 0 0 1 1.5 1.5V20H7.5A1.5 1.5 0 0 1 6 18.5V4Z"/><path d="M6 4a1.5 1.5 0 0 0-1.5 1.5v13A1.5 1.5 0 0 1 6 17"/><path d="M9.5 8.5h4.5M9.5 12h3"/></svg>{%- endcapture -%}
{%- capture rc_ico_gift -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M4 13h16M12 9v11"/><path d="M12 9S10.5 4.5 8 5.2C6 5.8 7 9 12 9ZM12 9s1.5-4.5 4-3.8C18 5.8 17 9 12 9Z"/></svg>{%- endcapture -%}

<div
  id="rc-{{ block.id }}"
  class="rc rc--{{ rc_theme }}"
  data-symbol="{{ sym }}"
  data-has-plans="{{ has_plans }}"
  data-gift-total="{{ gift_total }}"
  data-flavor-count="{{ flavor_count }}"
  data-one-cents="{{ cv.price }}"
  data-manual-discount="{{ block.settings.manual_discount }}"
  {{ block.shopify_attributes }}>

  {%- assign rc_form_id = 'rc-form-' | append: block.id -%}
  {%- form 'product', p, id: rc_form_id, class: 'rc-card' -%}
    <input type="hidden" name="id" value="{{ cv.id }}" data-variant-id>
    <input type="hidden" name="selling_plan" value="" data-selling-plan>
    <input type="hidden" name="quantity" value="1" data-qty>

    <span class="rc-blob rc-blob1"></span>
    <span class="rc-blob rc-blob2"></span>

    <div class="rc-sel">

      <!-- FLAVOR PICKER — always rendered -->
      <div class="rc-q">{{ block.settings.flavor_heading | default: 'Click To Select Flavor & Quantity' }}</div>
      <div class="rc-fa-row">
        {%- for i in (1..4) -%}
          {%- assign fnk = 'flavor_' | append: i | append: '_name' -%}
          {%- assign fn = block.settings[fnk] -%}
          {%- if fn != blank -%}
            {%- assign fck = 'flavor_' | append: i | append: '_color' -%}
            {%- assign fvk = 'flavor_' | append: i | append: '_variant_id' -%}
            {%- assign fik = 'flavor_' | append: i | append: '_image' -%}
            {%- assign fsk = 'flavor_' | append: i | append: '_size' -%}
            {%- assign fxk = 'flavor_' | append: i | append: '_offset_x' -%}
            {%- assign fyk = 'flavor_' | append: i | append: '_offset_y' -%}
            {%- assign fsz = block.settings[fsk] | default: 75 -%}
            {%- assign fox = block.settings[fxk] | default: 0 -%}
            {%- assign foy = block.settings[fyk] | default: 0 -%}
            <div class="rc-fa-pick">
              <button class="rc-circle" type="button"
                style="--rc-fc:{{ block.settings[fck] | default: '#D64C6F' }}"
                data-flavor="{{ i }}"
                data-variant="{{ block.settings[fvk] }}"
                data-name="{{ fn | escape }}"
                aria-label="Add {{ fn | escape }}">
                {%- if block.settings[fik] != blank -%}<img src="{{ block.settings[fik] | image_url: width: 220 }}" alt="{{ fn | escape }}" width="220" height="220" loading="lazy" style="width:{{ fsz }}%;height:{{ fsz }}%;transform:translate({{ fox }}%,{{ foy }}%)">{%- endif -%}
                <span class="rc-fc-badge">0</span>
              </button>
              <span class="rc-fa-name">{{ fn }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if flavor_count == 0 -%}
          <p class="rc-fa-empty rc-fa-setup-hint">Add flavor names in block settings to activate the flavor picker.</p>
        {%- endif -%}
      </div>
      <div class="rc-fa-mix">
        <div class="rc-fa-mix-head">{{ block.settings.order_label | default: 'Your order' }} · <b><span data-count>0</span> {{ block.settings.unit_label | default: 'tubs' }}</b></div>
        <div class="rc-fa-chips" data-chips></div>
      </div>
      <div class="rc-divider"></div>

      <div class="rc-q rc-q-plan">{{ block.settings.heading | default: 'Choose your ritual' }}</div>

      <!-- ONE-TIME -->
      <div class="rc-plan" data-plan="one" role="button" tabindex="0">
        <div class="rc-plan-top">
          <span class="rc-radio"></span>
          <span>
            <span class="rc-plan-name">{{ block.settings.onetime_name | default: 'One-time purchase' }}</span>
            <span class="rc-plan-sub">{{ block.settings.onetime_sub | default: 'Ships once · no commitment' }}</span>
          </span>
          <span class="rc-plan-price"><span class="rc-now">{{ cv.price | money }}</span></span>
        </div>
        <div class="rc-reveal">
          <div class="rc-reveal-inner">
            <div class="rc-loss-h">{{ block.settings.skip_heading | default: "You'd be skipping" }}</div>
            <div class="rc-gifts" data-gifts-lost>
              {%- for i in (1..4) -%}
                {%- assign gnk = 'gift_' | append: i | append: '_name' -%}
                {%- assign gn = block.settings[gnk] -%}
                {%- if gn != blank -%}
                  {%- assign gtk = 'gift_' | append: i | append: '_tag' -%}
                  {%- assign gvk = 'gift_' | append: i | append: '_value' -%}
                  {%- assign gik = 'gift_' | append: i | append: '_icon' -%}
                  {%- assign gimk = 'gift_' | append: i | append: '_image' -%}
                  <div class="rc-gift rc-gift-enter rc-gift-lost">
                    <span class="rc-g-ico">{%- if block.settings[gimk] != blank -%}<img src="{{ block.settings[gimk] | image_url: width: 80 }}" alt="{{ gn | escape }}" width="80" height="80" loading="lazy">{%- else -%}{%- case block.settings[gik] -%}{%- when 'pouch' -%}{{ rc_ico_pouch }}{%- when 'guide' -%}{{ rc_ico_guide }}{%- when 'gift' -%}{{ rc_ico_gift }}{%- else -%}{{ rc_ico_scoop }}{%- endcase -%}{%- endif -%}</span>
                    <span><span class="rc-g-name">{{ gn }}</span><span class="rc-g-tag">{{ block.settings[gtk] }}</span></span>
                    <span class="rc-g-val"><span class="rc-strike">{{ sym }}{{ block.settings[gvk] }} value</span><span class="rc-free">Gone</span></span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="rc-loss-note">{{ block.settings.skip_note }}</div>
          </div>
        </div>
      </div>

      <!-- SUBSCRIBE & SAVE -->
      <div class="rc-plan rc-on" data-plan="sub" role="button" tabindex="0">
        {%- if block.settings.badge_text != blank -%}<span class="rc-badge">{{ block.settings.badge_text }}</span>{%- endif -%}
        <div class="rc-plan-top">
          <span class="rc-radio"></span>
          <span class="rc-sub-text">
            <span class="rc-plan-name">{{ block.settings.sub_name | default: 'Subscribe' }} <span class="rc-save">&amp; save</span></span>
            <span data-cadence style="display:none"></span>
            <span class="rc-sub-perks">
              <span class="rc-perk--disc">{{ block.settings.sub_perk_discount | default: '10% off' }}</span>
              <span class="rc-perk-sep">·</span>
              <span class="rc-perk--ship">{{ block.settings.sub_perk_shipping | default: 'Free shipping always' }}</span>
            </span>
          </span>
          <span class="rc-plan-price">
            <span class="rc-now" data-sub-price>{{ cv.price | money }}</span>
            <span class="rc-was" data-sub-was>{{ cv.price | money }}</span>
          </span>
        </div>
        <div class="rc-reveal">
          <div class="rc-reveal-inner">

            <div class="rc-freq-row">
              <span class="rc-freq-label">{{ block.settings.deliver_label_1 | default: 'Delivery' }}<br>{{ block.settings.deliver_label_2 | default: 'Frequency' }}</span>
              <div class="rc-freq" data-freq>
                {%- if has_plans -%}
                  {%- assign fi = 0 -%}
                  {%- for group in p.selling_plan_groups -%}
                    {%- for plan in group.selling_plans -%}
                      {%- assign alloc = nil -%}
                      {%- for a in cv.selling_plan_allocations -%}
                        {%- if a.selling_plan.id == plan.id -%}{%- assign alloc = a -%}{%- break -%}{%- endif -%}
                      {%- endfor -%}
                      {%- assign plan_parts = plan.name | split: ' | ' -%}
                      {%- assign plan_label = plan_parts[0] | strip -%}
                      {%- assign plan_detail = plan_parts[1] | strip -%}
                      <button type="button"
                        class="{% if fi == 0 %}rc-on{% endif %}"
                        data-plan-id="{{ plan.id }}"
                        data-price="{% if alloc %}{{ alloc.per_delivery_price }}{% else %}{{ cv.price }}{% endif %}"
                        data-compare="{% if alloc and alloc.compare_at_price %}{{ alloc.compare_at_price }}{% else %}{{ cv.price }}{% endif %}"
                        data-cadence="{{ plan_label }}">
                        {{ plan_label }}<span>{{ plan_detail }}</span>
                      </button>
                      {%- assign fi = fi | plus: 1 -%}
                    {%- endfor -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- assign labels = block.settings.manual_cadences | default: 'Monthly:30 days,Bi-monthly:60 days' | split: ',' -%}
                  {%- assign disc = block.settings.manual_discount | default: 10 -%}
                  {%- assign disc_amount = cv.price | times: disc | divided_by: 100 -%}
                  {%- assign sub_cents = cv.price | minus: disc_amount -%}
                  {%- for lab in labels -%}
                    {%- assign parts = lab | split: ':' -%}
                    <button type="button"
                      class="{% if forloop.first %}rc-on{% endif %}"
                      data-plan-id=""
                      data-price="{{ sub_cents }}"
                      data-compare="{{ cv.price }}"
                      data-cadence="{{ parts[0] | strip }}">
                      {{ parts[0] | strip }}<span>{{ parts[1] | strip }}</span>
                    </button>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>

            <div class="rc-reveal-h">{{ block.settings.gifts_heading | default: 'Free welcome gifts · first box' }}</div>
            <div class="rc-gifts" data-gifts>
              {%- for i in (1..4) -%}
                {%- assign gnk = 'gift_' | append: i | append: '_name' -%}
                {%- assign gn = block.settings[gnk] -%}
                {%- if gn != blank -%}
                  {%- assign gtk = 'gift_' | append: i | append: '_tag' -%}
                  {%- assign gvk = 'gift_' | append: i | append: '_value' -%}
                  {%- assign gik = 'gift_' | append: i | append: '_icon' -%}
                  {%- assign gimk = 'gift_' | append: i | append: '_image' -%}
                  <div class="rc-gift rc-gift-enter">
                    <span class="rc-g-ico">{%- if block.settings[gimk] != blank -%}<img src="{{ block.settings[gimk] | image_url: width: 80 }}" alt="{{ gn | escape }}" width="80" height="80" loading="lazy">{%- else -%}{%- case block.settings[gik] -%}{%- when 'pouch' -%}{{ rc_ico_pouch }}{%- when 'guide' -%}{{ rc_ico_guide }}{%- when 'gift' -%}{{ rc_ico_gift }}{%- else -%}{{ rc_ico_scoop }}{%- endcase -%}{%- endif -%}</span>
                    <span><span class="rc-g-name">{{ gn }}</span><span class="rc-g-tag">{{ block.settings[gtk] }}</span></span>
                    <span class="rc-g-val"><span class="rc-strike">{{ sym }}{{ block.settings[gvk] }} value</span><span class="rc-free">Free</span></span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="rc-tally">
              <span class="rc-big" data-tally>{{ sym }}{{ gift_total }}</span>
              <div class="rc-lbl">{{ block.settings.tally_text }}</div>
            </div>
          </div>
        </div>
      </div>

      <button type="submit" name="add" class="rc-cta" data-add-btn>
        <span class="rc-cta-label">{{ block.settings.cta_label | default: 'Add to cart' }}</span>
        <span data-total></span>
        <span class="rc-cta-spinner" aria-hidden="true"></span>
      </button>
      <div class="rc-fine">{{ block.settings.fine_print | default: 'Free shipping always on subscriptions ♡' }}</div>
    </div>
  {%- endform -%}
</div>

<style>
  /* suppress subscription app injection */
  #rc-{{ block.id }} .rc-card > *:not(input):not(.rc-blob1):not(.rc-blob2):not(.rc-sel){ display:none !important; }

  #rc-{{ block.id }}{
    --rc-blush:#F2C4CE; --rc-peach:#E8A87C; --rc-sky:#4A90B8;
    --rc-navy:#1B3A5C; --rc-rose:#E8607A; --rc-cream:#FAF5F0;
    --rc-lime:#7DB642; --rc-fog:#F5EEE8; --rc-mist:#E8DDD5; --rc-stone:#8A7E76;
    --rc-serif:'Playfair Display','Georgia',serif;
    --rc-script:'Dancing Script',cursive;
    --rc-sans:'DM Sans','Helvetica Neue',sans-serif;
    --rc-spring:cubic-bezier(.34,1.4,.5,1);
    /* font sizes */
    --rc-fs-q:{{ block.settings.fs_flavor_heading | default: 11 }}px;
    --rc-fs-plan-q:{{ block.settings.fs_plan_heading | default: 11 }}px;
    --rc-fs-flavor-name:{{ block.settings.fs_flavor_name | default: 12 }}px;
    --rc-fs-mix-head:{{ block.settings.fs_mix_head | default: 11 }}px;
    --rc-fs-plan-name:{{ block.settings.fs_plan_name | default: 16 }}px;
    --rc-fs-plan-sub:{{ block.settings.fs_plan_sub | default: 12 }}px;
    --rc-fs-price:{{ block.settings.fs_price | default: 24 }}px;
    --rc-fs-freq:{{ block.settings.fs_freq | default: 12 }}px;
    --rc-fs-gift-name:{{ block.settings.fs_gift_name | default: 13 }}px;
    --rc-fs-gift-tag:{{ block.settings.fs_gift_tag | default: 11 }}px;
    --rc-fs-tally-num:{{ block.settings.fs_tally_num | default: 26 }}px;
    --rc-fs-tally-lbl:{{ block.settings.fs_tally_lbl | default: 12 }}px;
    --rc-fs-loss:{{ block.settings.fs_loss_note | default: 12 }}px;
    --rc-fs-cta:{{ block.settings.fs_cta | default: 13 }}px;
    --rc-fs-fine:{{ block.settings.fs_fine | default: 11 }}px;
    /* spacing */
    --rc-card-pad:{{ block.settings.sp_card_pad | default: 30 }}px;
    --rc-circle-sz:{{ block.settings.sp_circle | default: 90 }}px;
    --rc-flavor-gap:{{ block.settings.sp_flavor_gap | default: 12 }}px;
    --rc-mix-top:{{ block.settings.sp_mix_top | default: 20 }}px;
    --rc-divider-mg:{{ block.settings.sp_divider | default: 22 }}px;
    --rc-plan-gap:{{ block.settings.sp_plan_gap | default: 12 }}px;
    --rc-gift-gap:{{ block.settings.sp_gift_gap | default: 8 }}px;
    --rc-cta-top:{{ block.settings.sp_cta_top | default: 20 }}px;
    display:block; font-family:var(--rc-sans); color:var(--rc-text);
    max-width:520px; margin:0 auto; padding:8px;
  }

  /* LIGHT theme */
  #rc-{{ block.id }}.rc--light{
    --rc-card-bg:#fff; --rc-surface:#fff; --rc-border:var(--rc-mist);
    --rc-text:var(--rc-navy); --rc-text-muted:var(--rc-stone); --rc-radio:var(--rc-mist);
    --rc-gift-bg:var(--rc-fog); --rc-gift-ico-bg:rgba(232,96,122,.12);
    --rc-freq-bg:var(--rc-fog); --rc-freq-on-bg:#fff; --rc-freq-on-text:var(--rc-navy);
    --rc-tally-bg:var(--rc-navy); --rc-tally-border:transparent;
    --rc-tally-num:#fff; --rc-tally-lbl:rgba(250,245,240,.82);
    --rc-card-shadow:0 8px 40px rgba(27,58,92,.12); --rc-on-bg:rgba(232,96,122,.06);
    --rc-circle-base:#fff; --rc-chip-bg:#fff;
    --rc-blob1:var(--rc-blush); --rc-blob1-op:.35;
    --rc-blob2:var(--rc-peach); --rc-blob2-op:.25;
  }

  /* DARK theme */
  #rc-{{ block.id }}.rc--dark{
    --rc-card-bg:var(--rc-navy); --rc-surface:rgba(255,255,255,.04);
    --rc-border:rgba(255,255,255,.13); --rc-text:#fff;
    --rc-text-muted:rgba(250,245,240,.6); --rc-radio:rgba(255,255,255,.32);
    --rc-gift-bg:rgba(255,255,255,.06); --rc-gift-ico-bg:rgba(232,96,122,.2);
    --rc-freq-bg:rgba(255,255,255,.07); --rc-freq-on-bg:var(--rc-cream); --rc-freq-on-text:var(--rc-navy);
    --rc-tally-bg:rgba(232,96,122,.16); --rc-tally-border:rgba(232,96,122,.32);
    --rc-tally-num:#fff; --rc-tally-lbl:rgba(250,245,240,.85);
    --rc-card-shadow:0 18px 60px rgba(10,22,38,.45); --rc-on-bg:rgba(232,96,122,.13);
    --rc-circle-base:#16293d; --rc-chip-bg:rgba(255,255,255,.06);
    --rc-blob1:var(--rc-rose); --rc-blob1-op:.16;
    --rc-blob2:var(--rc-sky); --rc-blob2-op:.18;
  }

  #rc-{{ block.id }} *{ box-sizing:border-box; }
  #rc-{{ block.id }} .rc-card{ background:var(--rc-card-bg); border-radius:28px; padding:var(--rc-card-pad); box-shadow:var(--rc-card-shadow); position:relative; overflow:hidden; margin:0; }
  #rc-{{ block.id }} .rc-blob{ position:absolute; border-radius:50%; pointer-events:none; z-index:0; }
  #rc-{{ block.id }} .rc-blob1{ width:200px; height:200px; background:var(--rc-blob1); opacity:var(--rc-blob1-op); top:-70px; right:-60px; }
  #rc-{{ block.id }} .rc-blob2{ width:130px; height:130px; background:var(--rc-blob2); opacity:var(--rc-blob2-op); bottom:-50px; left:-40px; }
  #rc-{{ block.id }} .rc-sel{ position:relative; z-index:1; }
  #rc-{{ block.id }} .rc-q{ font-size:{{ block.settings.fs_flavor_heading | default: 11 }}px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:{{ block.settings.color_flavor_heading | default: 'var(--rc-text-muted)' }}; margin-bottom:12px; }
  #rc-{{ block.id }} .rc-q.rc-q-plan{ font-size:{{ block.settings.fs_plan_heading | default: 11 }}px; color:{{ block.settings.color_plan_heading | default: 'var(--rc-text-muted)' }}; margin-top:{{ block.settings.sp_ritual_gap | default: 0 }}px; }

  #rc-{{ block.id }} .rc-plan{ position:relative; display:block; width:100%; text-align:left; background:var(--rc-surface); border:1.5px solid var(--rc-border); border-radius:20px; padding:18px 20px; margin-bottom:var(--rc-plan-gap); cursor:pointer; transition:border-color .18s,background .18s,box-shadow .18s,opacity .3s; }
  #rc-{{ block.id }} .rc-plan:hover{ border-color:rgba(232,96,122,.45); }
  #rc-{{ block.id }} .rc-plan.rc-on{ border-color:var(--rc-rose); background:var(--rc-on-bg); box-shadow:0 6px 24px rgba(232,96,122,.2); }
  #rc-{{ block.id }} .rc-plan-top{ display:flex; align-items:center; gap:14px; }
  #rc-{{ block.id }} .rc-radio{ width:22px; height:22px; border-radius:50%; border:2px solid var(--rc-radio); flex-shrink:0; position:relative; transition:border-color .18s; }
  #rc-{{ block.id }} .rc-plan.rc-on .rc-radio{ border-color:var(--rc-rose); }
  #rc-{{ block.id }} .rc-plan.rc-on .rc-radio::after{ content:''; position:absolute; inset:3px; border-radius:50%; background:var(--rc-rose); }
  #rc-{{ block.id }} .rc-plan-name{ font-family:var(--rc-sans); font-weight:700; font-size:var(--rc-fs-plan-name); color:var(--rc-text); }
  #rc-{{ block.id }} .rc-plan[data-plan="sub"] .rc-plan-name{ font-size:{{ block.settings.fs_sub_name | default: 16 }}px; }
  #rc-{{ block.id }} .rc-save{ font-family:var(--rc-script); font-weight:700; font-size:22px; color:var(--rc-rose); margin-left:2px; }
  #rc-{{ block.id }} .rc-plan-sub{ display:block; font-size:var(--rc-fs-plan-sub); color:var(--rc-text-muted); margin-top:2px; }
  #rc-{{ block.id }} .rc-sub-text{ flex:1; text-align:center; }
  #rc-{{ block.id }} .rc-sub-perks{ display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:6px; margin-top:4px; }

  /* Both plan cards: column layout so text is truly centered */
  #rc-{{ block.id }} .rc-plan[data-plan="sub"] .rc-plan-top,
  #rc-{{ block.id }} .rc-plan[data-plan="one"] .rc-plan-top{ flex-direction:column; align-items:center; gap:6px; }
  #rc-{{ block.id }} .rc-plan[data-plan="sub"] .rc-plan-price,
