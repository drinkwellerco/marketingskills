  #rc-{{ block.id }}.rc--dark .rc-gift-lost{ filter:grayscale(.85) brightness(.9); opacity:.5; }
  #rc-{{ block.id }}.rc--dark .rc-gift-lost .rc-g-ico{ background:rgba(250,245,240,.1); color:rgba(250,245,240,.5); }

  #rc-{{ block.id }} .rc-gift-lost .rc-g-name{ text-decoration:line-through; text-decoration-color:rgba(232,96,122,.5); }
  #rc-{{ block.id }} .rc-gift-lost .rc-free{ color:var(--rc-stone); }
  #rc-{{ block.id }} .rc-gift-enter{ opacity:1; transform:none; }
  #rc-{{ block.id }} .rc-gift-enter.rc-enter-hidden{ opacity:0; transform:translateY(12px) scale(.94); }

  #rc-{{ block.id }} .rc-cta{ width:100%; display:flex; align-items:center; justify-content:center; gap:8px; margin-top:var(--rc-cta-top); padding:16px; border:none; border-radius:999px; background:var(--rc-rose); color:#fff; font-family:var(--rc-sans); font-weight:600; font-size:var(--rc-fs-cta); letter-spacing:.06em; text-transform:uppercase; cursor:pointer; box-shadow:0 6px 24px rgba(232,96,122,.28); transition:transform .2s,box-shadow .2s,background .3s; }
  #rc-{{ block.id }} .rc-cta:hover:not([disabled]){ transform:translateY(-2px); box-shadow:0 10px 32px rgba(232,96,122,.35); }
  #rc-{{ block.id }} .rc-cta[disabled]{ opacity:.55; cursor:not-allowed; box-shadow:none; transform:none; }
  @keyframes rcspin{{ block.id | replace: '-', '' }}{ to{ transform:rotate(360deg); } }
  #rc-{{ block.id }} .rc-cta-spinner{ display:none; width:15px; height:15px; border:2px solid rgba(255,255,255,.35); border-top-color:#fff; border-radius:50%; flex-shrink:0; }
  #rc-{{ block.id }} .rc-cta--loading .rc-cta-spinner{ display:block; animation:rcspin{{ block.id | replace: '-', '' }} .7s linear infinite; }
  #rc-{{ block.id }} .rc-cta--loading .rc-cta-label,
  #rc-{{ block.id }} .rc-cta--loading [data-total]{ opacity:.7; }
  #rc-{{ block.id }} .rc-cta--success{ background:#2d9e5f !important; box-shadow:0 6px 24px rgba(45,158,95,.32) !important; }
  #rc-{{ block.id }} .rc-cta--error{ background:#b83232 !important; box-shadow:0 6px 24px rgba(184,50,50,.32) !important; }
  #rc-{{ block.id }} .rc-fine{ text-align:center; font-size:var(--rc-fs-fine); color:var(--rc-text-muted); margin-top:12px; }

  /* FLAVOR SELECTOR */
  #rc-{{ block.id }} .rc-fa-row{ display:flex; gap:var(--rc-flavor-gap); justify-content:space-between; flex-wrap:wrap; }
  #rc-{{ block.id }} .rc-fa-pick{ flex:1; min-width:72px; display:flex; flex-direction:column; align-items:center; gap:10px; }
  #rc-{{ block.id }} .rc-fa-name{ font-family:var(--rc-sans); font-weight:600; font-size:var(--rc-fs-flavor-name); line-height:1.25; text-align:center; color:var(--rc-text); }
  #rc-{{ block.id }} .rc-circle{ width:var(--rc-circle-sz); height:var(--rc-circle-sz); border-radius:50%; padding:0; background:var(--rc-circle-base); border:2px solid var(--rc-border); display:flex; align-items:center; justify-content:center; cursor:pointer; position:relative; transition:transform .18s var(--rc-spring),border-color .18s,box-shadow .18s,background .18s; }
  #rc-{{ block.id }} .rc-circle img{ width:74%; height:74%; object-fit:contain; pointer-events:none; border-radius:50%; }
  #rc-{{ block.id }} .rc-circle:hover{ transform:translateY(-3px); border-color:var(--rc-fc); }
  #rc-{{ block.id }} .rc-circle.rc-active{ border-color:var(--rc-fc); background:var(--rc-circle-base); box-shadow:0 8px 22px rgba(0,0,0,.18); }
  #rc-{{ block.id }} .rc-circle.rc-bump{ animation:rcbump{{ block.id | replace: '-', '' }} .42s var(--rc-spring); }
  @keyframes rcbump{{ block.id | replace: '-', '' }}{ 0%{transform:scale(1)} 40%{transform:scale(1.13)} 100%{transform:scale(1)} }
  #rc-{{ block.id }} .rc-fc-badge{ position:absolute; top:-7px; right:-7px; min-width:26px; height:26px; padding:0 6px; border-radius:999px; background:var(--rc-fc); color:#fff; font-family:var(--rc-sans); font-weight:700; font-size:{{ block.settings.fs_count_badge | default: 13 }}px; display:flex; align-items:center; justify-content:center; box-shadow:0 3px 8px rgba(27,58,92,.22); border:2px solid var(--rc-circle-base); transform:scale(0); transition:transform .3s var(--rc-spring); }
  #rc-{{ block.id }} .rc-fc-badge.rc-show{ transform:scale(1); }
  #rc-{{ block.id }} .rc-fc-clear{ position:absolute; top:-7px; left:-7px; width:24px; height:24px; border-radius:999px; background:var(--rc-circle-base); color:var(--rc-text-muted); border:1.5px solid var(--rc-border); display:flex; align-items:center; justify-content:center; font-size:11px; line-height:1; cursor:pointer; transform:scale(0); transition:transform .25s var(--rc-spring),background .15s,color .15s; }
  #rc-{{ block.id }} .rc-fc-clear.rc-show{ transform:scale(1); }
  #rc-{{ block.id }} .rc-fc-clear:hover{ background:rgba(232,96,122,.14); color:var(--rc-rose); border-color:rgba(232,96,122,.45); }
  #rc-{{ block.id }} .rc-fa-mix{ margin-top:var(--rc-mix-top); background:var(--rc-gift-bg); border-radius:18px; padding:16px; min-height:80px; }
  #rc-{{ block.id }} .rc-fa-mix-head{ font-size:var(--rc-fs-mix-head); font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--rc-text-muted); margin-bottom:10px; }
  #rc-{{ block.id }} .rc-fa-mix-head b{ color:var(--rc-rose); }
  #rc-{{ block.id }} .rc-fa-chips{ display:flex; flex-direction:column; gap:8px; }
  #rc-{{ block.id }} .rc-fa-empty{ font-family:var(--rc-sans); font-size:13px; color:var(--rc-text-muted); font-style:italic; }
  #rc-{{ block.id }} .rc-fa-setup-hint{ font-size:12px; color:var(--rc-text-muted); font-style:italic; text-align:center; padding:12px 0; }
  #rc-{{ block.id }} .rc-chip{ display:flex; align-items:center; gap:10px; background:var(--rc-chip-bg); border:1.5px solid var(--rc-border); border-radius:12px; padding:9px 9px 9px 13px; animation:rcchip{{ block.id | replace: '-', '' }} .35s var(--rc-spring); }
  @keyframes rcchip{{ block.id | replace: '-', '' }}{ from{opacity:0; transform:translateY(6px) scale(.96)} to{opacity:1; transform:none} }
  #rc-{{ block.id }} .rc-chip-dot{ width:12px; height:12px; border-radius:50%; background:var(--rc-fc); flex-shrink:0; }
  #rc-{{ block.id }} .rc-chip-name{ font-family:var(--rc-sans); font-weight:600; font-size:{{ block.settings.fs_chip | default: 13 }}px; color:var(--rc-text); }
  #rc-{{ block.id }} .rc-chip-qty{ font-family:var(--rc-sans); font-weight:700; font-size:{{ block.settings.fs_chip | default: 13 }}px; color:var(--rc-fc); }
  #rc-{{ block.id }} .rc-chip-x{ margin-left:auto; width:26px; height:26px; border-radius:50%; border:none; background:var(--rc-gift-bg); color:var(--rc-text-muted); cursor:pointer; font-size:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:background .15s,color .15s; }
  #rc-{{ block.id }} .rc-chip-x:hover{ background:rgba(232,96,122,.14); color:var(--rc-rose); }
  #rc-{{ block.id }} .rc-divider{ height:1px; background:var(--rc-border); margin-top:{{ block.settings.sp_divider | default: 22 }}px; margin-bottom:{{ block.settings.sp_divider | default: 22 }}px; }
  #rc-{{ block.id }} .rc-flavors-empty .rc-plan{ opacity:.42; pointer-events:none; }
  #rc-{{ block.id }} .rc-flavors-empty .rc-plan.rc-on{ box-shadow:none; }
  @media (max-width:520px){
    #rc-{{ block.id }} .rc-card{ padding:max(18px, calc(var(--rc-card-pad) - 8px)); }
  }
</style>

<script>
(function(){
  var root = document.getElementById('rc-{{ block.id }}');
  if(!root) return;
  var sym = root.dataset.symbol || '$';
  var GIFT_TOTAL = parseInt(root.dataset.giftTotal, 10) || 0;
  var FLAVOR_COUNT = parseInt(root.dataset.flavorCount, 10) || 0;
  var ONE_CENTS = parseInt(root.dataset.oneCents, 10) || 0;
  var money = function(c){ return sym + (c/100).toFixed(2); };
  var slice = function(c){ return Array.prototype.slice.call(c); };

  var form = root.querySelector('form');
  var subPlan = root.querySelector('.rc-plan[data-plan="sub"]');
  var onePlan = root.querySelector('.rc-plan[data-plan="one"]');
  var oneNow  = onePlan ? onePlan.querySelector('.rc-now') : null;
  var giftsEl = root.querySelector('[data-gifts]');
  var lostEl  = root.querySelector('[data-gifts-lost]');
  var items   = giftsEl ? slice(giftsEl.children) : [];
  var lost    = lostEl  ? slice(lostEl.children)  : [];
  var tally   = root.querySelector('[data-tally]');
  var subPrice= root.querySelector('[data-sub-price]');
  var subWas  = root.querySelector('[data-sub-was]');
  var totalEl = root.querySelector('[data-total]');
  var cadenceEl = root.querySelector('[data-cadence]');
  var spInput = root.querySelector('[data-selling-plan]');
  var qtyInput= root.querySelector('[data-qty]');
  var addBtn  = root.querySelector('[data-add-btn]');
  var chipsEl = root.querySelector('[data-chips]');
  var countEl = root.querySelector('[data-count]');

  var freqBtns = slice(root.querySelectorAll('[data-freq] button'));
  var current  = 'sub';
  var activeFreq = freqBtns[0] || null;

  var counts = {}, flavorInfo = {}, totalQty = 0;

  function staggerIn(list,gap){ gap=gap||95; list.forEach(function(el){ el.classList.add('rc-enter-hidden'); }); if(list[0]) void list[0].offsetWidth; list.forEach(function(el,i){ setTimeout(function(){ el.classList.remove('rc-enter-hidden'); },40+i*gap); }); }
  function animateNum(el,from,to,dur){ if(!el) return; dur=dur||600; var s=performance.now(); (function step(t){ var pr=Math.min(1,(t-s)/dur),e=1-Math.pow(1-pr,3); el.textContent=sym+Math.round(from+(to-from)*e); if(pr<1) requestAnimationFrame(step); else el.textContent=sym+to; })(performance.now()); }
  function subUnit(){ return activeFreq ? parseInt(activeFreq.dataset.price,10) : ONE_CENTS; }
  function subCompare(){ return activeFreq ? parseInt(activeFreq.dataset.compare,10) : ONE_CENTS; }

  function refresh(){
    var hasF = FLAVOR_COUNT > 0;
    if(hasF && totalQty === 0){
      if(subPrice) subPrice.textContent='';
      if(subWas)   subWas.style.display='none';
      if(oneNow)   oneNow.textContent='';
      if(totalEl)  totalEl.textContent='';
      root.classList.add('rc-flavors-empty');
      if(addBtn) addBtn.setAttribute('disabled','');
      return;
    }
    root.classList.remove('rc-flavors-empty');
    if(addBtn) addBtn.removeAttribute('disabled');
    var m = hasF ? totalQty : 1;
    var su = subUnit(), sc = subCompare();
    if(subPrice) subPrice.textContent = money(su * m);
    if(subWas){ if(sc > su){ subWas.textContent = money(sc * m); subWas.style.display=''; } else { subWas.style.display='none'; } }
    if(oneNow) oneNow.textContent = money(ONE_CENTS * m);
    var unit = current === 'sub' ? su : ONE_CENTS;
    if(totalEl) totalEl.textContent = ' — ' + money(unit * m);
  }

  function renderMix(){
    if(!chipsEl) return;
    var picked = Object.keys(counts).filter(function(k){ return counts[k]>0; });
    if(countEl) countEl.textContent = totalQty;
    if(!picked.length){
      chipsEl.innerHTML = '<div class="rc-fa-empty">' + {{ block.settings.empty_text | default: 'Tap a flavor above to start your order ♡' | json }} + '</div>';
    } else {
      chipsEl.innerHTML = picked.map(function(k){
        var f = flavorInfo[k];
        return '<div class="rc-chip" style="--rc-fc:'+f.color+'">'
          +'<span class="rc-chip-dot"></span>'
          +'<span class="rc-chip-name">'+f.name+'</span>'
          +'<span class="rc-chip-qty">×'+counts[k]+'</span>'
          +'<button class="rc-chip-x" type="button" data-rm="'+k+'" aria-label="Remove">✕</button>'
          +'</div>';
      }).join('');
      slice(chipsEl.querySelectorAll('.rc-chip-x')).forEach(function(x){ x.addEventListener('click', function(){ setCount(x.dataset.rm, 0); }); });
    }
    Object.keys(flavorInfo).forEach(function(k){
      var f=flavorInfo[k], n=counts[k]||0;
      f.circle.classList.toggle('rc-active', n>0);
      if(f.badge){ f.badge.textContent=n; f.badge.classList.toggle('rc-show', n>0); }
      if(f.clear) f.clear.classList.toggle('rc-show', n>0);
    });
  }

  function recompute(){ totalQty = Object.keys(counts).reduce(function(s,k){ return s+(counts[k]||0); },0); }
  function setCount(k,n){ counts[k]=n<0?0:n; recompute(); renderMix(); refresh(); }
  function bump(el){ el.classList.remove('rc-bump'); void el.offsetWidth; el.classList.add('rc-bump'); }

  slice(root.querySelectorAll('.rc-circle')).forEach(function(c){
    var k = c.dataset.flavor;
    counts[k] = 0;
    var badge = c.querySelector('.rc-fc-badge');
    var clr = document.createElement('span');
    clr.className='rc-fc-clear'; clr.innerHTML='✕';
    clr.setAttribute('role','button'); clr.setAttribute('aria-label','Clear '+(c.dataset.name||''));
    clr.addEventListener('click', function(e){ e.stopPropagation(); setCount(k,0); });
    c.appendChild(clr);
    var col = (c.style.getPropertyValue('--rc-fc')||'').trim() || 'var(--rc-rose)';
    flavorInfo[k] = { name:c.dataset.name||'', variant:c.dataset.variant||'', color:col, badge:badge, clear:clr, circle:c };
    c.addEventListener('click', function(){ bump(c); setCount(k,(counts[k]||0)+1); });
  });

  function applyFreq(btn){
    if(!btn) return;
    activeFreq = btn;
    freqBtns.forEach(function(b){ b.classList.toggle('rc-on', b===btn); });
    if(cadenceEl) cadenceEl.textContent = btn.dataset.cadence;
    if(current==='sub' && spInput) spInput.value = btn.dataset.planId||'';
    refresh();
  }
  function toSub(){ if(current==='sub') return; current='sub'; onePlan.classList.remove('rc-on'); subPlan.classList.add('rc-on'); if(spInput) spInput.value=activeFreq?(activeFreq.dataset.planId||''):''; animateNum(tally,0,GIFT_TOTAL,600); staggerIn(items); refresh(); }
  function toOne(){ if(current==='one') return; current='one'; subPlan.classList.remove('rc-on'); onePlan.classList.add('rc-on'); if(spInput) spInput.value=''; staggerIn(lost); refresh(); }

  root.querySelectorAll('.rc-plan').forEach(function(pl){
    pl.addEventListener('click', function(){ pl.dataset.plan==='one'?toOne():toSub(); });
    pl.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); pl.dataset.plan==='one'?toOne():toSub(); } });
  });
  freqBtns.forEach(function(b){ b.addEventListener('click', function(e){ e.stopPropagation(); applyFreq(b); }); });

  var addLabel = addBtn ? addBtn.querySelector('.rc-cta-label') : null;
  var ctaDefault = {{ block.settings.cta_label | default: 'Add to cart' | json }};
  var btnTimer = null;

  function setBtn(state, msg){
    if(!addBtn) return;
    clearTimeout(btnTimer);
    addBtn.classList.remove('rc-cta--loading','rc-cta--success','rc-cta--error');
    if(state === 'loading'){
      addBtn.setAttribute('disabled','');
      addBtn.classList.add('rc-cta--loading');
      if(addLabel) addLabel.textContent = 'Adding…';
    } else if(state === 'success'){
      addBtn.removeAttribute('disabled');
      addBtn.classList.add('rc-cta--success');
      if(addLabel) addLabel.textContent = '✓ Added to cart';
      btnTimer = setTimeout(function(){ setBtn('idle'); }, 2200);
    } else if(state === 'error'){
      addBtn.removeAttribute('disabled');
      addBtn.classList.add('rc-cta--error');
      if(addLabel) addLabel.textContent = msg || 'Something went wrong';
      btnTimer = setTimeout(function(){ setBtn('idle'); }, 3500);
    } else {
      addBtn.removeAttribute('disabled');
      if(addLabel) addLabel.textContent = ctaDefault;
    }
  }

  if(form){
    form.addEventListener('submit', function(e){
      if(FLAVOR_COUNT===0) return;
      var planId = (current==='sub' && activeFreq) ? (activeFreq.dataset.planId||'') : '';
      var lineItems = [];
      Object.keys(counts).forEach(function(k){
        var f=flavorInfo[k];
        if(counts[k]>0 && f.variant){
          var it={id:parseInt(f.variant,10), quantity:counts[k]};
          if(planId) it.selling_plan=parseInt(planId,10);
          lineItems.push(it);
        }
      });
      if(lineItems.length){
        e.preventDefault();
        setBtn('loading');
        fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:lineItems})})
          .then(function(r){
            return r.json().then(function(d){ return {ok:r.ok, data:d}; });
          })
          .then(function(res){
            if(res.ok){ setBtn('success'); }
            else{ setBtn('error', res.data.description || res.data.message || 'Could not add to cart'); }
          })
          .catch(function(){ setBtn('error', 'Network error — please try again'); });
      } else {
        if(qtyInput) qtyInput.value = totalQty>0 ? totalQty : 1;
        if(planId && spInput) spInput.value = planId;
      }
    });
  }

  if(activeFreq) applyFreq(activeFreq);
  if(tally) tally.textContent = sym + GIFT_TOTAL;
  recompute(); renderMix(); refresh();
})();
</script>
