  #rc-{{ block.id }} .rc-reveal{ overflow:hidden; max-height:0; opacity:0; transition:max-height .45s var(--rc-spring),opacity .35s,margin .35s; margin-top:0; }
  #rc-{{ block.id }} .rc-plan.rc-on .rc-reveal{ max-height:1400px; opacity:1; margin-top:14px; }
  #rc-{{ block.id }} .rc-reveal-inner{ border-top:1.5px dashed rgba(232,96,122,.4); padding-top:16px; }
  #rc-{{ block.id }} .rc-reveal-h{ font-size:{{ block.settings.fs_gifts_heading | default: 10 }}px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:{{ block.settings.color_gifts_heading | default: 'var(--rc-rose)' }}; margin-bottom:12px; display:block; text-align:center; }
  #rc-{{ block.id }} .rc-loss-h{ font-size:{{ block.settings.fs_gifts_heading | default: 10 }}px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--rc-rose); margin-bottom:12px; display:block; text-align:center; }
  #rc-{{ block.id }} .rc-loss-h::before{ content:'✕\00a0\00a0'; }
  #rc-{{ block.id }} .rc-loss-h::after{ content:'\00a0\00a0✕'; }

  #rc-{{ block.id }} .rc-freq-row{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:15px; }
  @media (max-width:520px){
    #rc-{{ block.id }} .rc-freq-row{ flex-direction:column; align-items:stretch; gap:8px; }
    #rc-{{ block.id }} .rc-freq-label{ width:100%; text-align:center; }
    #rc-{{ block.id }} .rc-freq{ flex:1; }
  }
  #rc-{{ block.id }} .rc-freq-label{ font-size:{{ block.settings.fs_freq_label | default: 10 }}px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--rc-text-muted); text-align:center; line-height:1.3; }
  #rc-{{ block.id }} .rc-freq{ display:flex; flex:1; gap:5px; background:var(--rc-freq-bg); border-radius:999px; padding:4px; }
  #rc-{{ block.id }} .rc-freq button{ flex:1; border:none; background:none; padding:6px 13px; border-radius:999px; cursor:pointer; font-family:var(--rc-sans); font-weight:700; font-size:{{ block.settings.fs_freq | default: 12 }}px; color:var(--rc-text-muted); display:flex; flex-direction:column; align-items:center; justify-content:center; line-height:1.2; transition:background .2s,color .2s,box-shadow .2s; }
  #rc-{{ block.id }} .rc-freq button span{ font-weight:600; font-size:{{ block.settings.fs_freq_detail | default: 9 }}px; letter-spacing:.08em; text-transform:uppercase; opacity:.75; margin-top:2px; text-align:center; }
  #rc-{{ block.id }} .rc-freq button.rc-on{ background:var(--rc-freq-on-bg); color:var(--rc-freq-on-text); box-shadow:0 2px 12px rgba(27,58,92,.12); }
  #rc-{{ block.id }} .rc-freq button.rc-on span{ color:var(--rc-rose); opacity:1; }

  #rc-{{ block.id }} .rc-gifts{ display:flex; flex-direction:column; gap:var(--rc-gift-gap); }
  #rc-{{ block.id }} .rc-gift{ display:flex; align-items:center; gap:12px; background:var(--rc-gift-bg); border-radius:14px; padding:9px 14px; transition:opacity .4s ease,transform .5s var(--rc-spring); }
  #rc-{{ block.id }} .rc-g-ico{ display:inline-flex; align-items:center; justify-content:center; width:38px; height:38px; border-radius:50%; background:var(--rc-gift-ico-bg); color:var(--rc-rose); flex-shrink:0; overflow:hidden; }
  #rc-{{ block.id }} .rc-g-ico img{ width:100%; height:100%; object-fit:cover; border-radius:50%; }
  #rc-{{ block.id }} .rc-g-ico svg{ width:22px; height:22px; }
  #rc-{{ block.id }} .rc-g-name{ display:block; font-weight:600; font-size:var(--rc-fs-gift-name); color:var(--rc-text); line-height:1.2; }
  #rc-{{ block.id }} .rc-g-tag{ display:block; font-size:var(--rc-fs-gift-tag); color:var(--rc-text-muted); line-height:1.2; margin-top:1px; }
  #rc-{{ block.id }} .rc-g-val{ margin-left:auto; text-align:right; }
  #rc-{{ block.id }} .rc-strike{ font-size:{{ block.settings.fs_gift_value | default: 11 }}px; color:var(--rc-text-muted); text-decoration:line-through; }
  #rc-{{ block.id }} .rc-free{ display:block; font-size:{{ block.settings.fs_gift_free | default: 11 }}px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:var(--rc-lime); }

  #rc-{{ block.id }} .rc-tally{ display:flex; align-items:center; justify-content:center; gap:12px; margin-top:14px; background:var(--rc-tally-bg); border:1px solid var(--rc-tally-border); border-radius:14px; padding:12px 16px; }
  #rc-{{ block.id }} .rc-big{ font-family:var(--rc-serif); font-weight:900; font-size:var(--rc-fs-tally-num); color:var(--rc-tally-num); line-height:1; }
  #rc-{{ block.id }} .rc-lbl{ font-size:var(--rc-fs-tally-lbl); line-height:1.35; color:var(--rc-tally-lbl); }
  @media (max-width:520px){
    #rc-{{ block.id }} .rc-tally{ flex-direction:column; gap:6px; text-align:center; }
    #rc-{{ block.id }} .rc-lbl{ text-align:center; }
  }
  #rc-{{ block.id }} .rc-lbl b{ color:var(--rc-rose); }

  #rc-{{ block.id }} .rc-loss-note{ font-size:var(--rc-fs-loss); line-height:1.45; color:var(--rc-text-muted); margin-top:12px; }
