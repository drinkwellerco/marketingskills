{%- comment -%}
  buyboxblock.liquid — block adaptation of herdration-buy-box.liquid
  Renders inside proproductinfo.liquid via: {% render 'buyboxblock', block: block, product: product %}
{%- endcomment -%}

{%- assign p = product -%}
{%- assign cv = p.selected_or_first_available_variant | default: p.variants.first -%}
{%- assign sym = block.settings.currency_symbol | default: '$' -%}
{%- assign servings = block.settings.servings | default: 30 -%}

<div
  id="hb-{{ block.id }}"
  class="hb"
  data-block-id="{{ block.id }}"
  data-servings="{{ servings }}"
  data-symbol="{{ sym }}"
  {{ block.shopify_attributes }}>

  <div class="hb-inner">
  {%- if p == blank -%}
    <p style="padding:48px;text-align:center;width:100%;">No product found.</p>
  {%- else -%}

    {%- if block.settings.show_gallery -%}
    <div class="hb-gallery">
      <div class="hb-stage">
        <span class="hb-blob hb-blob1"></span>
        <span class="hb-blob hb-blob2"></span>
        <span class="hb-blob hb-blob3"></span>
        {%- if cv.featured_media -%}
          {{ cv.featured_media | image_url: width: 900 | image_tag: class: 'hb-main-img', alt: p.title, loading: 'eager' }}
        {%- elsif p.featured_image -%}
          {{ p.featured_image | image_url: width: 900 | image_tag: class: 'hb-main-img', alt: p.title, loading: 'eager' }}
        {%- endif -%}
      </div>

      {%- if p.media.size > 1 -%}
        <div class="hb-thumbs">
          {%- for media in p.media limit: 4 -%}
            <button type="button"
                    class="hb-thumb{% if forloop.first %} is-active{% endif %}"
                    data-media-url="{{ media | image_url: width: 600 }}"
                    aria-label="View image {{ forloop.index }}">
              {{ media | image_url: width: 200 | image_tag: alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="hb-buy">

      {%- if block.settings.brand_text != blank or block.settings.category_text != blank -%}
      <div class="hb-eyebrow">
        {%- if block.settings.brand_text != blank -%}<span class="hb-wordmark">{{ block.settings.brand_text }}</span>{%- endif -%}
        {%- if block.settings.brand_text != blank and block.settings.category_text != blank -%}<span class="hb-divider"></span>{%- endif -%}
        {%- if block.settings.category_text != blank -%}<span class="hb-ws">{{ block.settings.category_text }}</span>{%- endif -%}
      </div>
      {%- endif -%}

      {%- if block.settings.show_title -%}
        <h2 class="hb-title">{{ p.title }}</h2>
        <div class="hb-flavor-label" data-flavor-label>{{ cv.title }}</div>
      {%- endif -%}

      {%- if block.settings.subtitle != blank -%}
        <div class="hb-sub">{{ block.settings.subtitle }}</div>
      {%- endif -%}

      {%- if block.settings.show_rating -%}
        <div class="hb-rating">
          <span class="hb-stars">★★★★★</span>
          <span>{{ block.settings.rating_value }}</span>
          <a href="#reviews">{{ block.settings.rating_count }}</a>
        </div>
      {%- endif -%}

      <div class="hb-price-row">
        <span class="hb-price" data-price>{{ cv.price | money }}</span>
        <span class="hb-was" data-was hidden></span>
        <span class="hb-permeta" data-permeta></span>
      </div>

      {%- if block.settings.short_desc != blank -%}
        <p class="hb-desc">{{ block.settings.short_desc }}</p>
      {%- endif -%}

      {%- assign hb_form_id = 'hb-form-' | append: block.id -%}
      {%- form 'product', p, id: hb_form_id, class: 'hb-form' -%}
        <input type="hidden" name="id" value="{{ cv.id }}" data-variant-id>
        <input type="hidden" name="selling_plan" value="" data-selling-plan>

        {%- if p.variants.size > 1 -%}
          <div class="hb-selector">
            <div class="hb-sel-label">
              <span class="hb-name">Flavor</span>
              <span class="hb-value" data-flavor-value>{{ cv.title }}</span>
            </div>
            <div class="hb-flavor-pills">
              {%- for variant in p.variants -%}
                <button type="button"
                        class="hb-pill{% if variant.id == cv.id %} is-active{% endif %}{% unless variant.available %} is-soldout{% endunless %}"
                        data-variant="{{ variant.id }}"
                        data-title="{{ variant.title | escape }}"
                        {% if variant.featured_media %}data-media="{{ variant.featured_media | image_url: width: 900 }}"{% endif %}
                        {% unless variant.available %}aria-disabled="true"{% endunless %}>
                  <span class="hb-swatch" data-swatch></span>
                  <span class="hb-fname" data-fname>{{ variant.title }}</span>
                  {%- unless variant.available -%}<span class="hb-ftaste">Sold out</span>{%- endunless -%}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if p.selling_plan_groups.size > 0 -%}
          <div class="hb-selector">
            <div class="hb-sel-label">
              <span class="hb-name">Purchase plan</span>
              <span class="hb-value" data-plan-value>One-time</span>
            </div>
            <div class="hb-plans">

              <button type="button" class="hb-plan is-active" data-plan-id="">
                <span class="hb-check"></span>
                <span class="hb-plan-name">One-time</span>
                <span class="hb-plan-price" data-plan-base>{{ cv.price | money }}</span>
                <span class="hb-plan-note">Ships once. No commitment.</span>
              </button>

              {%- for group in p.selling_plan_groups -%}
                {%- for plan in group.selling_plans -%}
                  {%- comment -%} Parse plan label from Seal Subscriptions JSON or plain name {%- endcomment -%}
                  {%- assign rawval = plan.options.first.value | default: plan.name -%}
                  {%- if rawval contains '"interval"' -%}
                    {%- assign intv = rawval | split: '"interval":"' | last | split: '"' | first | downcase -%}
                    {%- assign freq = rawval | split: '"frequency":' | last | split: ',' | first | split: '}' | first | strip -%}
                    {%- assign disc = rawval | split: '"adjustmentValue":' | last | split: ',' | first | split: '}' | first | strip -%}
                    {%- if intv == 'month' -%}
                      {%- if freq == '1' -%}{%- assign displaylabel = 'Monthly' -%}
                      {%- elsif freq == '2' -%}{%- assign displaylabel = 'Bi-Monthly' -%}
                      {%- else -%}{%- assign displaylabel = 'Every ' | append: freq | append: ' Months' -%}{%- endif -%}
                    {%- elsif intv == 'week' -%}
                      {%- if freq == '1' -%}{%- assign displaylabel = 'Weekly' -%}
                      {%- elsif freq == '2' -%}{%- assign displaylabel = 'Bi-Weekly' -%}
                      {%- else -%}{%- assign displaylabel = 'Every ' | append: freq | append: ' Weeks' -%}{%- endif -%}
                    {%- else -%}
                      {%- assign displaylabel = plan.name -%}
                    {%- endif -%}
                    {%- assign discLabel = disc | append: '% off' -%}
                    {%- assign plannote = displaylabel | append: ' · ' | append: discLabel | append: ' · Skip or cancel anytime.' -%}
                  {%- else -%}
                    {%- assign rawparts = rawval | split: ' | ' -%}
                    {%- assign displaylabel = rawparts.first | strip -%}
                    {%- assign plannote = displaylabel | append: ' · Skip or cancel anytime.' -%}
                  {%- endif -%}

                  <button type="button" class="hb-plan" data-plan-id="{{ plan.id }}">
                    {%- assign alloc = nil -%}
                    {%- for a in cv.selling_plan_allocations -%}
                      {%- if a.selling_plan.id == plan.id -%}{%- assign alloc = a -%}{%- break -%}{%- endif -%}
                    {%- endfor -%}
                    {%- if alloc and alloc.compare_at_price and alloc.compare_at_price > alloc.per_delivery_price -%}
                      {%- assign saved = alloc.compare_at_price | minus: alloc.per_delivery_price | times: 100.0 | divided_by: alloc.compare_at_price | round -%}
                      <span class="hb-save" data-save-badge>Save {{ saved }}%</span>
                    {%- endif -%}
                    <span class="hb-check"></span>
                    <span class="hb-plan-name">{{ displaylabel }}</span>
                    <span class="hb-plan-price" data-plan-id-price="{{ plan.id }}">
                      {%- if alloc -%}{{ alloc.per_delivery_price | money }}{%- else -%}{{ cv.price | money }}{%- endif -%}
                    </span>
                    <span class="hb-plan-note">{{ plannote }}</span>
                  </button>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="hb-add-row">
          <div class="hb-qty">
            <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
            <span class="hb-count" data-qty-count>1</span>
            <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
            <input type="hidden" name="quantity" value="1" data-qty-input>
          </div>
          <button type="submit" name="add" class="hb-btn hb-btn-primary" data-add-btn>
            Add to cart — <span data-total>{{ cv.price | money }}</span>
          </button>
        </div>

        {%- if block.settings.show_dynamic_checkout -%}
          <div class="hb-dynamic">{{ form | payment_button }}</div>
        {%- endif -%}
      {%- endform -%}

      {%- if block.settings.show_assurances -%}
        <div class="hb-assurances">
          {%- for i in (1..3) -%}
            {%- assign tk = 'assurance_' | append: i | append: '_title' -%}
            {%- assign dk = 'assurance_' | append: i | append: '_text' -%}
            {%- assign tv = block.settings[tk] -%}
            {%- if tv != blank -%}
              <div class="hb-assurance">
                <span class="hb-assurance-dot"></span>
                <span class="hb-at">{{ tv }}</span>
                <span class="hb-ad">{{ block.settings[dk] }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  {%- endif -%}
  </div>

  <script type="application/json" data-hb-data>
    {
      "moneyFormat": {{ shop.money_format | json }},
      "variants": [
        {%- for v in p.variants -%}
        {
          "id": {{ v.id }},
          "title": {{ v.title | json }},
          "available": {{ v.available }},
          "price": {{ v.price }},
          "compare_at": {{ v.compare_at_price | default: 0 }},
          {%- if v.featured_media -%}"media": {{ v.featured_media | image_url: width: 900 | json }},{%- endif -%}
          "plans": {
            {%- for a in v.selling_plan_allocations -%}
            "{{ a.selling_plan.id }}": { "price": {{ a.per_delivery_price }}, "compare_at": {{ a.compare_at_price | default: v.price }} }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</div>

<style>
  #hb-{{ block.id }}{
    --hb-blush:#F2C4CE;
    --hb-peach:#E8A87C;
    --hb-sage:#8A9B6E;
    --hb-navy:{{ block.settings.text_color | default: '#1B3A5C' }};
    --hb-rose:{{ block.settings.accent_color | default: '#E8607A' }};
    --hb-cream:{{ block.settings.bg_color | default: '#FAF5F0' }};
    --hb-lime:{{ block.settings.flavor_label_color | default: '#7DB642' }};
    --hb-fog:{{ block.settings.pill_bg | default: '#F5EEE8' }};
    --hb-mist:{{ block.settings.border_color | default: '#E8DDD5' }};
    --hb-stone:{{ block.settings.muted_color | default: '#8A7E76' }};
    --hb-serif:'Playfair Display','Georgia',serif;
    --hb-display:'Cormorant Garamond','Georgia',serif;
    --hb-script:'Dancing Script',cursive;
    --hb-sans:'DM Sans','Helvetica Neue',sans-serif;
    --hb-shadow-sm:0 2px 12px rgba(27,58,92,.08);
    --hb-shadow-rose:0 6px 24px rgba(232,96,122,.28);
    background:var(--hb-cream); color:var(--hb-navy);
    font-family:var(--hb-sans); display:block;
    padding:{{ block.settings.section_padding_y | default: 0 }}px {{ block.settings.section_padding_x | default: 0 }}px;
    max-width:{{ block.settings.max_width | default: 600 }}px;
  }
  #hb-{{ block.id }} *{ box-sizing:border-box; }
  #hb-{{ block.id }} .hb-inner{
    display:{% if block.settings.show_gallery %}grid; grid-template-columns:1fr 1fr; gap:48px; align-items:start{% else %}block{% endif %};
  }

  #hb-{{ block.id }} .hb-gallery{ position:sticky; top:24px; }
  #hb-{{ block.id }} .hb-stage{
    position:relative; border-radius:24px; overflow:hidden;
    background:var(--hb-blush); aspect-ratio:1/1; isolation:isolate;
    display:flex; align-items:center; justify-content:center;
  }
  #hb-{{ block.id }} .hb-blob{ position:absolute; border-radius:50%; pointer-events:none; transition:background .3s,opacity .3s; }
  #hb-{{ block.id }} .hb-blob1{ width:50%; height:50%; top:8%; left:6%; background:var(--hb-peach); opacity:.45; }
  #hb-{{ block.id }} .hb-blob2{ width:38%; height:38%; bottom:10%; right:8%; background:var(--hb-sage); opacity:.35; }
  #hb-{{ block.id }} .hb-blob3{ width:28%; height:28%; top:14%; right:18%; background:var(--hb-blush); opacity:.55; }
  #hb-{{ block.id }} .hb-main-img{
    position:relative; z-index:2; width:62%; height:62%; object-fit:contain;
    filter:drop-shadow(0 24px 32px rgba(27,58,92,.18));
    transition:opacity .25s, transform .35s cubic-bezier(.34,1.56,.64,1);
  }
  #hb-{{ block.id }} .hb-thumbs{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:12px; }
  #hb-{{ block.id }} .hb-thumb{
    aspect-ratio:1/1; border-radius:14px; background:var(--hb-fog); overflow:hidden;
    border:2px solid transparent; cursor:pointer; padding:8px;
    display:flex; align-items:center; justify-content:center; transition:border-color .15s;
  }
  #hb-{{ block.id }} .hb-thumb.is-active{ border-color:var(--hb-rose); }
  #hb-{{ block.id }} .hb-thumb img{ width:80%; height:80%; object-fit:contain; }

  #hb-{{ block.id }} .hb-eyebrow{ display:flex; align-items:center; gap:10px; margin-bottom:10px; flex-wrap:wrap; }
  #hb-{{ block.id }} .hb-wordmark{ font-size:11px; letter-spacing:.2em; text-transform:uppercase; font-weight:600; color:var(--hb-navy); }
  #hb-{{ block.id }} .hb-divider{ width:20px; height:1px; background:var(--hb-mist); }
  #hb-{{ block.id }} .hb-ws{ font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--hb-stone); font-weight:600; }
  #hb-{{ block.id }} .hb-title{ font-family:var(--hb-serif); font-weight:900; font-size:{{ block.settings.title_size | default: 32 }}px; line-height:1.02; letter-spacing:-.02em; margin:0; color:var(--hb-navy); }
  #hb-{{ block.id }} .hb-flavor-label{ font-family:var(--hb-script); font-weight:700; font-size:26px; margin-top:6px; color:var(--hb-lime); transition:color .25s; }
  #hb-{{ block.id }} .hb-sub{ font-family:var(--hb-display); font-weight:300; font-size:{{ block.settings.subtitle_size | default: 16 }}px; letter-spacing:.03em; margin-top:6px; }
  #hb-{{ block.id }} .hb-rating{ display:flex; align-items:center; gap:10px; margin:14px 0 16px; font-size:12px; color:var(--hb-stone); }
  #hb-{{ block.id }} .hb-stars{ color:var(--hb-rose); letter-spacing:2px; font-size:14px; }
  #hb-{{ block.id }} .hb-rating a{ color:var(--hb-navy); text-decoration:underline; text-underline-offset:3px; }
  #hb-{{ block.id }} .hb-price-row{ display:flex; align-items:baseline; gap:10px; margin-bottom:16px; flex-wrap:wrap; }
  #hb-{{ block.id }} .hb-price{ font-family:var(--hb-serif); font-weight:800; font-size:{{ block.settings.price_size | default: 30 }}px; color:var(--hb-navy); }
  #hb-{{ block.id }} .hb-was{ font-size:16px; color:var(--hb-stone); text-decoration:line-through; opacity:.65; }
  #hb-{{ block.id }} .hb-permeta{ font-size:12px; color:var(--hb-stone); margin-left:auto; }
  #hb-{{ block.id }} .hb-desc{ font-size:{{ block.settings.desc_size | default: 14 }}px; line-height:1.6; font-weight:300; margin:0 0 22px; }

  #hb-{{ block.id }} .hb-selector{ margin-bottom:18px; }
  #hb-{{ block.id }} .hb-sel-label{ display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; }
  #hb-{{ block.id }} .hb-name{ font-size:11px; letter-spacing:.14em; text-transform:uppercase; font-weight:600; color:var(--hb-stone); }
  #hb-{{ block.id }} .hb-value{ font-size:13px; font-weight:600; color:var(--hb-navy); }

  #hb-{{ block.id }} .hb-flavor-pills{ display:grid; grid-template-columns:repeat({{ block.settings.flavor_cols | default: 3 }},1fr); gap:8px; }
  #hb-{{ block.id }} .hb-pill{
    border:1.5px solid var(--hb-mist); background:{{ block.settings.pill_bg | default: '#ffffff' }}; border-radius:{{ block.settings.pill_radius | default: 14 }}px; padding:12px 8px;
    cursor:pointer; transition:all .15s; display:flex; flex-direction:column; align-items:center; gap:6px; text-align:center;
  }
  #hb-{{ block.id }} .hb-pill:hover{ border-color:rgba(232,96,122,.4); }
  #hb-{{ block.id }} .hb-pill.is-active{ border-color:var(--hb-rose); background:rgba(232,96,122,.04); }
  #hb-{{ block.id }} .hb-pill.is-soldout{ opacity:.5; cursor:not-allowed; }
  #hb-{{ block.id }} .hb-swatch{ width:24px; height:24px; border-radius:50%; background:var(--hb-lime); flex-shrink:0; }
  #hb-{{ block.id }} .hb-fname{ font-family:var(--hb-script); font-weight:700; font-size:15px; line-height:1.05; color:var(--hb-navy); }
  #hb-{{ block.id }} .hb-ftaste{ font-size:9px; letter-spacing:.06em; text-transform:uppercase; color:var(--hb-stone); font-weight:600; }

  #hb-{{ block.id }} .hb-plans{ display:grid; grid-template-columns:{{ block.settings.plan_cols | default: '1fr 1fr' }}; gap:8px; }
  #hb-{{ block.id }} .hb-plan{
    position:relative; background:{{ block.settings.plan_bg | default: '#ffffff' }}; border:1.5px solid var(--hb-mist); border-radius:{{ block.settings.plan_radius | default: 14 }}px;
    padding:14px 14px 12px; cursor:pointer; transition:all .15s; text-align:left;
    display:flex; flex-direction:column; gap:3px;
  }
  #hb-{{ block.id }} .hb-plan:hover{ border-color:rgba(232,96,122,.4); }
  #hb-{{ block.id }} .hb-plan.is-active{ border-color:var(--hb-rose); background:rgba(232,96,122,.04); }
  #hb-{{ block.id }} .hb-plan-name{ font-weight:700; font-size:{{ block.settings.plan_name_size | default: 13 }}px; color:var(--hb-navy); padding-right:24px; }
  #hb-{{ block.id }} .hb-plan-price{ font-family:var(--hb-serif); font-weight:700; font-size:{{ block.settings.plan_price_size | default: 18 }}px; color:var(--hb-navy); }
  #hb-{{ block.id }} .hb-plan-note{ font-size:{{ block.settings.plan_note_size | default: 10 }}px; color:var(--hb-stone); line-height:1.35; }
  #hb-{{ block.id }} .hb-save{
    position:absolute; top:-9px; right:10px; background:var(--hb-rose); color:#fff;
    font-size:8px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; padding:3px 8px; border-radius:999px;
  }
  #hb-{{ block.id }} .hb-check{ position:absolute; top:12px; right:12px; width:18px; height:18px; border-radius:50%; border:1.5px solid var(--hb-mist); }
  #hb-{{ block.id }} .hb-plan.is-active .hb-check{ border-color:var(--hb-rose); background:var(--hb-rose); }
  #hb-{{ block.id }} .hb-plan.is-active .hb-check::after{ content:''; position:absolute; left:5px; top:5px; width:6px; height:3px; border-left:2px solid #fff; border-bottom:2px solid #fff; transform:rotate(-45deg); }

  #hb-{{ block.id }} .hb-add-row{ display:flex; gap:10px; align-items:stretch; margin:6px 0 10px; }
  #hb-{{ block.id }} .hb-qty{ display:inline-flex; align-items:center; border:1.5px solid var(--hb-mist); border-radius:999px; overflow:hidden; background:#fff; flex-shrink:0; }
  #hb-{{ block.id }} .hb-qty button{ background:none; border:none; padding:0 14px; height:46px; font-size:18px; color:var(--hb-navy); cursor:pointer; }
  #hb-{{ block.id }} .hb-qty button:hover{ color:var(--hb-rose); }
  #hb-{{ block.id }} .hb-count{ min-width:34px; text-align:center; font-weight:700; font-size:14px; }
  #hb-{{ block.id }} .hb-btn{
    display:inline-flex; align-items:center; justify-content:center; gap:6px; border:none; border-radius:{{ block.settings.btn_radius | default: 999 }}px;
    font-family:var(--hb-sans); font-weight:600; font-size:{{ block.settings.btn_size | default: 12 }}px; letter-spacing:.06em; text-transform:uppercase;
    padding:{{ block.settings.btn_padding_y | default: 14 }}px 20px; cursor:pointer; transition:transform .2s,box-shadow .2s,background .2s;
  }
  #hb-{{ block.id }} .hb-btn-primary{ flex:1; background:{{ block.settings.btn_bg | default: '#E8607A' }}; color:{{ block.settings.btn_text | default: '#ffffff' }}; box-shadow:var(--hb-shadow-rose); }
  #hb-{{ block.id }} .hb-btn-primary:hover{ transform:translateY(-2px); box-shadow:0 10px 32px rgba(232,96,122,.35); }
  #hb-{{ block.id }} .hb-dynamic{ margin-bottom:14px; }
  #hb-{{ block.id }} .hb-dynamic .shopify-payment-button__button{ border-radius:999px !important; min-height:50px; font-weight:600; }

  #hb-{{ block.id }} .hb-assurances{ display:grid; grid-template-columns:repeat(3,1fr); gap:8px; padding:16px 0 0; border-top:1px solid var(--hb-mist); margin-top:20px; }
  #hb-{{ block.id }} .hb-assurance{ display:flex; flex-direction:column; align-items:center; text-align:center; gap:5px; }
  #hb-{{ block.id }} .hb-assurance-dot{ width:9px; height:9px; border-radius:50%; background:var(--hb-rose); }
  #hb-{{ block.id }} .hb-at{ font-size:10px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--hb-navy); }
  #hb-{{ block.id }} .hb-ad{ font-size:10px; color:var(--hb-stone); line-height:1.35; }

  #hb-{{ block.id }} .hb-form > *:not(input):not(.hb-selector):not(.hb-add-row):not(.hb-dynamic){ display:none !important; }

  @media (max-width:820px){
    #hb-{{ block.id }}{ padding:0; max-width:{{ block.settings.mobile_max_width | default: 100 }}%; }
    #hb-{{ block.id }} .hb-inner{ {% if block.settings.show_gallery %}grid-template-columns:1fr; gap:24px;{% endif %} }
    #hb-{{ block.id }} .hb-gallery{ position:relative; top:auto; max-width:460px; margin:0 auto; width:100%; }
    #hb-{{ block.id }} .hb-permeta{ width:100%; margin-left:0; }
    #hb-{{ block.id }} .hb-title{ font-size:{{ block.settings.mobile_title_size | default: 26 }}px; }
    #hb-{{ block.id }} .hb-price{ font-size:{{ block.settings.mobile_price_size | default: 24 }}px; }
  }
  @media (max-width:430px){
    #hb-{{ block.id }} .hb-flavor-pills{ grid-template-columns:1fr; }
    #hb-{{ block.id }} .hb-pill{ flex-direction:row; justify-content:flex-start; gap:10px; padding:12px 14px; }
    #hb-{{ block.id }} .hb-pill .hb-ftaste{ margin-left:auto; }
    #hb-{{ block.id }} .hb-plans{ grid-template-columns:1fr; }
  }
</style>

<script>
(function(){
  var root = document.getElementById('hb-{{ block.id }}');
  if(!root) return;

  var dataEl = root.querySelector('[data-hb-data]');
  var DATA = {};
  try { DATA = JSON.parse(dataEl.textContent); } catch(e){ DATA = { variants: [] }; }

  var sym = root.dataset.symbol || '$';
  var servings = parseInt(root.dataset.servings, 10) || 30;

  function money(cents){
    if(cents == null || isNaN(cents)) return '';
    return sym + (cents/100).toFixed(2);
  }

  var SWATCH = { lime:'#7DB642', margarita:'#7DB642', raspberry:'#D64C6F', lemonade:'#D64C6F', strawberry:'#E8607A', coconut:'#C4A882' };
  function swatchFor(title){
    var t = (title||'').toLowerCase();
    for(var k in SWATCH){ if(t.indexOf(k) > -1) return SWATCH[k]; }
    return '#1B3A5C';
  }

  var state = { variantId: (DATA.variants[0]||{}).id, planId:'', qty:1 };

  function findVariant(id){ return DATA.variants.find(function(v){ return v.id == id; }) || DATA.variants[0]; }

  root.querySelectorAll('.hb-pill').forEach(function(pill){
    var c = swatchFor(pill.dataset.title);
    var sw = pill.querySelector('[data-swatch]'); if(sw) sw.style.background = c;
    var fn = pill.querySelector('[data-fname]'); if(fn) fn.style.color = c;
  });

  function unitCents(){
    var v = findVariant(state.variantId);
    if(state.planId && v.plans && v.plans[state.planId]) return v.plans[state.planId].price;
    return v.price;
  }
  function compareCents(){
    var v = findVariant(state.variantId);
    if(state.planId && v.plans && v.plans[state.planId]) return v.plans[state.planId].compare_at;
    return v.compare_at;
  }

  function render(){
    var v = findVariant(state.variantId);
    var unit = unitCents();
    var cmp  = compareCents();

    var priceEl = root.querySelector('[data-price]'); if(priceEl) priceEl.textContent = money(unit);
    var wasEl = root.querySelector('[data-was]');
    if(wasEl){
      if(cmp && cmp > unit){ wasEl.textContent = money(cmp); wasEl.hidden = false; }
      else { wasEl.hidden = true; }
    }
    var perEl = root.querySelector('[data-permeta]');
    if(perEl) perEl.textContent = money(Math.round(unit/servings)) + ' per serving';

    var totalEl = root.querySelector('[data-total]');
    if(totalEl) totalEl.textContent = money(unit * state.qty);

    var c = swatchFor(v.title);
    var fl = root.querySelector('[data-flavor-label]'); if(fl){ fl.textContent = v.title; fl.style.color = c; }
    var fv = root.querySelector('[data-flavor-value]'); if(fv) fv.textContent = v.title;

    var vi = root.querySelector('[data-variant-id]'); if(vi) vi.value = state.variantId;
    var sp = root.querySelector('[data-selling-plan]'); if(sp) sp.value = state.planId || '';

    root.querySelectorAll('.hb-plan').forEach(function(btn){
      var pid = btn.dataset.planId;
      var priceSlot = btn.querySelector('.hb-plan-price');
      if(!priceSlot) return;
      if(!pid){ priceSlot.textContent = money(v.price); }
      else if(v.plans && v.plans[pid]){ priceSlot.textContent = money(v.plans[pid].price); }
    });

    if(v.media){
      var img = root.querySelector('.hb-main-img');
      if(img && img.getAttribute('src') !== v.media){
        img.style.opacity = '0';
        setTimeout(function(){ img.src = v.media; img.style.opacity = '1'; }, 150);
      }
    }

    document.querySelectorAll('input[name="id"]').forEach(function(inp){
      if(!root.contains(inp)) inp.value = state.variantId;
    });
    document.dispatchEvent(new CustomEvent('variant:changed', { detail: { variantId: state.variantId } }));
  }

  root.querySelectorAll('.hb-pill').forEach(function(pill){
    pill.addEventListener('click', function(){
      if(pill.getAttribute('aria-disabled') === 'true') return;
      state.variantId = pill.dataset.variant;
      root.querySelectorAll('.hb-pill').forEach(function(p){ p.classList.toggle('is-active', p === pill); });
      render();
    });
  });

  root.querySelectorAll('.hb-plan').forEach(function(btn){
    btn.addEventListener('click', function(){
      state.planId = btn.dataset.planId || '';
      root.querySelectorAll('.hb-plan').forEach(function(b){ b.classList.toggle('is-active', b === btn); });
      var pv = root.querySelector('[data-plan-value]');
      if(pv) pv.textContent = btn.querySelector('.hb-plan-name').textContent.trim();
      render();
    });
  });

  function setQty(n){
    state.qty = Math.max(1, Math.min(12, n));
    var c = root.querySelector('[data-qty-count]'); if(c) c.textContent = state.qty;
    var inp = root.querySelector('[data-qty-input]'); if(inp) inp.value = state.qty;
    render();
  }
  var minus = root.querySelector('[data-qty-minus]'); if(minus) minus.addEventListener('click', function(){ setQty(state.qty-1); });
  var plus  = root.querySelector('[data-qty-plus]');  if(plus)  plus.addEventListener('click', function(){ setQty(state.qty+1); });

  root.querySelectorAll('.hb-thumb').forEach(function(th){
    th.addEventListener('click', function(){
      var url = th.dataset.mediaUrl; var img = root.querySelector('.hb-main-img');
      if(url && img){ img.src = url; }
      root.querySelectorAll('.hb-thumb').forEach(function(t){ t.classList.toggle('is-active', t === th); });
    });
  });

  render();
})();
</script>
