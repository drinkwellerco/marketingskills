{% comment %}
  Purchase Options Block
  Three clickable cards: One-Time Purchase / Monthly Subscribe / Bi-Monthly Subscribe.
  When One-Time is selected, the Subscribe section visually crosses itself out.
  Updates the form's selling_plan input automatically.
  Usage: {% render 'purchase-options', block: block, product: product, product_form_id: product_form_id %}
{% endcomment %}

<div class="po-wrapper" {{ block.shopify_attributes }} data-block-id="{{ block.id }}"
  style="
    margin-top: {{ block.settings.margin_top | default: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | default: 12 }}px;
    --po-gap: {{ block.settings.option_gap | default: 8 }}px;
    --po-radius: {{ block.settings.option_radius | default: 10 }}px;
    --po-border: {{ block.settings.border_color | default: '#e0e0e0' }};
    --po-border-sel: {{ block.settings.border_color_selected | default: '#D32F2F' }};
    --po-bg: {{ block.settings.bg_color | default: '#ffffff' }};
    --po-bg-sel: {{ block.settings.bg_color_selected | default: '#fff5f5' }};
    --po-label-color: {{ block.settings.label_color | default: '#222222' }};
    --po-label-size: {{ block.settings.label_size | default: 14 }}px;
    --po-sub-color: {{ block.settings.sublabel_color | default: '#666666' }};
    --po-sub-size: {{ block.settings.sublabel_size | default: 11 }}px;
    --po-price-color: {{ block.settings.price_color | default: '#000000' }};
    --po-price-size: {{ block.settings.price_size | default: 14 }}px;
    --po-badge-bg: {{ block.settings.badge_bg | default: '#D32F2F' }};
    --po-badge-color: {{ block.settings.badge_text_color | default: '#ffffff' }};
    --po-badge-size: {{ block.settings.badge_font_size | default: 10 }}px;
  ">

  {% assign one_time_label = block.settings.one_time_label | default: 'One-Time Purchase' %}
  {% assign subscribe_heading = block.settings.subscribe_heading | default: 'Subscribe & Save' %}
  {% assign monthly_label = block.settings.monthly_label | default: 'Monthly' %}
  {% assign bimonthly_label = block.settings.bimonthly_label | default: 'Bi-Monthly' %}

  <!-- One-Time Purchase Option -->
  <div class="po-option po-option--onetime po-option--selected"
    data-plan-type="onetime"
    data-plan-id=""
    role="button" tabindex="0">
    <div class="po-option__left">
      <div class="po-option__radio-dot"></div>
      <div class="po-option__texts">
        <span class="po-option__label">{{ one_time_label }}</span>
        {% if block.settings.one_time_sublabel != blank %}
          <span class="po-option__sublabel">{{ block.settings.one_time_sublabel }}</span>
        {% endif %}
      </div>
    </div>
    {% if block.settings.one_time_price != blank %}
      <span class="po-option__price">{{ block.settings.one_time_price }}</span>
    {% endif %}
  </div>

  <!-- Subscribe & Save Section -->
  <div class="po-subscribe-section" data-po-subscribe>
    {% if subscribe_heading != blank %}
      <div class="po-subscribe-heading">{{ subscribe_heading }}
        {% if block.settings.save_badge_text != blank %}
          <span class="po-badge">{{ block.settings.save_badge_text }}</span>
        {% endif %}
      </div>
    {% endif %}

    <!-- Monthly Option -->
    <div class="po-option po-option--monthly"
      data-plan-type="subscribe"
      data-plan-id="{{ block.settings.monthly_plan_id }}"
      role="button" tabindex="0">
      <div class="po-option__left">
        <div class="po-option__radio-dot"></div>
        <div class="po-option__texts">
          <span class="po-option__label">{{ monthly_label }}</span>
          {% if block.settings.monthly_sublabel != blank %}
            <span class="po-option__sublabel">{{ block.settings.monthly_sublabel }}</span>
          {% endif %}
        </div>
      </div>
      {% if block.settings.monthly_price != blank %}
        <span class="po-option__price">{{ block.settings.monthly_price }}</span>
      {% endif %}
    </div>

    <!-- Bi-Monthly Option -->
    <div class="po-option po-option--bimonthly"
      data-plan-type="subscribe"
      data-plan-id="{{ block.settings.bimonthly_plan_id }}"
      role="button" tabindex="0">
      <div class="po-option__left">
        <div class="po-option__radio-dot"></div>
        <div class="po-option__texts">
          <span class="po-option__label">{{ bimonthly_label }}</span>
          {% if block.settings.bimonthly_sublabel != blank %}
            <span class="po-option__sublabel">{{ block.settings.bimonthly_sublabel }}</span>
          {% endif %}
        </div>
      </div>
      {% if block.settings.bimonthly_price != blank %}
        <span class="po-option__price">{{ block.settings.bimonthly_price }}</span>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .po-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--po-gap, 8px);
  }

  .po-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: var(--po-bg);
    border: 1.5px solid var(--po-border);
    border-radius: var(--po-radius);
    padding: 12px 14px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .po-option:hover {
    border-color: var(--po-border-sel);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .po-option--selected {
    background: var(--po-bg-sel) !important;
    border-color: var(--po-border-sel) !important;
    border-width: 2px !important;
  }

  .po-option__left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }

  .po-option__radio-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--po-border);
    flex-shrink: 0;
    position: relative;
    transition: border-color 0.2s;
  }

  .po-option--selected .po-option__radio-dot {
    border-color: var(--po-border-sel);
  }

  .po-option--selected .po-option__radio-dot::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--po-border-sel);
  }

  .po-option__texts {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .po-option__label {
    font-size: var(--po-label-size);
    font-weight: 700;
    color: var(--po-label-color);
    line-height: 1.2;
  }

  .po-option__sublabel {
    font-size: var(--po-sub-size);
    color: var(--po-sub-color);
    line-height: 1.3;
  }

  .po-option__price {
    font-size: var(--po-price-size);
    font-weight: 700;
    color: var(--po-price-color);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .po-subscribe-section {
    display: flex;
    flex-direction: column;
    gap: var(--po-gap, 8px);
    transition: opacity 0.3s ease;
  }

  /* When one-time is active: cross out and dim the subscribe section */
  .po-wrapper[data-onetime-selected] .po-subscribe-section {
    opacity: 0.35;
    pointer-events: none;
    position: relative;
  }

  .po-wrapper[data-onetime-selected] .po-subscribe-section::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 6px,
      rgba(0,0,0,0.04) 6px,
      rgba(0,0,0,0.04) 7px
    );
    border-radius: var(--po-radius);
    pointer-events: none;
  }

  .po-subscribe-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: calc(var(--po-label-size) * 0.9);
    font-weight: 700;
    color: var(--po-label-color);
    padding: 0 2px;
  }

  .po-badge {
    display: inline-flex;
    align-items: center;
    background: var(--po-badge-bg);
    color: var(--po-badge-color);
    font-size: var(--po-badge-size);
    font-weight: 700;
    padding: 3px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
</style>

<script>
(function() {
  function initPO(wrapper) {
    var blockId = wrapper.getAttribute('data-block-id');
    var options = wrapper.querySelectorAll('.po-option');
    var subscribeSection = wrapper.querySelector('[data-po-subscribe]');
    var form = document.getElementById('{{ product_form_id }}') || document.querySelector('form[action*="/cart/add"]');

    function getOrCreateInput(name) {
      var input = form ? form.querySelector('input[name="' + name + '"]') : null;
      if (!input && form) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        form.appendChild(input);
      }
      return input;
    }

    function selectOption(opt) {
      options.forEach(function(o) { o.classList.remove('po-option--selected'); });
      opt.classList.add('po-option--selected');

      var planType = opt.getAttribute('data-plan-type');
      var planId = opt.getAttribute('data-plan-id') || '';
      var isOnetime = planType === 'onetime';

      /* Visual crossout on subscribe section */
      if (isOnetime) {
        wrapper.setAttribute('data-onetime-selected', '');
      } else {
        wrapper.removeAttribute('data-onetime-selected');
      }

      /* Update selling_plan in form */
      if (form) {
        var planInput = getOrCreateInput('selling_plan');
        if (planInput) planInput.value = isOnetime ? '' : planId;
      }
    }

    options.forEach(function(opt) {
      opt.addEventListener('click', function() { selectOption(opt); });
      opt.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectOption(opt); }
      });
    });

    /* Initialize with one-time selected */
    var onetime = wrapper.querySelector('.po-option--onetime');
    if (onetime) selectOption(onetime);
  }

  function ready() {
    document.querySelectorAll('.po-wrapper').forEach(initPO);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', ready);
  } else {
    ready();
  }
})();
</script>
