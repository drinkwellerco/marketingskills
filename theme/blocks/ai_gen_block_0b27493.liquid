{% doc %}
  @prompt
    A heading that allows for gradient accent text for my product display. Under it I will list all my products. Also allow for potential subheadings. I want to be able to change the colors 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gradient-heading-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-gradient-heading__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: 1.2;
    margin: 0 0 {{ block.settings.spacing_below_heading }}px;
    color: {{ block.settings.heading_color }};
  }

  {% if block.settings.enable_gradient_text %}
    .ai-gradient-heading__accent-{{ ai_gen_id }} {
      background: {{ block.settings.gradient_color }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      display: inline;
    }
  {% else %}
    .ai-gradient-heading__accent-{{ ai_gen_id }} {
      color: {{ block.settings.accent_color }};
      display: inline;
    }
  {% endif %}

  .ai-gradient-heading__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    line-height: 1.4;
    margin: 0;
    color: {{ block.settings.subheading_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-gradient-heading__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-gradient-heading__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-gradient-heading-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-gradient-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-gradient-heading__title-{{ ai_gen_id }}">
      {% if block.settings.accent_text != blank %}
        {% assign heading_parts = block.settings.heading | split: block.settings.accent_text %}
        {% if heading_parts.size > 1 %}
          {{ heading_parts[0] }}<span class="ai-gradient-heading__accent-{{ ai_gen_id }}">{{ block.settings.accent_text }}</span>{{ heading_parts[1] }}
        {% else %}
          {{ block.settings.heading }}
        {% endif %}
      {% else %}
        {{ block.settings.heading }}
      {% endif %}
    </h2>
  {% endif %}

  {% if block.settings.subheading != blank %}
    <p class="ai-gradient-heading__subheading-{{ ai_gen_id }}">
      {{ block.settings.subheading }}
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Gradient heading",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading text",
      "default": "Shop Our Products"
    },
    {
      "type": "inline_richtext",
      "id": "accent_text",
      "label": "Accent text",
      "info": "Enter the exact text from your heading that should have the gradient or accent color (e.g., 'Products')"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 48
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra-bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#fee696"
    },
    {
      "type": "header",
      "content": "Accent styling"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_text",
      "label": "Enable gradient accent",
      "default": true,
      "info": "When enabled, accent text uses gradient. When disabled, uses solid color."
    },
    {
      "type": "color_background",
      "id": "gradient_color",
      "label": "Gradient",
      "default": "linear-gradient(135deg, #46cc96 0%, #fee696 100%)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#46cc96",
      "info": "Used when gradient is disabled"
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading text"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Subheading size",
      "default": 18
    },
    {
      "type": "select",
      "id": "subheading_weight",
      "label": "Subheading weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#fee696"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "spacing_below_heading",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding horizontal",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Gradient heading"
    }
  ],
  "tag": null
}
{% endschema %}
