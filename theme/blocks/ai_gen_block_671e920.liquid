{% doc %}
  @prompt
    I need a section with as many customizable buttons as i want. even spaced across the page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-button-row-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-button-row-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-button-row-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.button_gap }}px;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
  }

  .ai-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-transform: {{ block.settings.button_text_transform }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    transition: all 0.3s ease;
    white-space: nowrap;
    {% if block.settings.button_full_width_mobile %}
      width: 100%;
    {% endif %}
  }

  .ai-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  @media screen and (min-width: 750px) {
    .ai-button-{{ ai_gen_id }} {
      width: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-button-row-wrapper-{{ ai_gen_id }} {
      gap: {{ block.settings.button_gap_mobile }}px;
      {% if block.settings.stack_on_mobile %}
        flex-direction: column;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-button-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-button-row-container-{{ ai_gen_id }}">
    <div class="ai-button-row-wrapper-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign button_text_key = 'button_' | append: i | append: '_text'
          assign button_url_key = 'button_' | append: i | append: '_url'
          assign button_text = block.settings[button_text_key]
          assign button_url = block.settings[button_url_key]
        %}
        
        {% if button_text != blank %}
          <a 
            href="{{ button_url | default: '#' }}" 
            class="ai-button-{{ ai_gen_id }}"
          >
            {{ button_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

