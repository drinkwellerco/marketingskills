{% doc %}
  @prompt
    Create a testimonials or content section with excerpts that show only the first couple of words initially (truncated text with ellipsis), and include an interactive "read more" / "show less" toggle button that allows users to expand and collapse the full excerpt text. The expand/collapse should work smoothly with JavaScript and be mobile-friendly., This is for featuring articles from prestigious magazines and new sites! Not for customer testimonials. Needs buttons to be able to link back to the article
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-press-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-press-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-press-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-press-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
  }

  .ai-press-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-press-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-press-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .ai-press-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | times: 1.5 | divided_by: 100.0 }});
  }

  .ai-press-logo-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.logo_height }}px;
    margin-bottom: 20px;
    padding: 10px;
  }

  .ai-press-logo-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: {{ block.settings.logo_height }}px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .ai-press-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.logo_height }}px;
    background-color: {{ block.settings.logo_placeholder_bg }};
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-press-logo-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    fill: {{ block.settings.logo_placeholder_color }};
  }

  .ai-press-content-{{ ai_gen_id }} {
    flex-grow: 1;
    margin-bottom: 16px;
  }

  .ai-press-publication-{{ ai_gen_id }} {
    font-size: {{ block.settings.publication_size }}px;
    font-weight: 700;
    color: {{ block.settings.publication_color }};
    margin: 0 0 8px;
  }

  .ai-press-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
    margin: 0 0 12px;
  }

  .ai-press-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-press-excerpt-truncated-{{ ai_gen_id }} {
    display: -webkit-box;
    -webkit-line-clamp: {{ block.settings.truncate_lines }};
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-press-excerpt-full-{{ ai_gen_id }} {
    display: block;
  }

  .ai-press-actions-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid {{ block.settings.divider_color }};
  }

  .ai-press-toggle-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.toggle_color }};
    font-size: {{ block.settings.toggle_size }}px;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .ai-press-toggle-{{ ai_gen_id }}:hover {
    color: {{ block.settings.toggle_hover_color }};
  }

  .ai-press-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: {{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: background-color 0.3s ease, transform 0.2s ease;
    margin-left: auto;
  }

  .ai-press-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    transform: translateX(2px);
  }

  .ai-press-link-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  @media screen and (max-width: 749px) {
    .ai-press-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-press-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-press-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }

    .ai-press-actions-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .ai-press-link-{{ ai_gen_id }} {
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }
  }
{% endstyle %}

<press-mentions-{{ ai_gen_id }}
  class="ai-press-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-press-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-press-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-press-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-press-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-press-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign publication_key = 'article_' | append: i | append: '_publication'
          assign logo_key = 'article_' | append: i | append: '_logo'
          assign date_key = 'article_' | append: i | append: '_date'
          assign excerpt_key = 'article_' | append: i | append: '_excerpt'
          assign url_key = 'article_' | append: i | append: '_url'

          assign publication = block.settings[publication_key]
          assign logo = block.settings[logo_key]
          assign date = block.settings[date_key]
          assign excerpt = block.settings[excerpt_key]
          assign url = block.settings[url_key]
        %}

        {% if excerpt != blank %}
          <div class="ai-press-card-{{ ai_gen_id }}">
            <div class="ai-press-logo-wrapper-{{ ai_gen_id }}">
              {% if logo != blank %}
                <img
                  src="{{ logo | image_url: width: 400 }}"
                  alt="{{ publication | escape }}"
                  class="ai-press-logo-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="{{ block.settings.logo_height }}"
                >
              {% else %}
                <div class="ai-press-logo-placeholder-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                  </svg>
                </div>
              {% endif %}
            </div>

            <div class="ai-press-content-{{ ai_gen_id }}">
              {% if publication != blank %}
                <div class="ai-press-publication-{{ ai_gen_id }}">{{ publication }}</div>
              {% endif %}

              {% if date != blank %}
                <div class="ai-press-date-{{ ai_gen_id }}">{{ date }}</div>
              {% endif %}

              <div
                class="ai-press-excerpt-{{ ai_gen_id }} ai-press-excerpt-truncated-{{ ai_gen_id }}"
                data-excerpt-text="{{ i }}"
              >
                {{ excerpt }}
              </div>
            </div>

            <div class="ai-press-actions-{{ ai_gen_id }}">
              <button
                class="ai-press-toggle-{{ ai_gen_id }}"
                data-toggle-btn="{{ i }}"
                aria-expanded="false"
              >
                {{ block.settings.read_more_text }}
              </button>

              {% if url != blank %}
                <a
                  href="{{ url }}"
                  class="ai-press-link-{{ ai_gen_id }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {{ block.settings.button_text }}
                  <svg class="ai-press-link-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                  </svg>
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</press-mentions-{{ ai_gen_id }}>

<script>
  (function() {
    class PressMentions{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.toggleButtons = this.querySelectorAll('[data-toggle-btn]');
        this.readMoreText = '{{ block.settings.read_more_text }}';
        this.showLessText = '{{ block.settings.show_less_text }}';
      }

      connectedCallback() {
        this.setupToggleButtons();
      }

      setupToggleButtons() {
        this.toggleButtons.forEach((button) => {
          const articleId = button.getAttribute('data-toggle-btn');
          const excerptElement = this.querySelector(`[data-excerpt-text="${articleId}"]`);

          if (!excerptElement) return;

          button.addEventListener('click', () => {
            const isExpanded = button.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
              excerptElement.classList.add('ai-press-excerpt-truncated-{{ ai_gen_id }}');
              excerptElement.classList.remove('ai-press-excerpt-full-{{ ai_gen_id }}');
              button.textContent = this.readMoreText;
              button.setAttribute('aria-expanded', 'false');
            } else {
              excerptElement.classList.remove('ai-press-excerpt-truncated-{{ ai_gen_id }}');
              excerptElement.classList.add('ai-press-excerpt-full-{{ ai_gen_id }}');
              button.textContent = this.showLessText;
              button.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }
    }

    customElements.define('press-mentions-{{ ai_gen_id }}', PressMentions{{ ai_gen_id }});
  })();
</script>

