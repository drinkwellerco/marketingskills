{%- comment -%}
  ============================================================
  WELLER CO. — Her'dration Quick-Add Strip  (Shopify Section)
  ------------------------------------------------------------
  Up to 5 product+variant slots. Each slot has a product picker,
  variant title field, and custom image picker. Subscribe & Save
  is always applied via a selling plan ID — there is no opt-out.
  One "Add all to cart" button adds every configured item at once.
  ============================================================
{%- endcomment -%}

{%- assign sid = section.id | replace: '_', '-' -%}
{%- assign brand = section.settings.brand_text | default: "Her'dration" -%}
{%- assign bp = brand | split: "'" -%}

<section id="qa-{{ sid }}" class="qa-strip" data-section-id="{{ section.id }}">
  <div class="qa-strip-inner{% if section.settings.products_on_left %} swapped{% endif %}">

    <!-- COPY -->
    <div class="qa-strip-copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="qa-strip-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="qa-strip-title">
        {{ section.settings.heading_lead }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="qa-strip-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.lead != blank -%}
        <p class="qa-strip-lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      <!-- Subscribe & Save badge (always shown) -->
      <div class="qa-strip-sub-badge">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="qa-strip-sub-label">{{ section.settings.subscription_label | default: 'Subscribe & Save' }}</span>
        {%- if section.settings.subscription_discount != blank -%}
          <span class="qa-strip-sub-pill">{{ section.settings.subscription_discount }}</span>
        {%- endif -%}
      </div>

      <button type="button" class="qa-strip-btn" id="qa-strip-btn-{{ sid }}">
        {{ section.settings.button_text | default: 'Add all to cart' }}
      </button>
    </div>

    <!-- PRODUCT TILES -->
    <div class="qa-strip-tiles" id="qa-strip-tiles-{{ sid }}">
      {%- assign has_items = false -%}
      {%- for i in (1..5) -%}
        {%- assign pkey = 'product_' | append: i -%}
        {%- assign vkey = 'variant_' | append: i -%}
        {%- assign ikey = 'image_'   | append: i -%}
        {%- assign prod         = section.settings[pkey] -%}
        {%- assign variant_title = section.settings[vkey] -%}
        {%- assign custom_image  = section.settings[ikey] -%}

        {%- if prod != blank -%}
          {%- assign has_items = true -%}
          {%- assign pv = prod.selected_or_first_available_variant | default: prod.variants.first -%}
          {%- if variant_title != blank -%}
            {%- for v in prod.variants -%}
              {%- if v.title == variant_title -%}{%- assign pv = v -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          <div class="qa-strip-tile" data-variant-id="{{ pv.id }}">
            <div class="qa-strip-tile-photo">
              <span class="qa-strip-blob"></span>
              <span class="qa-strip-blob b2"></span>
              {%- if custom_image != blank -%}
                {{ custom_image | image_url: width: 240 | image_tag: class: 'qa-strip-img', alt: prod.title, loading: 'lazy' }}
              {%- elsif pv.image -%}
                {{ pv.image | image_url: width: 240 | image_tag: class: 'qa-strip-img', alt: prod.title, loading: 'lazy' }}
              {%- elsif prod.featured_media -%}
                {{ prod.featured_media | image_url: width: 240 | image_tag: class: 'qa-strip-img', alt: prod.title, loading: 'lazy' }}
              {%- else -%}
                <div class="qa-strip-img-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
              {%- endif -%}
            </div>
            <span class="qa-strip-brand">{{ bp[0] }}{%- if bp.size > 1 -%}<span class="qa-strip-apos">'</span>{{ bp[1] }}{%- endif -%}</span>
            {%- assign lkey = 'label_' | append: i -%}
            <span class="qa-strip-name">
              {%- if section.settings[lkey] != blank -%}
                {{ section.settings[lkey] }}
              {%- else -%}
                {{ prod.title }}
              {%- endif -%}
            </span>
            {%- if pv.title != 'Default Title' -%}
              <span class="qa-strip-variant">{{ pv.title }}</span>
            {%- endif -%}
            <span class="qa-strip-price">
              {%- if pv.compare_at_price and pv.compare_at_price > pv.price -%}
                <s class="qa-strip-was">{{ pv.compare_at_price | money }}</s>
              {%- endif -%}
              <span class="qa-strip-now">{{ pv.price | money }}</span>
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- unless has_items -%}
        <p class="qa-strip-empty">Select up to 5 products in the section settings to get started.</p>
      {%- endunless -%}
    </div>

  </div>
</section>

<style>
  #qa-{{ sid }}{
    --qa-navy:#1B3A5C; --qa-rose:#E8607A; --qa-cream:#FAF5F0;
    --qa-mist:#E8DDD5; --qa-stone:#8A7E76; --qa-blush:#F2C4CE; --qa-peach:#E8A87C;
    --qa-shadow-sm:0 2px 12px rgba(27,58,92,.08);
    --qa-shadow-md:0 4px 24px rgba(27,58,92,.10);
    --qa-shadow-lg:0 8px 40px rgba(27,58,92,.12);
    --qa-serif:'Playfair Display','Georgia',serif;
    --qa-display:'Cormorant Garamond','Georgia',serif;
    --qa-sans:'DM Sans','Helvetica Neue',sans-serif;
    background:{{ section.settings.bg_color }}; color:var(--qa-navy);
    font-family:var(--qa-sans); display:block; padding:20px 32px 36px;
  }
  #qa-{{ sid }} *{ box-sizing:border-box; }
  #qa-{{ sid }} .qa-strip-inner{
    max-width:1180px; margin:0 auto;
    display:grid; grid-template-columns:.82fr 1.18fr; gap:44px; align-items:center;
    padding:26px 32px;
    background:rgba(255,255,255,.55);
    border:1.5px solid var(--qa-mist); border-radius:28px;
    box-shadow:var(--qa-shadow-sm);
  }
  #qa-{{ sid }} .qa-strip-inner.swapped .qa-strip-copy{ order:2; }
  #qa-{{ sid }} .qa-strip-inner.swapped .qa-strip-tiles{ order:1; }

  /* COPY */
  #qa-{{ sid }} .qa-strip-eyebrow{ display:inline-block; font-size:11px; font-weight:600; letter-spacing:.26em; text-transform:uppercase; color:var(--qa-rose); margin-bottom:12px; }
  #qa-{{ sid }} .qa-strip-title{ font-family:var(--qa-serif); font-weight:900; font-size:clamp(28px,2.6vw,38px); line-height:1.1; letter-spacing:-.02em; color:var(--qa-navy); margin:0 0 14px; }
  #qa-{{ sid }} .qa-strip-accent{ color:var(--qa-rose); display:block; }
  #qa-{{ sid }} .qa-strip-lead{ font-family:var(--qa-display); font-weight:300; font-size:clamp(15px,1.4vw,18px); letter-spacing:.02em; line-height:1.45; color:rgba(27,58,92,.72); margin:0 0 18px; }

  /* Subscribe badge */
  #qa-{{ sid }} .qa-strip-sub-badge{
    display:inline-flex; align-items:center; gap:7px; flex-wrap:wrap;
    padding:10px 16px; border-radius:12px; margin-bottom:20px;
    background:{{ section.settings.subscription_bg }};
    border:2px solid {{ section.settings.subscription_border }};
  }
  #qa-{{ sid }} .qa-strip-sub-badge svg{ width:18px; height:18px; flex-shrink:0; color:{{ section.settings.subscription_accent }}; }
  #qa-{{ sid }} .qa-strip-sub-label{ font-size:14px; font-weight:600; color:var(--qa-navy); }
  #qa-{{ sid }} .qa-strip-sub-pill{
    font-size:12px; font-weight:700; color:{{ section.settings.subscription_accent }};
    background:{{ section.settings.subscription_discount_bg }}; padding:3px 8px; border-radius:6px;
  }

  /* Button */
  #qa-{{ sid }} .qa-strip-btn{
    width:100%; padding:15px 20px;
    background:var(--qa-rose); color:#fff;
    border:none; border-radius:14px;
    font-family:var(--qa-sans); font-size:15px; font-weight:700; letter-spacing:.04em;
    cursor:pointer; transition:background .2s,opacity .2s;
  }
  #qa-{{ sid }} .qa-strip-btn:hover{ background:#d14d66; }
  #qa-{{ sid }} .qa-strip-btn:disabled{ opacity:.55; cursor:not-allowed; }

  /* Tiles grid */
  #qa-{{ sid }} .qa-strip-tiles{
    display:grid;
    grid-template-columns:repeat({{ section.settings.columns | default: 5 }},1fr);
    gap:12px;
  }
  #qa-{{ sid }} .qa-strip-tile{
    display:flex; flex-direction:column; align-items:center; gap:5px;
    text-align:center;
  }
  #qa-{{ sid }} .qa-strip-tile-photo{
    position:relative; width:100%; aspect-ratio:1/1; border-radius:16px; overflow:hidden;
    background:#fff; display:flex; align-items:center; justify-content:center;
    box-shadow:var(--qa-shadow-md);
  }
  #qa-{{ sid }} .qa-strip-blob{ position:absolute; width:130%; height:130%; border-radius:50%; background:var(--qa-blush); opacity:.85; top:-33%; left:-15%; }
  #qa-{{ sid }} .qa-strip-blob.b2{ width:68%; height:68%; top:auto; bottom:-20%; right:-13%; left:auto; background:var(--qa-peach); opacity:.75; }
  #qa-{{ sid }} .qa-strip-img{ position:relative; z-index:1; width:76%; height:76%; object-fit:contain; filter:drop-shadow(0 5px 10px rgba(27,58,92,.20)); }
  #qa-{{ sid }} .qa-strip-img-placeholder{ position:relative; z-index:1; width:55%; opacity:.4; }
  #qa-{{ sid }} .qa-strip-brand{ font-family:var(--qa-serif); font-weight:800; font-size:12px; line-height:1.1; color:var(--qa-navy); margin-top:4px; }
  #qa-{{ sid }} .qa-strip-apos{ color:var(--qa-rose); }
  #qa-{{ sid }} .qa-strip-name{ font-size:10px; font-weight:500; line-height:1.3; color:var(--qa-stone); }
  #qa-{{ sid }} .qa-strip-variant{ font-size:10px; font-weight:400; color:var(--qa-stone); opacity:.8; }
  #qa-{{ sid }} .qa-strip-price{ font-size:11px; display:inline-flex; align-items:baseline; gap:4px; flex-wrap:wrap; justify-content:center; }
  #qa-{{ sid }} .qa-strip-was{ color:var(--qa-stone); text-decoration:line-through; font-size:10px; }
  #qa-{{ sid }} .qa-strip-now{ color:var(--qa-rose); font-weight:700; }
  #qa-{{ sid }} .qa-strip-empty{ grid-column:1/-1; text-align:center; padding:30px; color:var(--qa-stone); font-style:italic; font-size:13px; }

  @media (max-width:900px){
    #qa-{{ sid }}{ padding:16px 16px 28px; }
    #qa-{{ sid }} .qa-strip-inner{ grid-template-columns:1fr; gap:28px; padding:22px 20px; }
    #qa-{{ sid }} .qa-strip-tiles{ grid-template-columns:repeat(3,1fr); }
  }
  @media (max-width:560px){
    #qa-{{ sid }} .qa-strip-tiles{ grid-template-columns:repeat(3,1fr); gap:8px; }
    #qa-{{ sid }} .qa-strip-brand{ font-size:10px; }
    #qa-{{ sid }} .qa-strip-name{ font-size:9px; }
  }
</style>

<script>
(function(){
  var btn   = document.getElementById('qa-strip-btn-{{ sid }}');
  var tiles = document.querySelectorAll('#qa-strip-tiles-{{ sid }} [data-variant-id]');
  if(!btn || !tiles.length) return;

  var sellingPlan = '{{ section.settings.selling_plan_id | strip }}';

  btn.addEventListener('click', function(){
    btn.disabled = true;
    var origText = btn.textContent;
    btn.textContent = 'Adding…';

    var items = [];
    tiles.forEach(function(t){
      var vid = t.dataset.variantId;
      if(!vid) return;
      var item = { id: parseInt(vid, 10), quantity: 1 };
      if(sellingPlan && sellingPlan !== '') item.selling_plan = parseInt(sellingPlan, 10);
      items.push(item);
    });

    if(!items.length){ btn.disabled = false; btn.textContent = origText; return; }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(function(r){
      if(!r.ok) throw new Error('cart/add failed');
      return r.json();
    })
    .then(function(){
      window.location.href = '/cart';
    })
    .catch(function(err){
      console.error(err);
      alert('There was an error adding items to your cart. Please try again.');
      btn.disabled = false;
      btn.textContent = origText;
    });
  });
})();
</script>

{% schema %}
{
  "name": "Her'dration Quick Add",
  "tag": "section",
  "class": "shopify-section--herdration-quickadd",
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Subscribe & Save" },
    { "type": "text", "id": "heading_lead", "label": "Heading (line 1)", "default": "10% OFF" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (coral, line 2)", "default": "+ Free Shipping, Always" },
    { "type": "text", "id": "lead", "label": "Lead line", "default": "Pick your flavors — we'll add them all as a subscription." },
    { "type": "text", "id": "brand_text", "label": "Brand name on tiles", "info": "The apostrophe is shown in coral.", "default": "Her'dration" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Add all to cart" },

    { "type": "header", "content": "Subscribe & Save" },
    { "type": "text", "id": "subscription_label", "label": "Badge label", "default": "Subscribe & Save" },
    { "type": "text", "id": "subscription_discount", "label": "Discount pill text", "default": "Save 15%" },
    { "type": "text", "id": "selling_plan_id", "label": "Selling plan ID", "info": "Numeric ID from Shopify. Found in Admin → Products → Subscriptions, or via the Storefront API. Leave blank to add as one-time purchase." },

    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FAF5F0" },
    { "type": "checkbox", "id": "products_on_left", "label": "Products on the left", "default": false },
    { "type": "range", "id": "columns", "label": "Tile columns (desktop)", "min": 3, "max": 5, "step": 1, "default": 5 },

    { "type": "header", "content": "Product 1" },
    { "type": "product", "id": "product_1", "label": "Product" },
    { "type": "text", "id": "variant_1", "label": "Variant title", "info": "Exact variant name, e.g. 'Raspberry Refresher'. Leave blank for first available." },
    { "type": "text", "id": "label_1", "label": "Display name override" },
    { "type": "image_picker", "id": "image_1", "label": "Custom image" },

    { "type": "header", "content": "Product 2" },
    { "type": "product", "id": "product_2", "label": "Product" },
    { "type": "text", "id": "variant_2", "label": "Variant title" },
    { "type": "text", "id": "label_2", "label": "Display name override" },
    { "type": "image_picker", "id": "image_2", "label": "Custom image" },

    { "type": "header", "content": "Product 3" },
    { "type": "product", "id": "product_3", "label": "Product" },
    { "type": "text", "id": "variant_3", "label": "Variant title" },
    { "type": "text", "id": "label_3", "label": "Display name override" },
    { "type": "image_picker", "id": "image_3", "label": "Custom image" },

    { "type": "header", "content": "Product 4" },
    { "type": "product", "id": "product_4", "label": "Product" },
    { "type": "text", "id": "variant_4", "label": "Variant title" },
    { "type": "text", "id": "label_4", "label": "Display name override" },
    { "type": "image_picker", "id": "image_4", "label": "Custom image" },

    { "type": "header", "content": "Product 5" },
    { "type": "product", "id": "product_5", "label": "Product" },
    { "type": "text", "id": "variant_5", "label": "Variant title" },
    { "type": "text", "id": "label_5", "label": "Display name override" },
    { "type": "image_picker", "id": "image_5", "label": "Custom image" },

    { "type": "header", "content": "Subscribe badge colors" },
    { "type": "color", "id": "subscription_bg", "label": "Badge background", "default": "#fef3c7" },
    { "type": "color", "id": "subscription_border", "label": "Badge border", "default": "#fbbf24" },
    { "type": "color", "id": "subscription_accent", "label": "Badge accent", "default": "#d97706" },
    { "type": "color", "id": "subscription_discount_bg", "label": "Discount pill background", "default": "#ffffff" }
  ],
  "presets": [
    { "name": "Her'dration Quick Add" }
  ]
}
{% endschema %}
