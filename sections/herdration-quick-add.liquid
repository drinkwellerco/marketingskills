{%- comment -%}
  ============================================================
  WELLER CO. — Her'dration Quick-Add Strip  (Shopify Section)
  ============================================================
{%- endcomment -%}

<section
  id="qa-{{ section.id }}"
  class="qa"
  data-section-id="{{ section.id }}">

  <div class="qa-inner{% if section.settings.products_on_left %} swapped{% endif %}" data-qa-inner>

    <!-- ============ COPY ============ -->
    <div class="qa-copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="qa-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="qa-title">
        {{ section.settings.heading_lead }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="qa-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.lead != blank -%}
        <p class="qa-lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      {%- if section.settings.show_swap -%}
        <button class="qa-swap" type="button" data-qa-swap aria-label="Swap sides">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
          {{ section.settings.swap_label | default: 'Swap sides' }}
        </button>
      {%- endif -%}
    </div>

    <!-- ============ PRODUCT TILES ============ -->
    <div class="qa-shop" data-qa-shop>
      {%- for block in section.blocks -%}
        {%- assign prod = block.settings.product -%}
        {%- if prod != blank -%}

          {%- comment -%} Variant by title, fallback to first available {%- endcomment -%}
          {%- assign pv = prod.selected_or_first_available_variant | default: prod.variants.first -%}
          {%- if block.settings.variant_title != blank -%}
            {%- for v in prod.variants -%}
              {%- if v.title == block.settings.variant_title -%}{%- assign pv = v -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%} Subscription pricing — compare as strings to avoid integer type mismatch {%- endcomment -%}
          {%- assign display_price   = pv.price -%}
          {%- assign display_compare = pv.compare_at_price -%}
          {%- assign sp_id_str = section.settings.selling_plan_id | strip -%}
          {%- if sp_id_str == blank -%}{%- assign sp_id_str = '5713658087' -%}{%- endif -%}
          {%- for alloc in pv.selling_plan_allocations -%}
            {%- assign alloc_id_str = alloc.selling_plan.id | append: '' -%}
            {%- if alloc_id_str == sp_id_str -%}
              {%- assign display_price   = alloc.price -%}
              {%- assign display_compare = alloc.compare_at_price -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Container color — block overrides section if toggled {%- endcomment -%}
          {%- if block.settings.con_override -%}
            {%- assign tile_con_enabled = block.settings.con_enabled -%}
            {%- assign tile_color1      = block.settings.con_color -%}
            {%- assign tile_grad        = block.settings.con_gradient -%}
            {%- assign tile_color2      = block.settings.con_color2 -%}
            {%- assign tile_angle       = block.settings.con_angle -%}
          {%- else -%}
            {%- assign tile_con_enabled = section.settings.con_enabled -%}
            {%- assign tile_color1      = section.settings.con_color -%}
            {%- assign tile_grad        = section.settings.con_gradient -%}
            {%- assign tile_color2      = section.settings.con_color2 -%}
            {%- assign tile_angle       = section.settings.con_angle -%}
          {%- endif -%}

          {%- if tile_con_enabled -%}
            {%- if tile_grad -%}
              {%- assign con_bg = 'linear-gradient(' | append: tile_angle | append: 'deg, ' | append: tile_color1 | append: ', ' | append: tile_color2 | append: ')' -%}
            {%- else -%}
              {%- assign con_bg = tile_color1 -%}
            {%- endif -%}
          {%- else -%}
            {%- assign con_bg = 'transparent' -%}
          {%- endif -%}

          {%- comment -%} Flavor label — || splits normal text from accent text {%- endcomment -%}
          {%- assign flavor_raw   = block.settings.label | default: pv.title | default: prod.title -%}
          {%- assign flavor_parts = flavor_raw | split: '||' -%}

          {%- comment -%} Brand name from product title — apostrophe gets coral accent {%- endcomment -%}
          {%- assign brand_parts = prod.title | split: "'" -%}

          <div class="qa-prod{% unless tile_con_enabled %} con-off{% endunless %}"
               {{ block.shopify_attributes }}
               data-qa-prod
               data-variant-id="{{ pv.id }}"
               data-product-url="{{ prod.url }}"
               role="button" tabindex="0"
               aria-label="Add {{ flavor_raw | escape }} to cart"
               style="--con-bg:{{ con_bg }};--con-radius:{{ block.settings.img_radius }}px;--con-size:{{ block.settings.img_size }}%;--img-x:{{ block.settings.img_x }}px;--img-y:{{ block.settings.img_y }}px;">

            <span class="qa-photo">
              {%- if block.settings.custom_image != blank -%}
                {{ block.settings.custom_image | image_url: width: 300 | image_tag: class: 'qa-img', alt: flavor_raw, loading: 'lazy' }}
              {%- elsif pv.image -%}
                {{ pv.image | image_url: width: 300 | image_tag: class: 'qa-img', alt: flavor_raw, loading: 'lazy' }}
              {%- elsif prod.featured_media -%}
                {{ prod.featured_media | image_url: width: 300 | image_tag: class: 'qa-img', alt: flavor_raw, loading: 'lazy' }}
              {%- elsif section.settings.mark_image != blank -%}
                {{ section.settings.mark_image | image_url: width: 240 | image_tag: class: 'qa-mark', alt: '' }}
              {%- endif -%}
              <button class="qa-remove" type="button" data-qa-remove aria-label="Remove one {{ flavor_raw | escape }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M5 12h14"/></svg>
              </button>
              <span class="qa-qty" data-qa-qty>0</span>
              <span class="qa-add">{{ section.settings.add_label | default: '+ Add' }}</span>
            </span>

            <span class="qa-brand">
              {%- if brand_parts.size > 1 -%}
                {{ brand_parts[0] }}<span class="qa-apos">'</span>{{ brand_parts[1] }}
              {%- else -%}
                {{ prod.title }}
              {%- endif -%}
            </span>

            <span class="qa-name">
              {%- assign fp0_words = flavor_parts[0] | split: ' ' -%}
              {{ fp0_words | join: '<br>' }}
              {%- if flavor_parts.size > 1 -%}
                {%- assign fp1_words = flavor_parts[1] | split: ' ' -%}
                <br><span class="qa-accent">{{ fp1_words | join: '<br>' }}</span>
              {%- endif -%}
            </span>

            <span class="qa-price">
              {%- if display_compare and display_compare > display_price -%}
                <span class="qa-was">{{ display_compare | money }}</span>
              {%- endif -%}
              <span class="qa-now">{{ display_price | money }}</span>
            </span>

          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <p style="grid-column:1/-1;text-align:center;color:#8A7E76;font-size:13px;">
          Add "Flavor tile" blocks in the theme editor to populate this strip.
        </p>
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  #qa-{{ section.id }}{
    --qa-navy:#1B3A5C; --qa-rose:{{ section.settings.accent_color }}; --qa-cream:#FAF5F0;
    --qa-mist:#E8DDD5; --qa-stone:#8A7E76;
    --qa-serif:'Playfair Display','Georgia',serif;
    --qa-display:'Cormorant Garamond','Georgia',serif;
    --qa-sans:'DM Sans','Helvetica Neue',sans-serif;
    --qa-shadow-sm:0 2px 12px rgba(27,58,92,.08);
    --qa-shadow-md:0 4px 24px rgba(27,58,92,.10);
    --qa-shadow-lg:0 8px 40px rgba(27,58,92,.12);
    background:{{ section.settings.bg_color }}; color:var(--qa-navy);
    font-family:var(--qa-sans); display:block;
    padding:{{ section.settings.section_pad_top }}px 32px {{ section.settings.section_pad_bottom }}px;
  }
  #qa-{{ section.id }} *{ box-sizing:border-box; }
  #qa-{{ section.id }} .qa-inner{
    max-width:1180px; margin:0 auto;
    display:grid; grid-template-columns:{{ section.settings.col_split }}fr {{ 100 | minus: section.settings.col_split }}fr; gap:{{ section.settings.col_gap }}px; align-items:center;
    padding:{{ section.settings.inner_pad }}px 32px;
    {%- if section.settings.inner_min_height > 0 %} min-height:{{ section.settings.inner_min_height }}px;{%- endif %}
    background:rgba(255,255,255,.55);
    border:1.5px solid var(--qa-mist); border-radius:28px;
    box-shadow:var(--qa-shadow-sm);
  }
  #qa-{{ section.id }} .qa-inner.swapped .qa-copy{ order:2; }
  #qa-{{ section.id }} .qa-inner.swapped .qa-shop{ order:1; }

  #qa-{{ section.id }} .qa-eyebrow{ display:inline-block; font-size:{{ section.settings.eyebrow_size }}px; font-weight:600; letter-spacing:{{ section.settings.eyebrow_ls }}px; text-transform:uppercase; color:var(--qa-rose); margin-bottom:{{ section.settings.eyebrow_mb }}px; }
  #qa-{{ section.id }} .qa-title{ font-family:var(--qa-serif); font-weight:900; font-size:{{ section.settings.heading_size }}px; line-height:{{ section.settings.heading_lh }}%; letter-spacing:-.02em; color:var(--qa-navy); margin:0 0 {{ section.settings.heading_mb }}px; }
  #qa-{{ section.id }} .qa-accent{ color:var(--qa-rose); }
  #qa-{{ section.id }} .qa-title .qa-accent{ display:block; }
  #qa-{{ section.id }} .qa-lead{ font-family:var(--qa-display); font-weight:300; font-size:{{ section.settings.lead_size }}px; letter-spacing:.02em; line-height:{{ section.settings.lead_lh }}%; color:rgba(27,58,92,.72); margin:0; }

  #qa-{{ section.id }} .qa-swap{
    margin-top:18px; display:inline-flex; align-items:center; gap:7px;
    padding:7px 14px; border-radius:999px;
    background:rgba(27,58,92,.04); border:1px solid rgba(27,58,92,.18);
    color:var(--qa-navy); font-family:var(--qa-sans);
    font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase;
    cursor:pointer; transition:background .15s,border-color .15s,color .15s;
  }
  #qa-{{ section.id }} .qa-swap:hover{ background:rgba(232,96,122,.12); border-color:var(--qa-rose); color:var(--qa-rose); }
  #qa-{{ section.id }} .qa-swap svg{ width:14px; height:14px; }

  #qa-{{ section.id }} .qa-shop{ display:grid; grid-template-columns:repeat({{ section.blocks.size | at_least: 1 }},{{ section.settings.tile_size }}px); gap:{{ section.settings.tile_gap }}px; justify-content:center; }
  #qa-{{ section.id }} .qa-prod{
    position:relative; display:flex; flex-direction:column; align-items:center; gap:7px;
    padding:0; border:none; background:none; cursor:pointer; text-align:center;
    font-family:var(--qa-sans); transition:transform .18s;
  }
  #qa-{{ section.id }} .qa-prod:hover{ transform:translateY(-3px); }

  /* ---- Photo container ---- */
  #qa-{{ section.id }} .qa-photo{
    position:relative; width:100%; aspect-ratio:1/1;
    border-radius:var(--con-radius,18px);
    overflow:hidden;
    background:var(--con-bg,transparent);
    display:flex; align-items:center; justify-content:center;
    box-shadow:var(--qa-shadow-md); transition:box-shadow .18s,outline-color .18s;
    outline:2px solid transparent; outline-offset:2px;
  }
  #qa-{{ section.id }} .qa-prod.con-off .qa-photo{ box-shadow:none; }
  #qa-{{ section.id }} .qa-prod.in-cart .qa-photo{ outline-color:var(--qa-rose); }
  #qa-{{ section.id }} .qa-prod:hover .qa-photo{ box-shadow:var(--qa-shadow-lg); }
  #qa-{{ section.id }} .qa-prod.con-off:hover .qa-photo{ box-shadow:none; }

  #qa-{{ section.id }} .qa-img{ position:relative; z-index:1; width:var(--con-size,78%); height:var(--con-size,78%); object-fit:contain; filter:drop-shadow(0 6px 12px rgba(27,58,92,.20)); transform:translateX(var(--img-x,0px)) translateY(var(--img-y,0px)); }
  #qa-{{ section.id }} .qa-mark{ position:relative; z-index:1; width:58%; height:auto; filter:drop-shadow(0 4px 8px rgba(27,58,92,.18)); }

  #qa-{{ section.id }} .qa-add{
    position:absolute; z-index:2; bottom:8px; left:50%; transform:translateX(-50%);
    display:inline-flex; align-items:center; gap:4px; padding:4px 11px; border-radius:999px;
    background:var(--qa-navy); color:var(--qa-cream);
    font-size:9px; font-weight:700; letter-spacing:.1em; text-transform:uppercase;
    opacity:0; transition:opacity .18s; white-space:nowrap;
  }
  #qa-{{ section.id }} .qa-prod:hover .qa-add{ opacity:1; }
  #qa-{{ section.id }} .qa-remove{
    position:absolute; top:7px; left:7px; z-index:4; width:24px; height:24px; border-radius:50%;
    border:none; cursor:pointer; background:#fff; color:var(--qa-navy);
    box-shadow:0 3px 8px rgba(0,0,0,.22); display:none; align-items:center; justify-content:center;
    font-size:16px; line-height:1; padding:0;
  }
  #qa-{{ section.id }} .qa-remove svg{ width:12px; height:12px; }
  #qa-{{ section.id }} .qa-remove:hover{ background:var(--qa-navy); color:#fff; }
  #qa-{{ section.id }} .qa-qty{
    position:absolute; top:7px; right:7px; z-index:4; min-width:24px; height:24px; padding:0 6px;
    border-radius:999px; background:var(--qa-rose); color:#fff; font-size:12px; font-weight:700;
    display:none; align-items:center; justify-content:center; box-shadow:0 3px 8px rgba(232,96,122,.4);
  }
  #qa-{{ section.id }} .qa-prod.in-cart .qa-remove,
  #qa-{{ section.id }} .qa-prod.in-cart .qa-qty{ display:inline-flex; }

  /* ---- Tile typography ---- */
  #qa-{{ section.id }} .qa-brand{
    font-family:'{{ section.settings.brand_font }}','Playfair Display','Georgia',serif;
    font-weight:800;
    font-size:{{ section.settings.brand_size }}px;
    line-height:1.1;
    color:{{ section.settings.brand_color }};
    margin-bottom:-2px;
  }
  #qa-{{ section.id }} .qa-apos{ color:var(--qa-rose); }
  #qa-{{ section.id }} .qa-name{
    font-family:'{{ section.settings.flavor_font }}','Playfair Display','Georgia',serif;
    font-size:{{ section.settings.flavor_size }}px;
    font-weight:500;
    line-height:1.2;
    color:{{ section.settings.flavor_color }};
  }
  #qa-{{ section.id }} .qa-price{
    margin-top:-2px; display:flex; flex-direction:column; align-items:center; gap:1px;
  }
  #qa-{{ section.id }} .qa-was{
    font-family:'{{ section.settings.price_orig_font }}','Playfair Display','Georgia',serif;
    font-size:{{ section.settings.price_orig_size }}px;
    color:{{ section.settings.price_orig_color }};
    text-decoration:line-through;
  }
  #qa-{{ section.id }} .qa-now{
    font-family:'{{ section.settings.price_sale_font }}','Playfair Display','Georgia',serif;
    font-size:{{ section.settings.price_sale_size }}px;
    color:{{ section.settings.price_sale_color }};
    font-weight:700;
  }
  #qa-{{ section.id }} .qa-prod.is-busy{ opacity:.6; pointer-events:none; }

  @media (max-width:900px){
    #qa-{{ section.id }}{ padding:16px 16px {{ section.settings.section_pad_bottom }}px; }
    #qa-{{ section.id }} .qa-inner{ grid-template-columns:1fr; gap:28px; padding:22px 20px; }
    #qa-{{ section.id }} .qa-inner.swapped .qa-copy{ order:1; }
    #qa-{{ section.id }} .qa-inner.swapped .qa-shop{ order:2; }
  }
  @media (max-width:560px){
    #qa-{{ section.id }} .qa-shop{ grid-template-columns:repeat(3,{{ section.settings.tile_size }}px); gap:{{ section.settings.tile_gap }}px; }
    #qa-{{ section.id }} .qa-add{ display:none; }
  }
</style>

<script>
(function(){
  var root = document.getElementById('qa-{{ section.id }}');
  if(!root) return;

  var inner = root.querySelector('[data-qa-inner]');
  var swapBtn = root.querySelector('[data-qa-swap]');
  if(swapBtn){ swapBtn.addEventListener('click', function(){ inner.classList.toggle('swapped'); }); }

  var tiles = Array.prototype.slice.call(root.querySelectorAll('[data-qa-prod]'));

  // Parse selling plan ID — fall back to hardcoded Monthly 10% off ID if field is blank
  var rawSP = '{{ section.settings.selling_plan_id | strip }}';
  if(rawSP === '') rawSP = '5713658087';
  var spNum = null;
  var parsed = parseInt(rawSP, 10);
  if(!isNaN(parsed) && parsed > 0) spNum = parsed;
  console.log('[Her\'dration Quick-Add] selling plan ID:', spNum);

  function setTile(tile, qty){
    qty = Math.max(0, qty|0);
    tile.dataset.qty = qty;
    tile.classList.toggle('in-cart', qty > 0);
    var b = tile.querySelector('[data-qa-qty]');
    if(b) b.textContent = qty;
  }

  function notifyTheme(cart){
    try {
      document.querySelectorAll('.cart-count-bubble span:first-child, [data-cart-count]').forEach(function(el){
        if(typeof cart.item_count === 'number') el.textContent = cart.item_count;
      });
      document.dispatchEvent(new CustomEvent('qa:cart-updated', { detail: cart, bubbles: true }));
      if(window.Shopify && Shopify.onCartUpdate) Shopify.onCartUpdate(cart);
    } catch(e){}
  }

  function refreshCounts(){
    fetch('/cart.js', { headers: { 'Accept':'application/json' } })
      .then(function(r){ return r.json(); })
      .then(function(cart){
        var counts = {}, lineKeys = {};
        (cart.items || []).forEach(function(it){
          counts[it.variant_id] = (counts[it.variant_id]||0) + it.quantity;
          lineKeys[it.variant_id] = it.key;
        });
        tiles.forEach(function(t){
          var vid = parseInt(t.dataset.variantId, 10);
          setTile(t, counts[vid] || 0);
          if(lineKeys[vid]) t.dataset.lineKey = lineKeys[vid];
        });
        notifyTheme(cart);
      })
      .catch(function(e){ console.warn('qa refreshCounts error', e); });
  }

  function addOne(tile){
    var id = tile.dataset.variantId;
    if(!id) return;

    var prevQty = parseInt(tile.dataset.qty, 10) || 0;
    setTile(tile, prevQty + 1);
    tile.classList.add('is-busy');

    var item = { id: parseInt(id, 10), quantity: 1 };
    if(spNum !== null) item.selling_plan = spNum;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
      body: JSON.stringify({ items: [item] })
    })
    .then(function(r){
      if(!r.ok){
        return r.json().then(function(e){
          console.error('[Her\'dration Quick-Add] cart/add.js failed — status:', r.status, '— response:', e);
          console.error('[Her\'dration Quick-Add] payload sent:', JSON.stringify({ id: parseInt(id,10), quantity: 1, selling_plan: spNum }));
          throw e;
        });
      }
      return r.json();
    })
    .then(function(){ refreshCounts(); })
    .catch(function(err){
      console.error('[Her\'dration Quick-Add] add failed completely', err);
      setTile(tile, prevQty);
    })
    .then(function(){ tile.classList.remove('is-busy'); });
  }

  function removeOne(tile){
    var current = parseInt(tile.dataset.qty, 10) || 0;
    if(current <= 0) return;

    setTile(tile, current - 1);
    tile.classList.add('is-busy');

    var lineId = tile.dataset.lineKey || tile.dataset.variantId;

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
      body: JSON.stringify({ id: lineId, quantity: current - 1 })
    })
    .then(function(r){
      if(!r.ok) return r.json().then(function(e){ throw e; });
      return r.json();
    })
    .then(function(){ refreshCounts(); })
    .catch(function(err){
      console.error('[Her\'dration Quick-Add] remove failed', err);
      setTile(tile, current);
    })
    .then(function(){ tile.classList.remove('is-busy'); });
  }

  tiles.forEach(function(tile){
    tile.addEventListener('click', function(){ addOne(tile); });
    tile.addEventListener('keydown', function(e){
      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); addOne(tile); }
    });
    var rm = tile.querySelector('[data-qa-remove]');
    if(rm){ rm.addEventListener('click', function(e){ e.stopPropagation(); removeOne(tile); }); }
  });

  refreshCounts();
})();
</script>

{% schema %}
{
  "name": "Her'dration Quick Add",
  "tag": "section",
  "class": "shopify-section--herdration-quickadd",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Subscribe & Save" },
    { "type": "text", "id": "heading_lead", "label": "Heading (line 1)", "default": "10% OFF" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (line 2, coral)", "default": "+ Free Shipping, Always" },
    { "type": "text", "id": "lead", "label": "Lead line", "default": "Quick add to cart — tap a flavor to drop it in." },

    { "type": "header", "content": "Subscribe & Save" },
    { "type": "text", "id": "selling_plan_id", "label": "Selling plan ID", "default": "5713658087", "info": "Katching Monthly 10% off plan. If wrong plan applies, try 5842731239. Leave blank to use default." },

    { "type": "header", "content": "Layout & Spacing" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FAF5F0" },
    { "type": "color", "id": "accent_color", "label": "Accent / coral color", "default": "#E8607A" },
    { "type": "range", "id": "section_pad_top", "label": "Section padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "section_pad_bottom", "label": "Section padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "inner_pad", "label": "Inner container padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "inner_min_height", "label": "Inner container min height", "min": 0, "max": 600, "step": 10, "unit": "px", "default": 0, "info": "0 = auto height." },
    { "type": "range", "id": "tile_size", "label": "Tile size (photo + container width)", "min": 50, "max": 240, "step": 10, "unit": "px", "default": 120, "info": "Controls the width of each product tile including its photo container." },
    { "type": "range", "id": "tile_gap", "label": "Spacing between tiles", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 },
