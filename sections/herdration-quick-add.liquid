{%- comment -%}
  ============================================================
  WELLER CO. — Her'dration Quick-Add Strip  (Shopify Section)
  ------------------------------------------------------------
  A condensed "Subscribe & Save" band that sits below a hero:
    promo copy on one side, a row of tappable flavor tiles on
    the other. Tap a tile -> AJAX adds 1 to cart with the
    configured selling plan (subscribe & save always on).
    A minus badge removes one; a quantity badge shows cart count.

  • Products  -> "Flavor tile" blocks (one variant each).
  • Variant   -> matched by title text, falls back to first available.
  • Image     -> custom image picker per block, falls back to product image.
  • Subscribe -> selling_plan_id applied to every add — no opt-out.
  • Pricing   -> shows subscription price from selling_plan_allocations.
  • Add/remove -> /cart/add.js + /cart/change.js (no reload).
  • Counts    -> hydrated live from /cart.js on load.
  • Optimistic UI -> tile updates instantly on click, reverts on error.

  Styles + JS are inlined and namespaced under #qa-{{ section.id }}
  so nothing leaks into (or breaks against) your theme.
  ============================================================
{%- endcomment -%}

{%- assign brand = section.settings.brand_text | default: "Her'dration" -%}
{%- assign bp = brand | split: "'" -%}

<section
  id="qa-{{ section.id }}"
  class="qa"
  data-section-id="{{ section.id }}">

  <div class="qa-inner{% if section.settings.products_on_left %} swapped{% endif %}" data-qa-inner>

    <!-- ============ COPY ============ -->
    <div class="qa-copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="qa-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="qa-title">
        {{ section.settings.heading_lead }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="qa-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.lead != blank -%}
        <p class="qa-lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      {%- if section.settings.show_swap -%}
        <button class="qa-swap" type="button" data-qa-swap aria-label="Swap sides">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
          {{ section.settings.swap_label | default: 'Swap sides' }}
        </button>
      {%- endif -%}
    </div>

    <!-- ============ PRODUCT TILES ============ -->
    <div class="qa-shop" data-qa-shop>
      {%- for block in section.blocks -%}
        {%- assign prod = block.settings.product -%}
        {%- if prod != blank -%}

          {%- comment -%} Variant selection by title, fallback to first available {%- endcomment -%}
          {%- assign pv = prod.selected_or_first_available_variant | default: prod.variants.first -%}
          {%- if block.settings.variant_title != blank -%}
            {%- for v in prod.variants -%}
              {%- if v.title == block.settings.variant_title -%}{%- assign pv = v -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%} Subscription pricing via selling_plan_allocations {%- endcomment -%}
          {%- assign display_price = pv.price -%}
          {%- assign display_compare = pv.compare_at_price -%}
          {%- if section.settings.selling_plan_id != blank -%}
            {%- assign sp_id_num = section.settings.selling_plan_id | plus: 0 -%}
            {%- for alloc in pv.selling_plan_allocations -%}
              {%- if alloc.selling_plan.id == sp_id_num -%}
                {%- assign display_price = alloc.price -%}
                {%- assign display_compare = alloc.compare_at_price -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- assign flavor = block.settings.label | default: pv.title | default: prod.title -%}

          <div class="qa-prod"
               {{ block.shopify_attributes }}
               data-qa-prod
               data-variant-id="{{ pv.id }}"
               data-product-url="{{ prod.url }}"
               role="button" tabindex="0"
               aria-label="Add {{ flavor | escape }} to cart"
               style="--pc:{{ block.settings.color_primary }};--pc2:{{ block.settings.color_secondary }};">
            <span class="qa-photo">
              <span class="qa-blob"></span>
              <span class="qa-blob b2"></span>
              {%- if block.settings.custom_image != blank -%}
                {{ block.settings.custom_image | image_url: width: 300 | image_tag: class: 'qa-img', alt: flavor, loading: 'lazy' }}
              {%- elsif pv.image -%}
                {{ pv.image | image_url: width: 300 | image_tag: class: 'qa-img', alt: flavor, loading: 'lazy' }}
              {%- elsif prod.featured_media -%}
                {{ prod.featured_media | image_url: width: 300 | image_tag: class: 'qa-img', alt: flavor, loading: 'lazy' }}
              {%- elsif section.settings.mark_image != blank -%}
                {{ section.settings.mark_image | image_url: width: 240 | image_tag: class: 'qa-mark', alt: '' }}
              {%- endif -%}
              <button class="qa-remove" type="button" data-qa-remove aria-label="Remove one {{ flavor | escape }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M5 12h14"/></svg>
              </button>
              <span class="qa-qty" data-qa-qty>0</span>
              <span class="qa-add">{{ section.settings.add_label | default: '+ Add' }}</span>
            </span>
            <span class="qa-brand">{{ bp[0] }}{%- if bp.size > 1 -%}<span class="qa-apos">'</span>{{ bp[1] }}{%- endif -%}</span>
            <span class="qa-name">{{ flavor }}</span>
            <span class="qa-price">
              {%- if display_compare and display_compare > display_price -%}
                <span class="qa-was">{{ display_compare | money }}</span>
              {%- endif -%}
              <span class="qa-now">{{ display_price | money }}</span>
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <p style="grid-column:1/-1;text-align:center;color:var(--qa-stone);font-size:13px;">
          Add "Flavor tile" blocks in the theme editor to populate this strip.
        </p>
      {%- endif -%}
    </div>

  </div>
</section>

{%- comment -%} ============ STYLES (namespaced) ============ {%- endcomment -%}
<style>
  #qa-{{ section.id }}{
    --qa-blush:#F2C4CE; --qa-peach:#E8A87C; --qa-sage:#8A9B6E;
    --qa-navy:#1B3A5C; --qa-rose:#E8607A; --qa-cream:#FAF5F0;
    --qa-mist:#E8DDD5; --qa-stone:#8A7E76;
    --qa-serif:'Playfair Display','Georgia',serif;
    --qa-display:'Cormorant Garamond','Georgia',serif;
    --qa-sans:'DM Sans','Helvetica Neue',sans-serif;
    --qa-shadow-sm:0 2px 12px rgba(27,58,92,.08);
    --qa-shadow-md:0 4px 24px rgba(27,58,92,.10);
    --qa-shadow-lg:0 8px 40px rgba(27,58,92,.12);
    background:{{ section.settings.bg_color }}; color:var(--qa-navy);
    font-family:var(--qa-sans); display:block; padding:20px 32px 36px;
  }
  #qa-{{ section.id }} *{ box-sizing:border-box; }
  #qa-{{ section.id }} .qa-inner{
    max-width:1180px; margin:0 auto;
    display:grid; grid-template-columns:.82fr 1.18fr; gap:44px; align-items:center;
    padding:26px 32px;
    background:rgba(255,255,255,.55);
    border:1.5px solid var(--qa-mist); border-radius:28px;
    box-shadow:var(--qa-shadow-sm);
  }
  #qa-{{ section.id }} .qa-inner.swapped .qa-copy{ order:2; }
  #qa-{{ section.id }} .qa-inner.swapped .qa-shop{ order:1; }

  #qa-{{ section.id }} .qa-eyebrow{ display:inline-block; font-size:11px; font-weight:600; letter-spacing:.26em; text-transform:uppercase; color:var(--qa-rose); margin-bottom:12px; }
  #qa-{{ section.id }} .qa-title{ font-family:var(--qa-serif); font-weight:900; font-size:clamp(28px,2.6vw,38px); line-height:1.1; letter-spacing:-.02em; color:var(--qa-navy); margin:0 0 14px; }
  #qa-{{ section.id }} .qa-accent{ color:var(--qa-rose); display:block; }
  #qa-{{ section.id }} .qa-lead{ font-family:var(--qa-display); font-weight:300; font-size:clamp(16px,1.5vw,19px); letter-spacing:.02em; line-height:1.4; color:rgba(27,58,92,.72); margin:0 0 18px; }

  #qa-{{ section.id }} .qa-swap{
    margin-top:4px; display:inline-flex; align-items:center; gap:7px;
    padding:7px 14px; border-radius:999px;
    background:rgba(27,58,92,.04); border:1px solid rgba(27,58,92,.18);
    color:var(--qa-navy); font-family:var(--qa-sans);
    font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase;
    cursor:pointer; transition:background .15s,border-color .15s,color .15s;
  }
  #qa-{{ section.id }} .qa-swap:hover{ background:rgba(232,96,122,.12); border-color:var(--qa-rose); color:var(--qa-rose); }
  #qa-{{ section.id }} .qa-swap svg{ width:14px; height:14px; }

  #qa-{{ section.id }} .qa-shop{ display:grid; grid-template-columns:repeat({{ section.blocks.size | at_least: 1 }},1fr); gap:12px; }
  #qa-{{ section.id }} .qa-prod{
    position:relative; display:flex; flex-direction:column; align-items:center; gap:7px;
    padding:0; border:none; background:none; cursor:pointer; text-align:center;
    font-family:var(--qa-sans); transition:transform .18s;
  }
  #qa-{{ section.id }} .qa-prod:hover{ transform:translateY(-3px); }
  #qa-{{ section.id }} .qa-photo{
    position:relative; width:100%; aspect-ratio:1/1; border-radius:18px; overflow:hidden;
    background:#fff; display:flex; align-items:center; justify-content:center;
    box-shadow:var(--qa-shadow-md); transition:box-shadow .18s,outline-color .18s;
    outline:2px solid transparent; outline-offset:2px;
  }
  #qa-{{ section.id }} .qa-prod.in-cart .qa-photo{ outline-color:var(--qa-rose); }
  #qa-{{ section.id }} .qa-prod:hover .qa-photo{ box-shadow:var(--qa-shadow-lg); }
  #qa-{{ section.id }} .qa-blob{ position:absolute; width:132%; height:132%; border-radius:50%; background:var(--pc,var(--qa-blush)); opacity:.9; top:-34%; left:-16%; }
  #qa-{{ section.id }} .qa-blob.b2{ width:70%; height:70%; top:auto; bottom:-22%; right:-14%; left:auto; background:var(--pc2,var(--qa-peach)); opacity:.8; }
  #qa-{{ section.id }} .qa-img{ position:relative; z-index:1; width:78%; height:78%; object-fit:contain; filter:drop-shadow(0 6px 12px rgba(27,58,92,.20)); }
  #qa-{{ section.id }} .qa-mark{ position:relative; z-index:1; width:58%; height:auto; filter:drop-shadow(0 4px 8px rgba(27,58,92,.18)); }
  #qa-{{ section.id }} .qa-add{
    position:absolute; z-index:2; bottom:8px; left:50%; transform:translateX(-50%);
    display:inline-flex; align-items:center; gap:4px; padding:4px 11px; border-radius:999px;
    background:var(--qa-navy); color:var(--qa-cream);
    font-size:9px; font-weight:700; letter-spacing:.1em; text-transform:uppercase;
    opacity:0; transition:opacity .18s; white-space:nowrap;
  }
  #qa-{{ section.id }} .qa-prod:hover .qa-add{ opacity:1; }
  #qa-{{ section.id }} .qa-remove{
    position:absolute; top:7px; left:7px; z-index:4; width:24px; height:24px; border-radius:50%;
    border:none; cursor:pointer; background:#fff; color:var(--qa-navy);
    box-shadow:0 3px 8px rgba(0,0,0,.22); display:none; align-items:center; justify-content:center;
    font-size:16px; line-height:1; padding:0;
  }
  #qa-{{ section.id }} .qa-remove svg{ width:12px; height:12px; }
  #qa-{{ section.id }} .qa-remove:hover{ background:var(--qa-navy); color:#fff; }
  #qa-{{ section.id }} .qa-qty{
    position:absolute; top:7px; right:7px; z-index:4; min-width:24px; height:24px; padding:0 6px;
    border-radius:999px; background:var(--qa-rose); color:#fff; font-size:12px; font-weight:700;
    display:none; align-items:center; justify-content:center; box-shadow:0 3px 8px rgba(232,96,122,.4);
  }
  #qa-{{ section.id }} .qa-prod.in-cart .qa-remove,
  #qa-{{ section.id }} .qa-prod.in-cart .qa-qty{ display:inline-flex; }
  #qa-{{ section.id }} .qa-brand{ font-family:var(--qa-serif); font-weight:800; font-size:14px; line-height:1.1; color:var(--qa-navy); margin-bottom:-2px; }
  #qa-{{ section.id }} .qa-apos{ color:var(--qa-rose); }
  #qa-{{ section.id }} .qa-name{ font-size:11px; font-weight:500; line-height:1.2; color:var(--qa-stone); }
  #qa-{{ section.id }} .qa-price{ font-size:11px; margin-top:-2px; display:inline-flex; align-items:baseline; gap:5px; justify-content:center; }
  #qa-{{ section.id }} .qa-was{ color:var(--qa-stone); text-decoration:line-through; }
  #qa-{{ section.id }} .qa-now{ color:var(--qa-rose); font-weight:700; }
  #qa-{{ section.id }} .qa-prod.is-busy{ opacity:.6; pointer-events:none; }

  @media (max-width:900px){
    #qa-{{ section.id }}{ padding:16px 16px 28px; }
    #qa-{{ section.id }} .qa-inner{ grid-template-columns:1fr; gap:28px; padding:22px 20px; }
    #qa-{{ section.id }} .qa-inner.swapped .qa-copy{ order:1; }
    #qa-{{ section.id }} .qa-inner.swapped .qa-shop{ order:2; }
  }
  @media (max-width:560px){
    #qa-{{ section.id }} .qa-shop{ grid-template-columns:repeat(3,1fr); gap:10px; }
    #qa-{{ section.id }} .qa-add{ display:none; }
  }
</style>

{%- comment -%} ============ BEHAVIOUR ============ {%- endcomment -%}
<script>
(function(){
  var root = document.getElementById('qa-{{ section.id }}');
  if(!root) return;

  var inner = root.querySelector('[data-qa-inner]');
  var swapBtn = root.querySelector('[data-qa-swap]');
  if(swapBtn){ swapBtn.addEventListener('click', function(){ inner.classList.toggle('swapped'); }); }

  var tiles = Array.prototype.slice.call(root.querySelectorAll('[data-qa-prod]'));
  var sellingPlan = '{{ section.settings.selling_plan_id | strip }}';
  var spNum = (sellingPlan !== '') ? parseInt(sellingPlan, 10) : null;

  function setTile(tile, qty){
    qty = Math.max(0, qty|0);
    tile.dataset.qty = qty;
    tile.classList.toggle('in-cart', qty > 0);
    var b = tile.querySelector('[data-qa-qty]');
    if(b) b.textContent = qty;
  }

  function notifyTheme(cart){
    document.querySelectorAll('.cart-count-bubble span:first-child, [data-cart-count]').forEach(function(el){
      if(cart && typeof cart.item_count === 'number') el.textContent = cart.item_count;
    });
    document.dispatchEvent(new CustomEvent('qa:cart-updated', { detail: cart, bubbles: true }));
    if(window.Shopify && Shopify.onCartUpdate){ try{ Shopify.onCartUpdate(cart); }catch(e){} }
  }

  function refreshCounts(){
    fetch('/cart.js', { headers: { 'Accept':'application/json' } })
      .then(function(r){ return r.json(); })
      .then(function(cart){
        var counts = {};
        var lineKeys = {};
        (cart.items || []).forEach(function(it){
          var vid = it.variant_id;
          counts[vid] = (counts[vid]||0) + it.quantity;
          lineKeys[vid] = it.key;
        });
        tiles.forEach(function(t){
          var vid = parseInt(t.dataset.variantId, 10);
          setTile(t, counts[vid] || 0);
          if(lineKeys[vid]) t.dataset.lineKey = lineKeys[vid];
        });
        notifyTheme(cart);
      })
      .catch(function(){});
  }

  function addOne(tile){
    var id = tile.dataset.variantId;
    if(!id) return;

    // Optimistic update — show number/minus immediately, no waiting for network
    var prevQty = parseInt(tile.dataset.qty, 10) || 0;
    setTile(tile, prevQty + 1);
    tile.classList.add('is-busy');

    var item = { id: parseInt(id, 10), quantity: 1 };
    if(spNum) item.selling_plan = spNum;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
      body: JSON.stringify({ items: [item] })
    })
    .then(function(r){
      if(!r.ok) return r.json().then(function(e){ throw e; });
      return r.json();
    })
    .then(function(){
      refreshCounts();
    })
    .catch(function(err){
      console.error('qa add error:', err);
      setTile(tile, prevQty); // revert on error
    })
    .finally(function(){
      tile.classList.remove('is-busy');
    });
  }

  function removeOne(tile){
    var current = parseInt(tile.dataset.qty, 10) || 0;
    if(current <= 0) return;

    // Optimistic update — show change immediately
    setTile(tile, current - 1);
    tile.classList.add('is-busy');

    // Use line key (required when selling plan is involved — variant ID alone won't match)
    var lineId = tile.dataset.lineKey || tile.dataset.variantId;

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
      body: JSON.stringify({ id: lineId, quantity: current - 1 })
    })
    .then(function(r){
      if(!r.ok) return r.json().then(function(e){ throw e; });
      return r.json();
    })
    .then(function(){
      refreshCounts();
    })
    .catch(function(err){
      console.error('qa remove error:', err);
      setTile(tile, current); // revert on error
    })
    .finally(function(){
      tile.classList.remove('is-busy');
    });
  }

  tiles.forEach(function(tile){
    tile.addEventListener('click', function(){ addOne(tile); });
    tile.addEventListener('keydown', function(e){
      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); addOne(tile); }
    });
    var rm = tile.querySelector('[data-qa-remove]');
    if(rm){ rm.addEventListener('click', function(e){ e.stopPropagation(); removeOne(tile); }); }
  });

  refreshCounts();
})();
</script>

{%- comment -%} ============ THEME EDITOR SCHEMA ============ {%- endcomment -%}
{% schema %}
{
  "name": "Her'dration Quick Add",
  "tag": "section",
  "class": "shopify-section--herdration-quickadd",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Subscribe & Save" },
    { "type": "text", "id": "heading_lead", "label": "Heading (line 1)", "default": "10% OFF" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (coral, line 2)", "default": "+ Free Shipping, Always" },
    { "type": "text", "id": "lead", "label": "Lead line", "default": "Quick add to cart — tap a flavor to drop it in." },
    { "type": "text", "id": "brand_text", "label": "Product name on tiles", "info": "The apostrophe is shown in coral.", "default": "Her'dration" },

    { "type": "header", "content": "Subscribe & Save" },
    { "type": "text", "id": "subscription_label", "label": "Badge label", "default": "Subscribe & Save" },
    { "type": "text", "id": "subscription_discount", "label": "Discount pill text", "default": "Save 15%" },
    { "type": "text", "id": "selling_plan_id", "label": "Selling plan ID", "info": "Numeric ID of your subscription selling plan. Applied to every add. Leave blank for one-time purchase." },

    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Background", "info": "Match your hero background.", "default": "#FAF5F0" },
    { "type": "checkbox", "id": "products_on_left", "label": "Products on the left", "default": false },
    { "type": "checkbox", "id": "show_swap", "label": "Show 'Swap sides' button", "default": true },
    { "type": "text", "id": "swap_label", "label": "Swap button label", "default": "Swap sides" },

    { "type": "header", "content": "Tile labels" },
    { "type": "text", "id": "add_label", "label": "Add hover label", "default": "+ Add" },
    { "type": "image_picker", "id": "mark_image", "label": "Fallback mark image", "info": "Shown on tiles with no product image or custom image." },

    { "type": "header", "content": "Subscribe badge colors" },
    { "type": "color", "id": "subscription_bg", "label": "Badge background", "default": "#fef3c7" },
    { "type": "color", "id": "subscription_border", "label": "Badge border", "default": "#fbbf24" },
    { "type": "color", "id": "subscription_accent", "label": "Badge accent", "default": "#d97706" },
    { "type": "color", "id": "subscription_discount_bg", "label": "Discount pill background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor tile",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "variant_title", "label": "Variant title", "info": "Exact variant name, e.g. 'Raspberry Refresher'. Leave blank for first available variant." },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image", "info": "Overrides the product/variant image." },
        { "type": "text", "id": "label", "label": "Flavor name override", "info": "Defaults to the variant title, then product title." },
        { "type": "color", "id": "color_primary", "label": "Tile color — primary blob", "default": "#D64C6F" },
        { "type": "color", "id": "color_secondary", "label": "Tile color — secondary blob", "default": "#F2C4CE" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Her'dration Quick Add",
      "blocks": [
        { "type": "flavor", "settings": { "label": "Raspberry Refresher", "color_primary": "#D64C6F", "color_secondary": "#F2C4CE" } },
        { "type": "flavor", "settings": { "label": "Lime Margarita", "color_primary": "#7DB642", "color_secondary": "#E8A87C" } },
        { "type": "flavor", "settings": { "label": "Coconut Strawberry", "color_primary": "#E8607A", "color_secondary": "#C4A882" } },
        { "type": "flavor", "settings": { "label": "Hot Chocolate", "color_primary": "#7A5240", "color_secondary": "#B07A52" } },
        { "type": "flavor", "settings": { "label": "Unflavored", "color_primary": "#E8DDD5", "color_secondary": "#4A90B8" } }
      ]
    }
  ]
}
{% endschema %}
