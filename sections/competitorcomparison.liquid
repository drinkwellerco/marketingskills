{%- comment -%}
  WELLER CO. — Competitor Comparison
  Full desktop/mobile control: fonts, sizes, colors, spacing, icons, badge, logo.
{%- endcomment -%}

{%- capture svg_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>{%- endcapture -%}
{%- capture svg_cross -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>{%- endcapture -%}

{%- assign three = section.settings.c2_enabled -%}
{%- if three -%}
  {%- assign grid_cols = '1.35fr 1.06fr .92fr .92fr' -%}
  {%- assign min_w = section.settings.min_w_3col | append: 'px' -%}
{%- else -%}
  {%- assign grid_cols = '1.5fr 1.18fr 1fr' -%}
  {%- assign min_w = section.settings.min_w_2col | append: 'px' -%}
{%- endif -%}

{%- comment -%} Left-to-right order of the product columns (label column is always first) {%- endcomment -%}
{%- assign us_order = section.settings.us_order | default: 1 -%}
{%- assign c1_order = section.settings.c1_order | default: 2 -%}
{%- assign c2_order = section.settings.c2_order | default: 3 -%}

{%- assign brand = section.settings.us_name | default: "Her'dration" -%}
{%- assign bp = brand | split: "'" -%}
{%- assign unit = section.settings.price_unit | default: '/serving' -%}
{%- if section.settings.bg_gradient -%}
  {%- assign bg_top = section.settings.bg_color_2 -%}
{%- else -%}
  {%- assign bg_top = section.settings.bg_color -%}
{%- endif -%}

<section id="cmp-{{ section.id }}" class="cmp">
  <div class="cmp-inner">

    <div class="cmp-head-block">
      {%- if section.settings.eyebrow != blank -%}<span class="cmp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="cmp-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lead != blank -%}<p class="cmp-lead">{{ section.settings.lead }}</p>{%- endif -%}
    </div>

    <div class="cmp-scroll">
      <div class="cmp-grid">

        <div class="cmp-col cmp-col-feat" style="order:0;">
          <div class="cmp-cellhead"><span class="cmp-feat-eyebrow">{{ section.settings.feat_label | default: 'How we compare' }}</span></div>
          {%- for block in section.blocks -%}
            <div class="cmp-cell" {{ block.shopify_attributes }}>
              {{ block.settings.label }}
              {%- if block.settings.sublabel != blank -%}<span class="cmp-feat-sub">{{ block.settings.sublabel }}</span>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="cmp-col cmp-col-us" style="order:{{ us_order }};">
          {%- if section.settings.us_badge != blank -%}<span class="cmp-badge">{{ section.settings.us_badge }}</span>{%- endif -%}
          <div class="cmp-cellhead">
            {%- if section.settings.us_mark != blank -%}{{ section.settings.us_mark | image_url: width: 240 | image_tag: class: 'cmp-mark', alt: brand }}{%- endif -%}
            <span class="cmp-brand">{{ bp[0] }}{%- if bp.size > 1 -%}<span class="cmp-apos">&#8217;</span>{{ bp[1] }}{%- endif -%}</span>
            {%- if section.settings.us_tag != blank -%}<span class="cmp-tag">{{ section.settings.us_tag }}</span>{%- endif -%}
          </div>
          {%- for block in section.blocks -%}
            {%- if block.settings.is_price -%}
              <div class="cmp-cell cmp-price-row"><span class="cmp-price us">{{ block.settings.us_text }}<small>{{ unit }}</small></span></div>
            {%- else -%}
              <div class="cmp-cell">
                {%- case block.settings.us_type -%}
                  {%- when 'cross' -%}<span class="cmp-ic no">{{ svg_cross }}</span>
                  {%- when 'text' -%}<span class="cmp-txt-yes">{{ block.settings.us_text }}</span>
                  {%- else -%}<span class="cmp-ic yes">{{ svg_check }}</span>
                {%- endcase -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="cmp-col cmp-col-them" style="order:{{ c1_order }};">
          <div class="cmp-cellhead">
            <span class="cmp-them-dot"></span>
            <span class="cmp-brand">{{ section.settings.c1_name | default: 'Leading Mix' }}</span>
            {%- if section.settings.c1_tag != blank -%}<span class="cmp-tag">{{ section.settings.c1_tag }}</span>{%- endif -%}
          </div>
          {%- for block in section.blocks -%}
            {%- if block.settings.is_price -%}
              <div class="cmp-cell cmp-price-row"><span class="cmp-price them">{{ block.settings.c1_text }}<small>{{ unit }}</small></span></div>
            {%- else -%}
              <div class="cmp-cell">
                {%- case block.settings.c1_type -%}
                  {%- when 'cross' -%}<span class="cmp-ic no">{{ svg_cross }}</span>
                  {%- when 'text' -%}<span class="cmp-txt-no">{{ block.settings.c1_text }}</span>
                  {%- else -%}<span class="cmp-ic eq">{{ svg_check }}</span>
                {%- endcase -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if three -%}
          <div class="cmp-col cmp-col-them cmp-col-them2" style="order:{{ c2_order }};">
            <div class="cmp-cellhead">
              <span class="cmp-them-dot"></span>
              <span class="cmp-brand">{{ section.settings.c2_name | default: 'Mood Blend' }}</span>
              {%- if section.settings.c2_tag != blank -%}<span class="cmp-tag">{{ section.settings.c2_tag }}</span>{%- endif -%}
            </div>
            {%- for block in section.blocks -%}
              {%- if block.settings.is_price -%}
                <div class="cmp-cell cmp-price-row"><span class="cmp-price them">{{ block.settings.c2_text }}<small>{{ unit }}</small></span></div>
              {%- else -%}
                <div class="cmp-cell">
                  {%- case block.settings.c2_type -%}
                    {%- when 'cross' -%}<span class="cmp-ic no">{{ svg_cross }}</span>
                    {%- when 'text' -%}<span class="cmp-txt-no">{{ block.settings.c2_text }}</span>
                    {%- else -%}<span class="cmp-ic eq">{{ svg_check }}</span>
                  {%- endcase -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>

    {%- if section.settings.note != blank -%}
      <p class="cmp-note">
        {%- if section.settings.note_strong != blank -%}<span class="cmp-note-strong">{{ section.settings.note_strong }}</span> {%- endif -%}
        {{ section.settings.note }} <span class="cmp-note-heart">&hearts;</span>
      </p>
    {%- endif -%}

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family={{ section.settings.font_serif | replace: " ", "+" }}:wght@300;400;500;600;700;800;900&family={{ section.settings.font_sans | replace: " ", "+" }}:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family={{ section.settings.font_display | replace: " ", "+" }}:wght@300;400;500;700&display=swap');

  #cmp-{{ section.id }} {
    /* palette */
    --cmp-navy: {{ section.settings.color_navy }};
    --cmp-rose: {{ section.settings.color_rose }};
    --cmp-stone: {{ section.settings.color_stone }};
    --cmp-mist: {{ section.settings.color_mist }};

    /* fonts */
    --cmp-serif: '{{ section.settings.font_serif }}', 'Georgia', serif;
    --cmp-sans:  '{{ section.settings.font_sans }}',  'Helvetica Neue', sans-serif;
    --cmp-display: '{{ section.settings.font_display }}', 'Georgia', serif;

    /* eyebrow */
    --cmp-ey-size:    {{ section.settings.eyebrow_size }}px;
    --cmp-ey-color:   {{ section.settings.eyebrow_color }};
    --cmp-ey-weight:  {{ section.settings.eyebrow_weight }};
    --cmp-ey-spacing: {{ section.settings.eyebrow_spacing }}px;

    /* heading */
    --cmp-h-min:    {{ section.settings.title_size_min }}px;
    --cmp-h-max:    {{ section.settings.title_size_max }}px;
    --cmp-h-color:  {{ section.settings.title_color }};
    --cmp-h-weight: {{ section.settings.title_weight }};

    /* lead */
    --cmp-lead-size:   {{ section.settings.lead_size }}px;
    --cmp-lead-color:  {{ section.settings.lead_color }};
    --cmp-lead-weight: {{ section.settings.lead_weight }};

    /* badge */
    --cmp-badge-bg:     {{ section.settings.badge_bg }};
    --cmp-badge-color:  {{ section.settings.badge_color }};
    --cmp-badge-size:   {{ section.settings.badge_size_d }}px;
    --cmp-badge-radius: {{ section.settings.badge_radius }}px;
    --cmp-badge-px:     {{ section.settings.badge_px }}px;
    --cmp-badge-py:     {{ section.settings.badge_py }}px;

    /* column header */
    --cmp-ch-h:          {{ section.settings.cellhead_h_d }}px;
    --cmp-brand-us-size: {{ section.settings.brand_us_size_d }}px;
    --cmp-brand-th-size: {{ section.settings.brand_them_size_d }}px;
    --cmp-tag-size:      {{ section.settings.tag_size_d }}px;
    --cmp-tag-color-us:  {{ section.settings.tag_color_us }};
    --cmp-tag-color-th:  {{ section.settings.tag_color_them }};
    --cmp-dot-size:      {{ section.settings.them_dot_size_d }}px;
    --cmp-dot-color:     {{ section.settings.them_dot_color }};
    --cmp-mark-h:        {{ section.settings.mark_h_d }}px;

    /* table cells */
    --cmp-cell-h:    {{ section.settings.cell_h_d }}px;
    --cmp-cell-size: {{ section.settings.cell_size_d }}px;
    --cmp-feat-size: {{ section.settings.feat_size_d }}px;
    --cmp-feat-w:    {{ section.settings.feat_weight }};
    --cmp-sub-size:  {{ section.settings.sub_size_d }}px;

    /* icons */
    --cmp-ic-size:    {{ section.settings.ic_size_d }}px;
    --cmp-ic-svg:     {{ section.settings.ic_svg_d }}px;
    --cmp-ic-yes-bg:  {{ section.settings.ic_yes_bg }};
    --cmp-ic-yes-c:   {{ section.settings.ic_yes_color }};
    --cmp-ic-no-bg:   {{ section.settings.ic_no_bg }};
    --cmp-ic-no-c:    {{ section.settings.ic_no_color }};
    --cmp-ic-eq-bg:   {{ section.settings.ic_eq_bg }};
    --cmp-ic-eq-c:    {{ section.settings.ic_eq_color }};

    /* price */
    --cmp-price-size:    {{ section.settings.price_size_d }}px;
    --cmp-price-color:   {{ section.settings.price_color }};
    --cmp-price-th-c:    {{ section.settings.price_them_color }};
    --cmp-price-sub-size:{{ section.settings.price_sub_size_d }}px;

    /* note */
    --cmp-note-size:    {{ section.settings.note_size_d }}px;
    --cmp-note-color:   {{ section.settings.note_color }};
    --cmp-note-strong-color: {{ section.settings.note_strong_color }};
    --cmp-note-heart-color:  {{ section.settings.note_heart_color }};

    /* feat-eyebrow (label column header) */
    --cmp-feat-ey-size:  {{ section.settings.feat_ey_size_d }}px;
    --cmp-feat-ey-color: {{ section.settings.feat_ey_color }};

    /* column / cell backgrounds */
    --cmp-us-col-bg:    {{ section.settings.us_col_bg }};
    --cmp-them-col-bg:  {{ section.settings.them_col_bg }};
    --cmp-them2-col-bg: {{ section.settings.them2_col_bg }};
    --cmp-price-row-bg: {{ section.settings.price_row_bg }};

    display: block; position: relative; overflow: hidden;
    padding: {{ section.settings.pad_top }}px {{ section.settings.pad_x }}px {{ section.settings.pad_bottom }}px;
    --cmp-bg:     {{ section.settings.bg_color }};
    --cmp-bg-top: {{ bg_top }};
    background: linear-gradient(180deg, var(--cmp-bg-top) 0%, var(--cmp-bg) 42%);
    color: var(--cmp-navy); font-family: var(--cmp-sans);
  }

  #cmp-{{ section.id }} * { box-sizing: border-box; }

  #cmp-{{ section.id }} .cmp-inner {
    max-width: {{ section.settings.inner_max_w }}px; margin: 0 auto; position: relative; z-index: 2;
  }

  /* ---- Head block ---- */
  #cmp-{{ section.id }} .cmp-head-block {
    text-align: {{ section.settings.head_align }}; max-width: {{ section.settings.head_max_w }}px;
    margin: 0 auto {{ section.settings.head_gap_d }}px;
  }
  #cmp-{{ section.id }} .cmp-eyebrow {
    display: block;
    font-family: var(--cmp-sans);
    font-size: var(--cmp-ey-size);
    font-weight: var(--cmp-ey-weight);
    letter-spacing: var(--cmp-ey-spacing);
    text-transform: uppercase;
    color: var(--cmp-ey-color);
    margin-bottom: {{ section.settings.eyebrow_mb }}px;
  }
  #cmp-{{ section.id }} .cmp-title {
    font-family: var(--cmp-serif);
    font-weight: var(--cmp-h-weight);
    font-size: clamp(var(--cmp-h-min), 4vw, var(--cmp-h-max));
    line-height: {{ section.settings.title_lh }}px;
    letter-spacing: {{ section.settings.title_ls }}px;
    color: var(--cmp-h-color);
    margin: 0;
  }
  #cmp-{{ section.id }} .cmp-lead {
    font-family: var(--cmp-sans);
    font-size: var(--cmp-lead-size);
    font-weight: var(--cmp-lead-weight);
    line-height: {{ section.settings.lead_lh }}px;
    color: var(--cmp-lead-color);
    margin: {{ section.settings.lead_mt }}px auto 0;
    max-width: {{ section.settings.lead_max_w }}px;
  }

  /* ---- Grid ---- */
  #cmp-{{ section.id }} .cmp-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; padding-top: 14px; }
  #cmp-{{ section.id }} .cmp-grid { display: grid; grid-template-columns: {{ grid_cols }}; align-items: start; position: relative; min-width: {{ min_w }}; }
  #cmp-{{ section.id }} .cmp-col { display: flex; flex-direction: column; border: 1.5px solid transparent; border-radius: {{ section.settings.col_radius }}px; }
  #cmp-{{ section.id }} .cmp-col-us {
    background: var(--cmp-us-col-bg);
    box-shadow: {{ section.settings.us_col_shadow }};
    border-color: {{ section.settings.us_col_border }};
    position: relative; z-index: 3;
  }
  #cmp-{{ section.id }} .cmp-col-them {
    background: var(--cmp-them-col-bg);
    border-color: var(--cmp-mist);
    margin-left: -4px;
  }
  #cmp-{{ section.id }} .cmp-col-them2 { background: var(--cmp-them2-col-bg); }

  /* ---- Column header ---- */
  #cmp-{{ section.id }} .cmp-cellhead {
    height: var(--cmp-ch-h);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 8px; padding: 22px 12px 16px; text-align: center;
  }
  #cmp-{{ section.id }} .cmp-col-feat .cmp-cellhead {
    align-items: flex-start; justify-content: flex-end; padding-left: 4px;
  }
  #cmp-{{ section.id }} .cmp-feat-eyebrow {
    font-size: var(--cmp-feat-ey-size);
    font-weight: 600; letter-spacing: .22em; text-transform: uppercase;
    color: var(--cmp-feat-ey-color);
  }

  /* ---- Badge ---- */
  #cmp-{{ section.id }} .cmp-badge {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
    background: var(--cmp-badge-bg);
    color: var(--cmp-badge-color);
    font-family: var(--cmp-sans);
    font-size: var(--cmp-badge-size);
    font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    padding: var(--cmp-badge-py) var(--cmp-badge-px);
    border-radius: var(--cmp-badge-radius);
    white-space: nowrap;
    box-shadow: 0 6px 24px rgba(0,0,0,.18);
    z-index: 4;
  }

  /* ---- Logo ---- */
  #cmp-{{ section.id }} .cmp-mark { height: var(--cmp-mark-h); width: auto; }

  /* ---- Competitor dot ---- */
  #cmp-{{ section.id }} .cmp-them-dot {
    width: var(--cmp-dot-size); height: var(--cmp-dot-size);
    border-radius: 50%; background: var(--cmp-dot-color); display: inline-block;
  }

  /* ---- Brand & tag ---- */
  #cmp-{{ section.id }} .cmp-col-us .cmp-brand {
    font-family: var(--cmp-serif); font-weight: 800;
    font-size: var(--cmp-brand-us-size); color: var(--cmp-navy); white-space: nowrap; line-height: 1.1;
  }
  #cmp-{{ section.id }} .cmp-col-them .cmp-brand {
    font-family: var(--cmp-serif); font-weight: 800;
    font-size: var(--cmp-brand-th-size); color: var(--cmp-stone); white-space: nowrap; line-height: 1.1;
  }
  #cmp-{{ section.id }} .cmp-apos { color: var(--cmp-rose); }
  #cmp-{{ section.id }} .cmp-tag {
    font-size: var(--cmp-tag-size); font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase;
  }
  #cmp-{{ section.id }} .cmp-col-us .cmp-tag   { color: var(--cmp-tag-color-us); }
  #cmp-{{ section.id }} .cmp-col-them .cmp-tag  { color: var(--cmp-tag-color-th); }

  /* ---- Table cells ---- */
  #cmp-{{ section.id }} .cmp-cell {
    height: var(--cmp-cell-h);
    display: flex; align-items: center; justify-content: center;
    padding: 0 16px; text-align: center;
    font-size: var(--cmp-cell-size);
    border-top: 1px solid rgba(27,58,92,.08);
  }
  #cmp-{{ section.id }} .cmp-col-feat .cmp-cell {
    justify-content: flex-start; text-align: left; padding-left: 4px;
    font-size: var(--cmp-feat-size); font-weight: var(--cmp-feat-w);
    color: var(--cmp-navy); flex-direction: column; align-items: flex-start; gap: 1px;
  }
  #cmp-{{ section.id }} .cmp-feat-sub {
    font-weight: 400; font-size: var(--cmp-sub-size);
    color: var(--cmp-stone); letter-spacing: 0;
  }
  #cmp-{{ section.id }} .cmp-col-them .cmp-cell {
    color: var(--cmp-stone); border-top-color: rgba(138,126,118,.16);
  }

  /* ---- Icons ---- */
  #cmp-{{ section.id }} .cmp-ic {
    width: var(--cmp-ic-size); height: var(--cmp-ic-size);
    border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
  }
  #cmp-{{ section.id }} .cmp-ic svg { width: var(--cmp-ic-svg); height: var(--cmp-ic-svg); }
  #cmp-{{ section.id }} .cmp-ic.yes { background: var(--cmp-ic-yes-bg); color: var(--cmp-ic-yes-c); }
  #cmp-{{ section.id }} .cmp-ic.eq  { background: var(--cmp-ic-eq-bg);  color: var(--cmp-ic-eq-c);  }
  #cmp-{{ section.id }} .cmp-ic.no  { background: var(--cmp-ic-no-bg);  color: var(--cmp-ic-no-c);  }
  #cmp-{{ section.id }} .cmp-txt-yes { color: var(--cmp-navy); font-weight: 600; font-size: var(--cmp-cell-size); }
  #cmp-{{ section.id }} .cmp-txt-no  { color: var(--cmp-stone); font-size: var(--cmp-cell-size); }

  /* ---- Price ---- */
  #cmp-{{ section.id }} .cmp-price {
    font-family: var(--cmp-sans); font-weight: 800;
    font-size: var(--cmp-price-size); letter-spacing: -.01em; white-space: nowrap;
  }
  #cmp-{{ section.id }} .cmp-price.us   { color: var(--cmp-price-color); }
  #cmp-{{ section.id }} .cmp-price.them { color: var(--cmp-price-th-c); font-weight: 700; }
  #cmp-{{ section.id }} .cmp-price small {
    font-weight: 500; font-size: var(--cmp-price-sub-size); opacity: .7; margin-left: 1px;
  }
  #cmp-{{ section.id }} .cmp-col-us .cmp-price-row { background: var(--cmp-price-row-bg); }

  /* ---- Note ---- */
  #cmp-{{ section.id }} .cmp-note {
    margin-top: {{ section.settings.note_mt }}px; text-align: center;
    font-family: var(--cmp-display); font-weight: 400;
    font-size: var(--cmp-note-size); line-height: 1.5; color: var(--cmp-note-color);
  }
  #cmp-{{ section.id }} .cmp-note-strong {
    font-family: var(--cmp-sans); font-weight: 700;
    font-size: {{ section.settings.note_strong_size_d }}px;
    color: var(--cmp-note-strong-color);
  }
  #cmp-{{ section.id }} .cmp-note-heart { color: var(--cmp-note-heart-color); }

  /* ---- Mobile ---- */
  @media (max-width: 860px) {
    #cmp-{{ section.id }} {
      padding: {{ section.settings.pad_top_m }}px {{ section.settings.pad_x_m }}px {{ section.settings.pad_bottom_m }}px;
      --cmp-ey-size:       {{ section.settings.eyebrow_size_m }}px;
      --cmp-h-min:         {{ section.settings.title_size_min_m }}px;
      --cmp-h-max:         {{ section.settings.title_size_min_m }}px;
      --cmp-lead-size:     {{ section.settings.lead_size_m }}px;
      --cmp-badge-size:    {{ section.settings.badge_size_m }}px;
      --cmp-ch-h:          {{ section.settings.cellhead_h_m }}px;
      --cmp-brand-us-size: {{ section.settings.brand_us_size_m }}px;
      --cmp-brand-th-size: {{ section.settings.brand_them_size_m }}px;
      --cmp-tag-size:      {{ section.settings.tag_size_m }}px;
      --cmp-dot-size:      {{ section.settings.them_dot_size_m }}px;
      --cmp-mark-h:        {{ section.settings.mark_h_m }}px;
      --cmp-cell-h:        {{ section.settings.cell_h_m }}px;
      --cmp-cell-size:     {{ section.settings.cell_size_m }}px;
      --cmp-feat-size:     {{ section.settings.feat_size_m }}px;
      --cmp-sub-size:      {{ section.settings.sub_size_m }}px;
      --cmp-ic-size:       {{ section.settings.ic_size_m }}px;
      --cmp-ic-svg:        {{ section.settings.ic_svg_m }}px;
      --cmp-price-size:    {{ section.settings.price_size_m }}px;
      --cmp-price-sub-size:{{ section.settings.price_sub_size_m }}px;
      --cmp-note-size:     {{ section.settings.note_size_m }}px;
      --cmp-feat-ey-size:  {{ section.settings.feat_ey_size_m }}px;
    }
    #cmp-{{ section.id }} .cmp-head-block { margin-bottom: {{ section.settings.head_gap_m }}px; }
    #cmp-{{ section.id }} .cmp-note-strong { font-size: {{ section.settings.note_strong_size_m }}px; }

    /* MOBILE: no inner scroll box. overflow:visible (not clip — older iOS Safari
       ignores clip and falls back to the scrolling box). The table is made to
       genuinely fit instead, so there is nothing to scroll. */
    #cmp-{{ section.id }} .cmp-scroll {
      overflow: visible;
      padding-top: 10px;
    }

    /* Only ONE competitor on mobile: label + your product + competitor 1.
       minmax(0,Xfr) lets the tracks shrink below their content's natural width. */
    #cmp-{{ section.id }} .cmp-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
      min-width: 0;
      width: 100%;
    }

    /* Hide the second competitor entirely on mobile */
    #cmp-{{ section.id }} .cmp-col-them2 { display: none !important; }

    /* Let text wrap so it never forces a column wider than its track */
    #cmp-{{ section.id }} .cmp-col-us .cmp-brand,
    #cmp-{{ section.id }} .cmp-col-them .cmp-brand,
    #cmp-{{ section.id }} .cmp-price { white-space: normal; word-break: break-word; }

    /* Tighten padding so text has room */
    #cmp-{{ section.id }} .cmp-cell { padding: 0 6px; }
    #cmp-{{ section.id }} .cmp-col-feat .cmp-cell { padding-left: 2px; }
    #cmp-{{ section.id }} .cmp-cellhead { padding: 14px 6px 10px; gap: 4px; }
  }
</style>

