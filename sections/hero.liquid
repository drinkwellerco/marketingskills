{%- assign sid = section.id | replace: '_', '-' -%}

{%- comment -%}
  Font loading: @import inside a <style> tag is re-processed every time
  Shopify re-renders the section HTML in the theme editor, unlike <script> or
  <link> tags. This means changing the font field instantly loads the new font.

  Class names deliberately avoid "heading" / "subheading" so the theme's
  [class*="heading"] CSS selector and any theme JS targeting heading classes
  cannot touch these elements. No theme typography setting controls anything here.
{%- endcomment -%}

<style>
{%- for block in section.blocks -%}
  {%- if block.settings.font_family != blank -%}
    @import url('https://fonts.googleapis.com/css2?family={{ block.settings.font_family | replace: ' ', '+' }}:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap');
  {%- endif -%}
  {%- if block.type == 'heading' and block.settings.accent_font_family != blank -%}
    @import url('https://fonts.googleapis.com/css2?family={{ block.settings.accent_font_family | replace: ' ', '+' }}:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap');
  {%- endif -%}
{%- endfor -%}
</style>

<style>
  .hero-section-{{ sid }} {
    position: relative;
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: {{ section.settings.bg_position }};
      background-repeat: no-repeat;
    {% endif %}
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
    overflow: clip;
  }

  .hero-inner-{{ sid }} {
    display: flex;
    flex-direction: {% if section.settings.image_position == 'left' %}row-reverse{% else %}row{% endif %};
    align-items: {{ section.settings.vertical_align }};
    gap: {{ section.settings.column_gap }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-text-col-{{ sid }} {
    flex: 0 0 {{ section.settings.text_column_width }}%;
    max-width: {{ section.settings.text_column_width }}%;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.block_gap }}px;
    min-width: 0;
  }

  .hero-image-col-{{ sid }} {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .hero-section-{{ sid }} {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_right }}px {{ section.settings.mobile_padding_bottom }}px {{ section.settings.mobile_padding_left }}px;
      overflow: visible;
    }
    .hero-inner-{{ sid }} {
      flex-direction: {% if section.settings.mobile_image_position == 'top' %}column-reverse{% else %}column{% endif %};
      gap: {{ section.settings.mobile_column_gap }}px;
    }
    .hero-text-col-{{ sid }},
    .hero-image-col-{{ sid }} {
      flex: 0 0 100% !important;
      max-width: 100% !important;
      width: 100%;
    }
  }

  {% for block in section.blocks %}
    {%- assign bid = block.id | replace: '_', '-' -%}

    .hero-bw-{{ bid }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
    @media (max-width: 768px) {
      .hero-bw-{{ bid }} {
        padding-top: {{ block.settings.mobile_padding_top }}px !important;
        padding-bottom: {{ block.settings.mobile_padding_bottom }}px !important;
      }
    }

    {% if block.type == 'eyebrow' %}
      .hero-eb-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.font_size }}px;
        font-weight: {{ block.settings.font_weight }} !important;
        color: {{ block.settings.color }} !important;
        text-align: {{ block.settings.text_align }};
      }
      @media (max-width: 768px) {
        .hero-eb-{{ bid }} {
          font-size: {{ block.settings.mobile_font_size }}px !important;
          text-align: {{ block.settings.mobile_text_align }} !important;
        }
      }
    {% elsif block.type == 'heading' %}
      .hero-hl-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.font_size }}px;
        font-weight: {{ block.settings.font_weight }} !important;
        color: {{ block.settings.color }} !important;
        text-align: {{ block.settings.text_align }};
      }
      .hero-ac-{{ bid }} {
        font-family: '{{ block.settings.accent_font_family }}', sans-serif !important;
        color: {{ block.settings.accent_color }} !important;
        font-style: {{ block.settings.accent_font_style }} !important;
        font-size: inherit !important;
        font-weight: inherit !important;
        line-height: inherit !important;
        letter-spacing: inherit !important;
      }
      @media (max-width: 768px) {
        .hero-hl-{{ bid }} {
          font-size: {{ block.settings.mobile_font_size }}px !important;
          line-height: {{ block.settings.mobile_line_height }} !important;
          text-align: {{ block.settings.mobile_text_align }} !important;
        }
      }
    {% elsif block.type == 'subheading' %}
      .hero-sl-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.font_size }}px;
        font-weight: {{ block.settings.font_weight }} !important;
        color: {{ block.settings.color }} !important;
        text-align: {{ block.settings.text_align }};
      }
      @media (max-width: 768px) {
        .hero-sl-{{ bid }} {
          font-size: {{ block.settings.mobile_font_size }}px !important;
          text-align: {{ block.settings.mobile_text_align }} !important;
        }
      }
    {% elsif block.type == 'description' %}
      .hero-desc-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.font_size }}px;
        font-weight: {{ block.settings.font_weight }} !important;
        color: {{ block.settings.color }} !important;
        text-align: {{ block.settings.text_align }};
        max-width: {{ block.settings.max_width }}px;
      }
      @media (max-width: 768px) {
        .hero-desc-{{ bid }} {
          font-size: {{ block.settings.mobile_font_size }}px !important;
          text-align: {{ block.settings.mobile_text_align }} !important;
          max-width: 100% !important;
        }
      }
    {% elsif block.type == 'image' %}
      .hero-imgc-{{ bid }} {
        position: relative;
        width: 100%;
      }
      .hero-imgw-{{ bid }} {
        width: 100%;
        overflow: clip;
        border-radius: {{ block.settings.border_radius }}px;
        height: {{ block.settings.height }}px;
        line-height: 0;
      }
      .hero-img-{{ bid }} {
        width: 100%; height: 100%;
        object-fit: {{ block.settings.object_fit }};
        object-position: {{ block.settings.object_position }};
        display: block;
      }
      {% if block.settings.badge_enabled %}
        {%- assign badge_ray       = block.settings.badge_size | divided_by: 2 | plus: 14 -%}
        {%- assign badge_diag      = block.settings.badge_size | divided_by: 3 | plus: 4 -%}
        {%- assign rot_total       = block.settings.badge_rotate_glow_size | times: 2 | plus: block.settings.badge_size -%}
        {%- assign rot_inner_pct   = block.settings.badge_size | times: 100 | divided_by: rot_total -%}
        {%- assign rot_inner_end   = rot_inner_pct | plus: 3 -%}

        .hero-badge-{{ bid }} {
          position: absolute;
          overflow: visible;
          width: {{ block.settings.badge_size }}px;
          height: {{ block.settings.badge_size }}px;
          border-radius: 50%;
          background-color: {{ block.settings.badge_bg_color }};
          color: {{ block.settings.badge_text_color }};
          display: flex;
          align-items: center;
          justify-content: center;
          text-align: center;
          font-family: '{{ block.settings.badge_font_family }}', sans-serif;
          font-size: {{ block.settings.badge_font_size }}px;
          font-weight: 700;
          line-height: 1.25;
          letter-spacing: 0.03em;
          text-transform: uppercase;
          padding: 10px;
          box-sizing: border-box;
          z-index: 2;
          pointer-events: none;
          user-select: none;
          {% if block.settings.badge_corner_v == 'top' %}top: {{ block.settings.badge_offset_y }}px;{% else %}bottom: {{ block.settings.badge_offset_y }}px;{% endif %}
          {% if block.settings.badge_corner_h == 'left' %}left: {{ block.settings.badge_offset_x }}px;{% else %}right: {{ block.settings.badge_offset_x }}px;{% endif %}
          /* pulse: animates box-shadow outward — always outside the element border */
          {% if block.settings.badge_effect_pulse %}
            animation: hero-pulse-{{ bid }} {{ block.settings.badge_pulse_speed }}s ease-out infinite;
          {% endif %}
          /* static box-shadow when pulse not animating it */
          {% unless block.settings.badge_effect_pulse %}
            box-shadow: inset 0 0 0 3px rgba(255,255,255,0.25){% if block.settings.badge_effect_glow %}, 0 0 {{ block.settings.badge_glow_size }}px {{ block.settings.badge_glow_size | divided_by: 2 }}px {{ block.settings.badge_glow_color }}{% endif %};
          {% endunless %}
        }

        {% if block.settings.badge_effect_pulse %}
          @keyframes hero-pulse-{{ bid }} {
            0%, 100% {
              box-shadow: inset 0 0 0 3px rgba(255,255,255,0.25){% if block.settings.badge_effect_glow %}, 0 0 {{ block.settings.badge_glow_size }}px {{ block.settings.badge_glow_size | divided_by: 2 }}px {{ block.settings.badge_glow_color }}{% endif %}, 0 0 0 0px {{ block.settings.badge_pulse_color }};
            }
            60% {
              box-shadow: inset 0 0 0 3px rgba(255,255,255,0.25){% if block.settings.badge_effect_glow %}, 0 0 {{ block.settings.badge_glow_size }}px {{ block.settings.badge_glow_size | divided_by: 2 }}px {{ block.settings.badge_glow_color }}{% endif %}, 0 0 0 {{ block.settings.badge_pulse_size }}px color-mix(in srgb, {{ block.settings.badge_pulse_color }} 0%, transparent);
            }
          }
        {% endif %}

        /* rotating glow: ::before with radial mask to punch out the badge center
           so only the outer ring is visible — no z-index trickery needed */
        {% if block.settings.badge_effect_rotate_glow %}
          .hero-badge-{{ bid }}::before {
            content: '';
            position: absolute;
            inset: -{{ block.settings.badge_rotate_glow_size }}px;
            border-radius: 50%;
            background: conic-gradient(from 0deg,
              transparent 0%,
              {{ block.settings.badge_rotate_glow_color }} 8%,
              {{ block.settings.badge_rotate_glow_color }} 65%,
              transparent 88%
            );
            animation: hero-rot-{{ bid }} {{ block.settings.badge_rotate_speed }}s linear infinite {{ block.settings.badge_rotate_dir }};
            filter: blur({{ block.settings.badge_rotate_glow_size | divided_by: 3 }}px);
            -webkit-mask: radial-gradient(circle at center, transparent 0%, transparent {{ rot_inner_pct }}%, white {{ rot_inner_end }}%, white 100%);
            mask: radial-gradient(circle at center, transparent 0%, transparent {{ rot_inner_pct }}%, white {{ rot_inner_end }}%, white 100%);
            pointer-events: none;
          }
          @keyframes hero-rot-{{ bid }} {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
          }
        {% endif %}

        /* twinkle: 8-ray starburst on ::after */
        {% if block.settings.badge_effect_shine %}
          .hero-badge-{{ bid }}::after {
            content: '';
            position: absolute;
            width: 4px;
            height: 4px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            pointer-events: none;
            animation: hero-twinkle-{{ bid }} {{ block.settings.badge_shine_speed }}s ease-in-out infinite;
          }
          @keyframes hero-twinkle-{{ bid }} {
            0%, 35%, 65%, 100% { opacity: 0; box-shadow: none; }
            50% {
              opacity: 1;
              box-shadow:
                0 -{{ badge_ray }}px 0 2px rgba(255,255,255,0.95),
                0 {{ badge_ray }}px 0 2px rgba(255,255,255,0.95),
                {{ badge_ray }}px 0 0 2px rgba(255,255,255,0.95),
                -{{ badge_ray }}px 0 0 2px rgba(255,255,255,0.95),
                {{ badge_diag }}px -{{ badge_diag }}px 0 1.5px rgba(255,255,255,0.7),
                -{{ badge_diag }}px -{{ badge_diag }}px 0 1.5px rgba(255,255,255,0.7),
                {{ badge_diag }}px {{ badge_diag }}px 0 1.5px rgba(255,255,255,0.7),
                -{{ badge_diag }}px {{ badge_diag }}px 0 1.5px rgba(255,255,255,0.7),
                0 0 12px 5px rgba(255,255,255,0.45);
            }
          }
        {% endif %}
      {% endif %}
      @media (max-width: 768px) {
        .hero-imgw-{{ bid }} {
          height: {{ block.settings.mobile_height }}px !important;
          {% if block.settings.mobile_full_width %}border-radius: 0 !important;{% endif %}
        }
      }
    {% elsif block.type == 'buttons' %}
      .hero-btns-{{ bid }} {
        display: flex;
        flex-wrap: wrap;
        gap: {{ block.settings.gap }}px;
        align-items: center;
        justify-content: {{ block.settings.align }};
      }
      .hero-btnp-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.primary_font_size }}px;
        transition: opacity 0.2s ease;
        white-space: nowrap;
      }
      .hero-btnp-{{ bid }}:hover { opacity: 0.85; }
      .hero-popup-trigger-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.popup_font_size }}px !important;
        background: none !important;
        border: none !important;
        border-bottom: 1.5px solid {{ block.settings.popup_color }} !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        outline: none !important;
        padding: 0 !important;
        margin: 0 !important;
        cursor: pointer !important;
        display: inline !important;
        line-height: 1.4 !important;
        text-decoration: none !important;
        transition: opacity 0.2s ease;
        -webkit-appearance: none !important;
        appearance: none !important;
      }
      .hero-popup-trigger-{{ bid }}:hover { opacity: 0.75; }
      .hero-popup-overlay-{{ bid }} {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.75);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 16px;
        overscroll-behavior: contain;
      }
      .hero-popup-overlay-{{ bid }}.is-open { display: flex; }
      .hero-popup-modal-{{ bid }} {
        background: {{ block.settings.modal_bg_color }};
        color: {{ block.settings.modal_text_color }};
        border-radius: 12px;
        max-width: 700px;
        width: 100%;
        max-height: 90vh;
        overflow-y: scroll;
        overscroll-behavior: contain;
        padding: 32px;
        position: relative;
        font-family: '{{ block.settings.modal_font_family }}', sans-serif;
      }
      .hero-popup-close-{{ bid }} {
        position: absolute;
        top: 16px; right: 16px;
        background: none; border: none;
        color: {{ block.settings.modal_text_color }};
        font-size: 24px; cursor: pointer;
        line-height: 1; padding: 4px 8px; opacity: 0.7;
      }
      .hero-popup-close-{{ bid }}:hover { opacity: 1; }
      .hero-popup-title-{{ bid }} {
        font-size: {{ block.settings.modal_title_size }}px;
        font-weight: 700; margin: 0 0 8px; padding-right: 48px;
        font-family: '{{ block.settings.modal_font_family }}', sans-serif;
        color: {{ block.settings.modal_text_color }};
      }
      .hero-popup-intro-{{ bid }} { font-size: 14px; opacity: 0.7; margin: 0 0 24px; line-height: 1.5; }
      .hero-popup-table-{{ bid }} { width: 100%; border-collapse: collapse; font-size: 13px; }
      .hero-popup-table-{{ bid }} th {
        text-align: left; padding: 8px 10px; font-size: 11px;
        text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.5;
        border-bottom: 1px solid rgba(255,255,255,0.12); white-space: nowrap;
      }
      .hero-popup-table-{{ bid }} td {
        padding: 12px 10px; border-bottom: 1px solid rgba(255,255,255,0.07);
        vertical-align: top; line-height: 1.45;
      }
      .hero-popup-table-{{ bid }} tr:last-child td { border-bottom: none; }
      .hero-popup-ingname-{{ bid }} { font-weight: 600; color: {{ block.settings.modal_accent_color }}; white-space: nowrap; }
      .hero-popup-yourdose-{{ bid }} { font-weight: 600; }
      @media (max-width: 768px) {
        .hero-btns-{{ bid }} { justify-content: {{ block.settings.mobile_align }}; }
        {% if block.settings.mobile_stack %}.hero-btns-{{ bid }} { flex-direction: column; align-items: {% if block.settings.mobile_align == 'center' %}center{% elsif block.settings.mobile_align == 'flex-end' %}flex-end{% else %}flex-start{% endif %}; }{% endif %}
        .hero-btnp-{{ bid }} { font-size: {{ block.settings.mobile_primary_font_size }}px !important; }
        .hero-popup-trigger-{{ bid }} { font-size: {{ block.settings.mobile_popup_font_size }}px !important; }
        .hero-popup-modal-{{ bid }} { padding: 20px 16px; }
        .hero-popup-table-{{ bid }} { font-size: 12px; }
        .hero-popup-table-{{ bid }} th, .hero-popup-table-{{ bid }} td { padding: 8px 6px; }
      }
    {% elsif block.type == 'pills' %}
      .hero-pills-{{ bid }} {
        display: flex; flex-wrap: wrap;
        gap: {{ block.settings.gap }}px; align-items: center;
        justify-content: {{ block.settings.align }};
      }
      .hero-pill-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        display: inline-flex; align-items: center; line-height: 1.2; white-space: nowrap;
      }
      {% for i in (1..5) %}
        {% assign fs_key = 'pill_' | append: i | append: '_font_size' %}
        .hero-pill-{{ i }}-{{ bid }} { font-size: {{ block.settings[fs_key] }}px; }
      {% endfor %}
      @media (max-width: 768px) {
        .hero-pills-{{ bid }} { gap: {{ block.settings.mobile_gap }}px; justify-content: {{ block.settings.mobile_align }}; }
        {% for i in (1..5) %}
          {% assign mfs_key = 'pill_' | append: i | append: '_mobile_font_size' %}
          .hero-pill-{{ i }}-{{ bid }} { font-size: {{ block.settings[mfs_key] }}px !important; }
        {% endfor %}
      }
    {% endif %}

    {% if block.type == 'quick_add_strip' %}
      {%- assign qa_flavor_blocks = section.blocks | where: 'type', 'flavor' -%}
      {%- assign qa_bid = block.id | replace: '_', '-' -%}
      {%- assign _qa_alpha = block.settings.inner_bg_opacity | times: 0.01 -%}
      {%- assign _qa_bg_rgba = block.settings.inner_bg_color | color_modify: 'alpha', _qa_alpha -%}
      .qa-sb-{{ qa_bid }} {
        --qa-navy:#1B3A5C; --qa-rose:{{ block.settings.accent_color }}; --qa-cream:#FAF5F0;
        --qa-mist:#E8DDD5;
        --qa-serif:'Playfair Display','Georgia',serif;
        --qa-display:'Cormorant Garamond','Georgia',serif;
        --qa-sans:'DM Sans','Helvetica Neue',sans-serif;
        --qa-shadow-sm:0 2px 12px rgba(27,58,92,.08);
        --qa-shadow-md:0 4px 24px rgba(27,58,92,.10);
        --qa-shadow-lg:0 8px 40px rgba(27,58,92,.12);
        display:block; overflow:clip;
        padding:{{ block.settings.section_pad_top }}px {{ block.settings.section_pad_lr }}px {{ block.settings.section_pad_bottom }}px;
        padding-top: {{ block.settings.padding_top }}px;
        padding-bottom: {{ block.settings.padding_bottom }}px;
      }
      .qa-sb-{{ qa_bid }} * { box-sizing:border-box; }
      .qa-sb-{{ qa_bid }} .qa-inner {
        max-width:1180px; margin:0 auto;
        display:grid;
        grid-template-columns:{{ block.settings.col_split }}fr {{ 100 | minus: block.settings.col_split }}fr;
        gap:{{ block.settings.col_gap }}px; align-items:center;
        padding:{{ block.settings.inner_pad }}px 32px;
        {% if block.settings.inner_min_height > 0 %}min-height:{{ block.settings.inner_min_height }}px;{% endif %}
        {% if block.settings.inner_bg_image != blank %}
          background: linear-gradient({{ _qa_bg_rgba }},{{ _qa_bg_rgba }}), url('{{ block.settings.inner_bg_image | image_url: width: 1600 }}') {{ block.settings.inner_bg_position }}/{{ block.settings.inner_bg_size }} no-repeat;
        {% else %}
          background: {{ _qa_bg_rgba }};
        {% endif %}
        border:{{ block.settings.inner_border_width }}px {{ block.settings.inner_border_style }} {{ block.settings.inner_border_color }};
        border-radius:28px; box-shadow:var(--qa-shadow-sm);
      }
      .qa-sb-{{ qa_bid }} .qa-inner.swapped .qa-copy { order:2; }
      .qa-sb-{{ qa_bid }} .qa-inner.swapped .qa-shop { order:1; }
      .qa-sb-{{ qa_bid }} .qa-eyebrow { display:inline-block; font-size:{{ block.settings.eyebrow_size }}px; font-weight:600; letter-spacing:{{ block.settings.eyebrow_ls }}px; text-transform:uppercase; color:{{ block.settings.eyebrow_color }}; margin-bottom:{{ block.settings.eyebrow_mb }}px; }
      .qa-sb-{{ qa_bid }} .qa-title { font-family:var(--qa-serif); font-weight:900; font-size:{{ block.settings.heading_size }}px; line-height:{{ block.settings.heading_lh }}%; letter-spacing:-.02em; color:{{ block.settings.heading_color }}; margin:0 0 {{ block.settings.heading_mb }}px; overflow-wrap:break-word; word-break:break-word; }
      .qa-sb-{{ qa_bid }} .qa-acc { color:{{ block.settings.heading_accent_color }}; }
      .qa-sb-{{ qa_bid }} .qa-title .qa-acc { display:block; }
      .qa-sb-{{ qa_bid }} .qa-lead { font-family:var(--qa-display); font-weight:300; font-size:{{ block.settings.lead_size }}px; letter-spacing:.02em; line-height:{{ block.settings.lead_lh }}%; color:{{ block.settings.lead_color }}; margin:0; }
      .qa-sb-{{ qa_bid }} .qa-copy { text-align:{{ block.settings.copy_align }}; }
      .qa-sb-{{ qa_bid }} .qa-swap { margin-top:18px; display:inline-flex; align-items:center; gap:7px; padding:7px 14px; border-radius:999px; background:rgba(27,58,92,.04); border:1px solid rgba(27,58,92,.18); color:var(--qa-navy); font-family:var(--qa-sans); font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; }
      .qa-sb-{{ qa_bid }} .qa-swap svg { width:14px; height:14px; }
      .qa-sb-{{ qa_bid }} .qa-shop { display:grid; grid-template-columns:repeat({{ qa_flavor_blocks.size | at_least: 1 }},1fr); gap:{{ block.settings.tile_gap }}px; align-items:start; }
      .qa-sb-{{ qa_bid }} .qa-prod { position:relative; display:flex; flex-direction:column; align-items:center; gap:7px; border:none; background:none; cursor:pointer; text-align:center; font-family:var(--qa-sans); transition:transform .18s; width:100%; max-width:{{ block.settings.tile_size }}px; margin:0 auto; }
      .qa-sb-{{ qa_bid }} .qa-prod:hover { transform:translateY(-3px); }
      .qa-sb-{{ qa_bid }} .qa-photo { position:relative; isolation:isolate; width:100%; height:var(--photo-h,auto); aspect-ratio:1/1; border-radius:var(--con-radius,18px); overflow:clip; background:var(--con-bg,transparent); display:flex; align-items:center; justify-content:center; box-shadow:var(--qa-shadow-md); transition:box-shadow .18s,outline-color .18s; outline:2px solid transparent; outline-offset:2px; }
      .qa-sb-{{ qa_bid }} .qa-prod.con-off .qa-photo { box-shadow:none; }
      .qa-sb-{{ qa_bid }} .qa-prod.in-cart .qa-photo { outline-color:var(--qa-rose); }
      .qa-sb-{{ qa_bid }} .qa-prod:hover .qa-photo { box-shadow:var(--qa-shadow-lg); }
      .qa-sb-{{ qa_bid }} .qa-img { position:absolute; top:50%; left:50%; z-index:1; width:var(--img-w,78%); height:var(--img-h,78%); object-fit:contain; filter:drop-shadow(0 6px 12px rgba(27,58,92,.20)); transform:translate(calc(-50% + var(--img-x,0px)),calc(-50% + var(--img-y,0px))); }
      .qa-sb-{{ qa_bid }} .qa-add { position:absolute; z-index:2; bottom:8px; left:50%; transform:translateX(-50%); display:inline-flex; align-items:center; padding:4px 11px; border-radius:999px; background:var(--qa-navy); color:var(--qa-cream); font-size:9px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; opacity:0; transition:opacity .18s; white-space:nowrap; }
      .qa-sb-{{ qa_bid }} .qa-prod:hover .qa-add { opacity:1; }
      .qa-sb-{{ qa_bid }} .qa-remove { position:absolute; top:-6px; left:-6px; z-index:6; width:24px; height:24px; border-radius:50%; border:none; cursor:pointer; background:#fff; color:var(--qa-navy); box-shadow:0 3px 8px rgba(0,0,0,.22); display:none; align-items:center; justify-content:center; padding:0; }
      .qa-sb-{{ qa_bid }} .qa-remove svg { width:12px; height:12px; }
      .qa-sb-{{ qa_bid }} .qa-qty { position:absolute; top:-6px; right:-6px; z-index:6; min-width:24px; height:24px; padding:0 6px; border-radius:999px; background:var(--qa-rose); color:#fff; font-size:12px; font-weight:700; display:none; align-items:center; justify-content:center; }
      .qa-sb-{{ qa_bid }} .qa-prod.in-cart .qa-remove,
      .qa-sb-{{ qa_bid }} .qa-prod.in-cart .qa-qty { display:inline-flex; }
      .qa-sb-{{ qa_bid }} .qa-brand { font-family:'{{ block.settings.brand_font }}','Playfair Display',serif; font-weight:800; font-size:{{ block.settings.brand_size }}px; line-height:1.1; color:{{ block.settings.brand_color }}; margin-bottom:-2px; }
      .qa-sb-{{ qa_bid }} .qa-apos { color:var(--qa-rose); }
      .qa-sb-{{ qa_bid }} .qa-name { font-family:'{{ block.settings.flavor_font }}','Playfair Display',serif; font-size:{{ block.settings.flavor_size }}px; font-weight:500; line-height:1.2; color:{{ block.settings.flavor_color }}; }
      .qa-sb-{{ qa_bid }} .qa-price { margin-top:-2px; display:flex; flex-direction:column; align-items:center; gap:1px; }
      .qa-sb-{{ qa_bid }} .qa-was { font-size:{{ block.settings.price_orig_size }}px; color:{{ block.settings.price_orig_color }}; text-decoration:line-through; }
      .qa-sb-{{ qa_bid }} .qa-now { font-size:{{ block.settings.price_sale_size }}px; color:{{ block.settings.price_sale_color }}; font-weight:700; }
      .qa-sb-{{ qa_bid }} .qa-prod.is-busy { opacity:.6; pointer-events:none; }
      @media (max-width:900px) {
        .qa-sb-{{ qa_bid }} { padding-left:{{ block.settings.mobile_pad_lr }}px !important; padding-right:{{ block.settings.mobile_pad_lr }}px !important; }
        .qa-sb-{{ qa_bid }} .qa-inner { grid-template-columns:1fr; gap:28px; padding:22px {{ block.settings.mobile_pad_lr }}px; }
        .qa-sb-{{ qa_bid }} .qa-inner.swapped .qa-copy { order:1; }
        .qa-sb-{{ qa_bid }} .qa-inner.swapped .qa-shop { order:2; }
        .qa-sb-{{ qa_bid }} .qa-shop { grid-template-columns:repeat(2,1fr); column-gap:{{ block.settings.mobile_col_gap }}px; row-gap:{{ block.settings.mobile_row_gap }}px; }
        .qa-sb-{{ qa_bid }} .qa-title { font-size:{{ block.settings.mobile_heading_size }}px !important; }
        .qa-sb-{{ qa_bid }} .qa-eyebrow { font-size:{{ block.settings.mobile_eyebrow_size }}px !important; }
        .qa-sb-{{ qa_bid }} .qa-lead { font-size:{{ block.settings.mobile_lead_size }}px !important; }
        .qa-sb-{{ qa_bid }} .qa-prod { max-width:{{ block.settings.mobile_tile_size }}px; }
        .qa-sb-{{ qa_bid }} .qa-photo { height:var(--m-photo-h,var(--photo-h,auto)); border-radius:var(--m-con-radius,var(--con-radius,18px)); }
        .qa-sb-{{ qa_bid }} .qa-img { width:var(--m-img-w,var(--img-w,78%)); height:var(--m-img-h,var(--img-h,78%)); transform:translate(calc(-50% + var(--m-img-x,var(--img-x,0px))),calc(-50% + var(--m-img-y,var(--img-y,0px)))); }
        .qa-sb-{{ qa_bid }} .qa-add { display:none; }
      }
    {% endif %}
  {% endfor %}
</style>

<div class="hero-section-{{ sid }}">
  <div class="hero-inner-{{ sid }}">

    <div class="hero-text-col-{{ sid }}">
      {% for block in section.blocks %}
        {%- assign bid = block.id | replace: '_', '-' -%}
        {% unless block.type == 'image' or block.type == 'flavor' or block.type == 'quick_add_strip' %}
          <div class="hero-bw-{{ bid }}" {{ block.shopify_attributes }}>
            {% case block.type %}

              {% when 'eyebrow' %}
                {% if block.settings.text != blank %}
                  <span
                    class="hero-eb-{{ bid }}"
                    style="letter-spacing:{{ block.settings.letter_spacing }}px;text-transform:{{ block.settings.text_transform }};line-height:1.4;margin:0;padding:0;display:block;"
                  >{{ block.settings.text }}</span>
                {% endif %}

              {% when 'heading' %}
                {% if block.settings.text != blank %}
                  {%- assign heading_parts = block.settings.text | split: '|' -%}
                  {%- capture heading_html -%}
                    {%- if heading_parts.size > 1 -%}
                      {{ heading_parts[0] }}<span class="hero-ac-{{ bid }}">{{ heading_parts[1] }}</span>{% if heading_parts[2] != blank %}{{ heading_parts[2] }}{% endif %}
                    {%- else -%}
                      {{ block.settings.text }}
                    {%- endif -%}
                  {%- endcapture -%}
                  <div
                    class="hero-hl-{{ bid }}"
                    style="letter-spacing:{{ block.settings.letter_spacing }}px;line-height:{{ block.settings.line_height }};word-break:break-word;overflow-wrap:break-word;margin:0;padding:0;"
                  >{{ heading_html }}</div>
                {% endif %}

              {% when 'subheading' %}
                {% if block.settings.text != blank %}
                  <div
                    class="hero-sl-{{ bid }}"
                    style="letter-spacing:{{ block.settings.letter_spacing }}px;line-height:{{ block.settings.line_height }};word-break:break-word;margin:0;padding:0;"
                  >{{ block.settings.text }}</div>
                {% endif %}

              {% when 'description' %}
                {% if block.settings.text != blank %}
                  <p
                    class="hero-desc-{{ bid }}"
                    style="line-height:{{ block.settings.line_height }};max-width:{{ block.settings.max_width }}px;margin:0;padding:0;word-break:break-word;"
                  >{{ block.settings.text }}</p>
                {% endif %}

              {% when 'buttons' %}
                <div class="hero-btns-{{ bid }}">
                  {% if block.settings.primary_text != blank %}
                    <a
                      href="{{ block.settings.primary_url }}"
                      class="hero-btnp-{{ bid }}"
                      style="font-family:'{{ block.settings.font_family }}',sans-serif;font-weight:{{ block.settings.primary_font_weight }};color:{{ block.settings.primary_text_color }};background-color:{{ block.settings.primary_bg_color }};border:{{ block.settings.primary_border_width }}px solid {{ block.settings.primary_border_color }};border-radius:{{ block.settings.primary_border_radius }}px;padding:{{ block.settings.primary_padding_y }}px {{ block.settings.primary_padding_x }}px;text-decoration:none;display:inline-block;line-height:1;white-space:nowrap;cursor:pointer;"
                      {% if block.settings.primary_new_tab %}target="_blank" rel="noopener"{% endif %}
                    >{{ block.settings.primary_text }}</a>
                  {% endif %}
                  {% if block.settings.popup_trigger_text != blank %}
                    <button
                      class="hero-popup-trigger-{{ bid }}"
                      style="font-family:'{{ block.settings.font_family }}',sans-serif;font-weight:{{ block.settings.popup_font_weight }};color:{{ block.settings.popup_color }};"
                      onclick="document.getElementById('hero-popup-{{ bid }}').classList.add('is-open')"
                      type="button"
                    >{{ block.settings.popup_trigger_text }}</button>
                    <div class="hero-popup-overlay-{{ bid }}" id="hero-popup-{{ bid }}" onclick="if(event.target===this)this.classList.remove('is-open')">
                      <div class="hero-popup-modal-{{ bid }}">
                        <button class="hero-popup-close-{{ bid }}" onclick="document.getElementById('hero-popup-{{ bid }}').classList.remove('is-open')" type="button" aria-label="Close">&#x2715;</button>
                        <p class="hero-popup-title-{{ bid }}">{{ block.settings.modal_title }}</p>
                        {% if block.settings.modal_intro != blank %}<p class="hero-popup-intro-{{ bid }}">{{ block.settings.modal_intro }}</p>{% endif %}
                        <table class="hero-popup-table-{{ bid }}">
                          <thead>
                            <tr>
                              <th>Ingredient</th>
                              <th>Our Dose</th>
                              {% if block.settings.show_clinical %}<th>Clinical Dose</th>{% endif %}
                              {% if block.settings.show_competitor %}<th>Competitor Dose</th>{% endif %}
                              <th>What It Does</th>
                            </tr>
                          </thead>
                          <tbody>
                            {% for i in (1..6) %}
                              {%- assign name_key = 'ing_' | append: i | append: '_name' -%}
                              {%- assign ing_name = block.settings[name_key] -%}
                              {% if ing_name != blank %}
                                {%- assign your_key = 'ing_' | append: i | append: '_your_dose' -%}
                                {%- assign clin_key = 'ing_' | append: i | append: '_clinical_dose' -%}
                                {%- assign comp_key = 'ing_' | append: i | append: '_competitor_dose' -%}
                                {%- assign desc_key = 'ing_' | append: i | append: '_description' -%}
                                <tr>
                                  <td class="hero-popup-ingname-{{ bid }}">{{ ing_name }}</td>
                                  <td class="hero-popup-yourdose-{{ bid }}">{{ block.settings[your_key] }}</td>
                                  {% if block.settings.show_clinical %}<td>{{ block.settings[clin_key] }}</td>{% endif %}
                                  {% if block.settings.show_competitor %}<td>{{ block.settings[comp_key] }}</td>{% endif %}
                                  <td>{{ block.settings[desc_key] }}</td>
                                </tr>
                              {% endif %}
                            {% endfor %}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  {% endif %}
                </div>


              {% when 'pills' %}
                <div class="hero-pills-{{ bid }}">
                  {% for i in (1..5) %}
                    {% assign label_key = 'pill_' | append: i | append: '_label' %}
                    {% assign label     = block.settings[label_key] %}
                    {% if label != blank %}
                      {% assign bg_key  = 'pill_' | append: i | append: '_bg' %}
                      {% assign tc_key  = 'pill_' | append: i | append: '_text_color' %}
                      {% assign bc_key  = 'pill_' | append: i | append: '_border_color' %}
                      {% assign bw_key  = 'pill_' | append: i | append: '_border_width' %}
                      {% assign br_key  = 'pill_' | append: i | append: '_border_radius' %}
                      {% assign px_key  = 'pill_' | append: i | append: '_padding_x' %}
                      {% assign py_key  = 'pill_' | append: i | append: '_padding_y' %}
                      {% assign op_key  = 'pill_' | append: i | append: '_bg_opacity' %}
                      <span
                        class="hero-pill-{{ bid }} hero-pill-{{ i }}-{{ bid }}"
                        style="font-family:'{{ block.settings.font_family }}',sans-serif;font-weight:{{ block.settings.font_weight }};background-color:color-mix(in srgb, {{ block.settings[bg_key] }} {{ block.settings[op_key] }}%, transparent);color:{{ block.settings[tc_key] }};border:{{ block.settings[bw_key] }}px solid {{ block.settings[bc_key] }};border-radius:{{ block.settings[br_key] }}px;padding:{{ block.settings[py_key] }}px {{ block.settings[px_key] }}px;"
                      >{{ label }}</span>
                    {% endif %}
                  {% endfor %}
                </div>

            {% endcase %}
          </div>
        {% endunless %}
      {% endfor %}
    </div>

    <div class="hero-image-col-{{ sid }}">
      {% for block in section.blocks %}
        {%- assign bid = block.id | replace: '_', '-' -%}
        {% if block.type == 'image' %}
          <div class="hero-bw-{{ bid }}" {{ block.shopify_attributes }}>
            <div class="hero-imgc-{{ bid }}">
              <div class="hero-imgw-{{ bid }}">
                {% if block.settings.image != blank %}
                  <img
                    class="hero-img-{{ bid }}"
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                    sizes="(max-width: 768px) 100vw, 50vw"
                    alt="{{ block.settings.image.alt | default: block.settings.alt | escape }}"
                    loading="{{ block.settings.loading }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {% else %}
                  <div class="hero-img-{{ bid }}" style="background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;height:100%;">
                    <span style="color:rgba(255,255,255,0.3);font-size:14px;">Select an image</span>
                  </div>
                {% endif %}
              </div>
              {% if block.settings.badge_enabled %}
                <div class="hero-badge-{{ bid }}">{{ block.settings.badge_text }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'quick_add_strip' -%}
      {%- assign qa_flavor_blocks = section.blocks | where: 'type', 'flavor' -%}
      {%- assign qa_bid = block.id | replace: '_', '-' -%}
      {%- assign _qa_alpha = block.settings.inner_bg_opacity | times: 0.01 -%}
      {%- assign _qa_bg_rgba = block.settings.inner_bg_color | color_modify: 'alpha', _qa_alpha -%}
      <div class="qa-sb-{{ qa_bid }}" {{ block.shopify_attributes }}>
        <div class="qa-inner{% if block.settings.products_on_left %} swapped{% endif %}" data-qa-inner="{{ qa_bid }}">
          <div class="qa-copy">
            {%- if block.settings.eyebrow != blank -%}<span class="qa-eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
            <h2 class="qa-title">
              {{ block.settings.heading_lead }}
              {%- if block.settings.heading_accent != blank -%}<span class="qa-acc">{{ block.settings.heading_accent }}</span>{%- endif -%}
            </h2>
            {%- if block.settings.lead != blank -%}<p class="qa-lead">{{ block.settings.lead }}</p>{%- endif -%}
            {%- if block.settings.show_swap -%}
              <button class="qa-swap" type="button" data-qa-swap="{{ qa_bid }}" aria-label="Swap sides">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
                {{ block.settings.swap_label | default: 'Swap sides' }}
              </button>
            {%- endif -%}
          </div>
          <div class="qa-shop" data-qa-shop="{{ qa_bid }}">
            {%- for fb in qa_flavor_blocks -%}
              {%- assign prod = fb.settings.product -%}
              {%- if prod != blank -%}
                {%- assign pv = prod.selected_or_first_available_variant | default: prod.variants.first -%}
                {%- if fb.settings.variant_title != blank -%}
                  {%- for v in prod.variants -%}
                    {%- if v.title == fb.settings.variant_title -%}{%- assign pv = v -%}{%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- assign dp = pv.price -%}
                {%- assign dc = pv.compare_at_price -%}
                {%- assign sp_str = block.settings.selling_plan_id | strip -%}
                {%- if sp_str == blank -%}{%- assign sp_str = '5713658087' -%}{%- endif -%}
                {%- for alloc in pv.selling_plan_allocations -%}
                  {%- assign a_str = alloc.selling_plan.id | append: '' -%}
                  {%- if a_str == sp_str -%}{%- assign dp = alloc.price -%}{%- assign dc = alloc.compare_at_price -%}{%- endif -%}
                {%- endfor -%}
                {%- if fb.settings.con_override -%}
                  {%- assign t_on = fb.settings.con_enabled -%}{%- assign t_c1 = fb.settings.con_color -%}{%- assign t_gr = fb.settings.con_gradient -%}{%- assign t_c2 = fb.settings.con_color2 -%}{%- assign t_ag = fb.settings.con_angle -%}
                  {%- assign t_shape = fb.settings.con_shape -%}{%- assign t_radius = fb.settings.con_radius -%}
                  {%- assign t_m_shape = fb.settings.con_mobile_shape -%}{%- assign t_m_radius = fb.settings.con_mobile_radius -%}
                  {%- assign t_ph_d = fb.settings.con_photo_h_desktop -%}{%- assign t_ph_m = fb.settings.con_photo_h_mobile -%}
                {%- else -%}
                  {%- assign t_on = block.settings.con_enabled -%}{%- assign t_c1 = block.settings.con_color -%}{%- assign t_gr = block.settings.con_gradient -%}{%- assign t_c2 = block.settings.con_color2 -%}{%- assign t_ag = block.settings.con_angle -%}
                  {%- assign t_shape = block.settings.con_shape -%}{%- assign t_radius = block.settings.con_radius -%}
                  {%- assign t_m_shape = block.settings.con_mobile_shape -%}{%- assign t_m_radius = block.settings.con_mobile_radius -%}
                  {%- assign t_ph_d = block.settings.con_photo_h_desktop -%}{%- assign t_ph_m = block.settings.con_photo_h_mobile -%}
                {%- endif -%}
                {%- if t_on -%}
                  {%- if t_gr -%}{%- assign con_bg = 'linear-gradient(' | append: t_ag | append: 'deg, ' | append: t_c1 | append: ', ' | append: t_c2 | append: ')' -%}
                  {%- else -%}{%- assign con_bg = t_c1 -%}{%- endif -%}
                {%- else -%}{%- assign con_bg = 'transparent' -%}{%- endif -%}
                {%- assign flav_raw = fb.settings.label | default: pv.title | default: prod.title -%}
                {%- assign flav_parts = flav_raw | split: '||' -%}
                {%- assign bparts = prod.title | split: "'" -%}
                {%- if t_shape == 'circle' -%}{%- assign _con_r = '50%' -%}
                {%- elsif t_shape == 'square' -%}{%- assign _con_r = '0px' -%}
                {%- else -%}{%- assign _con_r = t_radius | append: 'px' -%}{%- endif -%}
                {%- if t_m_shape == 'circle' -%}{%- assign _m_con_r = '50%' -%}
                {%- elsif t_m_shape == 'square' -%}{%- assign _m_con_r = '0px' -%}
                {%- else -%}{%- assign _m_con_r = t_m_radius | append: 'px' -%}{%- endif -%}
                {%- if t_ph_d > 0 -%}{%- assign _photo_h = t_ph_d | append: 'px' -%}{%- else -%}{%- assign _photo_h = 'auto' -%}{%- endif -%}
                {%- if t_ph_m > 0 -%}{%- assign _m_photo_h = t_ph_m | append: 'px' -%}{%- else -%}{%- assign _m_photo_h = 'auto' -%}{%- endif -%}
                <div class="qa-prod{% unless t_on %} con-off{% endunless %}"
                     {{ fb.shopify_attributes }}
                     data-qa-prod="{{ qa_bid }}"
                     data-variant-id="{{ pv.id }}"
                     role="button" tabindex="0"
                     aria-label="Add {{ flav_raw | escape }} to cart"
                     style="--con-bg:{{ con_bg }};--con-radius:{{ _con_r }};--img-w:{{ fb.settings.img_w }}%;--img-h:{{ fb.settings.img_h }}%;--img-x:{{ fb.settings.img_x }}px;--img-y:{{ fb.settings.img_y }}px;--photo-h:{{ _photo_h }};--m-con-radius:{{ _m_con_r }};--m-img-w:{{ fb.settings.mobile_img_w }}%;--m-img-h:{{ fb.settings.mobile_img_h }}%;--m-img-x:{{ fb.settings.mobile_img_x }}px;--m-img-y:{{ fb.settings.mobile_img_y }}px;--m-photo-h:{{ _m_photo_h }};">
                  <span class="qa-photo">
                    {%- if fb.settings.custom_image != blank -%}{{ fb.settings.custom_image | image_url: width: 300 | image_tag: class: 'qa-img', alt: flav_raw, loading: 'lazy' }}
                    {%- elsif pv.image -%}{{ pv.image | image_url: width: 300 | image_tag: class: 'qa-img', alt: flav_raw, loading: 'lazy' }}
                    {%- elsif prod.featured_media -%}{{ prod.featured_media | image_url: width: 300 | image_tag: class: 'qa-img', alt: flav_raw, loading: 'lazy' }}{%- endif -%}
                    <span class="qa-add">{{ block.settings.add_label | default: '+ Add' }}</span>
                  </span>
                  <button class="qa-remove" type="button" data-qa-remove aria-label="Remove"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M5 12h14"/></svg></button>
                  <span class="qa-qty" data-qa-qty>0</span>
                  <span class="qa-brand">{%- if bparts.size > 1 -%}{{ bparts[0] }}<span class="qa-apos">'</span>{{ bparts[1] }}{%- else -%}{{ prod.title }}{%- endif -%}</span>
                  <span class="qa-name">
                    {%- assign fw = flav_parts[0] | split: ' ' -%}{{ fw | join: '<br>' }}
                    {%- if flav_parts.size > 1 -%}{%- assign sw = flav_parts[1] | split: ' ' -%}<br><span class="qa-acc">{{ sw | join: '<br>' }}</span>{%- endif -%}
                  </span>
                  <span class="qa-price">
                    {%- if dc and dc > dp -%}<span class="qa-was">{{ dc | money }}</span>{%- endif -%}
                    <span class="qa-now">{{ dp | money }}</span>
                  </span>
                </div>
              {%- endif -%}
            {%- endfor -%}
            {%- if qa_flavor_blocks.size == 0 -%}
              <p style="grid-column:1/-1;text-align:center;color:#8A7E76;font-size:13px;">Add Flavor tile blocks to populate this strip.</p>
            {%- endif -%}
          </div>
        </div>
      </div>
      <script>
      (function(){
        var root=document.querySelector('[data-qa-shop="{{ qa_bid }}"]');
        if(!root) return;
        var inner=document.querySelector('[data-qa-inner="{{ qa_bid }}"]');
        var swapBtn=document.querySelector('[data-qa-swap="{{ qa_bid }}"]');
        if(swapBtn){swapBtn.addEventListener('click',function(){inner.classList.toggle('swapped');});}
        var tiles=Array.prototype.slice.call(root.querySelectorAll('[data-qa-prod="{{ qa_bid }}"]'));
        var rawSP='{{ block.settings.selling_plan_id | strip }}';
        if(rawSP==='')rawSP='5713658087';
        var spNum=null,parsed=parseInt(rawSP,10);
        if(!isNaN(parsed)&&parsed>0)spNum=parsed;
        function setTile(t,q){q=Math.max(0,q|0);t.dataset.qty=q;t.classList.toggle('in-cart',q>0);var b=t.querySelector('[data-qa-qty]');if(b)b.textContent=q;}
        function notifyTheme(cart){try{document.querySelectorAll('.cart-count-bubble span:first-child,[data-cart-count]').forEach(function(el){if(typeof cart.item_count==='number')el.textContent=cart.item_count;});document.dispatchEvent(new CustomEvent('qa:cart-updated',{detail:cart,bubbles:true}));if(window.Shopify&&Shopify.onCartUpdate)Shopify.onCartUpdate(cart);}catch(e){}}
        function refreshCounts(){fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(function(cart){var counts={},keys={};(cart.items||[]).forEach(function(it){counts[it.variant_id]=(counts[it.variant_id]||0)+it.quantity;keys[it.variant_id]=it.key;});tiles.forEach(function(t){var vid=parseInt(t.dataset.variantId,10);setTile(t,counts[vid]||0);if(keys[vid])t.dataset.lineKey=keys[vid];});notifyTheme(cart);}).catch(function(e){console.warn('qa error',e);});}
        function addOne(t){var id=t.dataset.variantId;if(!id)return;var prev=parseInt(t.dataset.qty,10)||0;setTile(t,prev+1);t.classList.add('is-busy');var item={id:parseInt(id,10),quantity:1};if(spNum!==null)item.selling_plan=spNum;fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[item]})}).then(function(r){if(!r.ok){return r.json().then(function(e){throw e;});}return r.json();}).then(function(){refreshCounts();}).catch(function(err){console.error('[QA] add failed',err);setTile(t,prev);}).then(function(){t.classList.remove('is-busy');});}
        function removeOne(t){var cur=parseInt(t.dataset.qty,10)||0;if(cur<=0)return;setTile(t,cur-1);t.classList.add('is-busy');var lid=t.dataset.lineKey||t.dataset.variantId;fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:lid,quantity:cur-1})}).then(function(r){if(!r.ok)return r.json().then(function(e){throw e;});return r.json();}).then(function(){refreshCounts();}).catch(function(err){console.error('[QA] remove failed',err);setTile(t,cur);}).then(function(){t.classList.remove('is-busy');});}
        tiles.forEach(function(t){t.addEventListener('click',function(){addOne(t);});t.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();addOne(t);}});var rm=t.querySelector('[data-qa-remove]');if(rm){rm.addEventListener('click',function(e){e.stopPropagation();removeOne(t);});}});
        refreshCounts();
      })();
      </script>
    {%- endif -%}
  {%- endfor -%}

</div>

