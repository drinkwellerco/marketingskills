{%- assign sid = section.id | replace: '_', '-' -%}

{%- comment -%}
  Font loading: @import inside a <style> tag is re-processed every time
  Shopify re-renders the section HTML in the theme editor, unlike <script> or
  <link> tags. This means changing the font field instantly loads the new font.

  Class names deliberately avoid "heading" / "subheading" so the theme's
  [class*="heading"] CSS selector and any theme JS targeting heading classes
  cannot touch these elements. No theme typography setting controls anything here.
{%- endcomment -%}

<style>
{%- for block in section.blocks -%}
  {%- if block.settings.font_family != blank -%}
    @import url('https://fonts.googleapis.com/css2?family={{ block.settings.font_family | replace: ' ', '+' }}:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap');
  {%- endif -%}
  {%- if block.type == 'heading' and block.settings.accent_font_family != blank -%}
    @import url('https://fonts.googleapis.com/css2?family={{ block.settings.accent_font_family | replace: ' ', '+' }}:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap');
  {%- endif -%}
{%- endfor -%}
</style>

<style>
  .hero-section-{{ sid }} {
    position: relative;
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: {{ section.settings.bg_position }};
      background-repeat: no-repeat;
    {% endif %}
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
    overflow: hidden;
  }

  .hero-inner-{{ sid }} {
    display: flex;
    flex-direction: {% if section.settings.image_position == 'left' %}row-reverse{% else %}row{% endif %};
    align-items: {{ section.settings.vertical_align }};
    gap: {{ section.settings.column_gap }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-text-col-{{ sid }} {
    flex: 0 0 {{ section.settings.text_column_width }}%;
    max-width: {{ section.settings.text_column_width }}%;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.block_gap }}px;
    min-width: 0;
  }

  .hero-image-col-{{ sid }} {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .hero-section-{{ sid }} {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_right }}px {{ section.settings.mobile_padding_bottom }}px {{ section.settings.mobile_padding_left }}px;
      overflow: visible;
    }
    .hero-inner-{{ sid }} {
      flex-direction: {% if section.settings.mobile_image_position == 'top' %}column-reverse{% else %}column{% endif %};
      gap: {{ section.settings.mobile_column_gap }}px;
    }
    .hero-text-col-{{ sid }},
    .hero-image-col-{{ sid }} {
      flex: 0 0 100% !important;
      max-width: 100% !important;
      width: 100%;
    }
  }

  {% for block in section.blocks %}
    {%- assign bid = block.id | replace: '_', '-' -%}

    .hero-bw-{{ bid }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
    @media (max-width: 768px) {
      .hero-bw-{{ bid }} {
        padding-top: {{ block.settings.mobile_padding_top }}px !important;
        padding-bottom: {{ block.settings.mobile_padding_bottom }}px !important;
      }
    }

    {% if block.type == 'eyebrow' %}
      .hero-eb-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.font_size }}px;
        font-weight: {{ block.settings.font_weight }} !important;
        color: {{ block.settings.color }} !important;
        text-align: {{ block.settings.text_align }};
      }
      @media (max-width: 768px) {
        .hero-eb-{{ bid }} {
          font-size: {{ block.settings.mobile_font_size }}px !important;
          text-align: {{ block.settings.mobile_text_align }} !important;
        }
      }
    {% elsif block.type == 'heading' %}
      .hero-hl-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.font_size }}px;
        font-weight: {{ block.settings.font_weight }} !important;
        color: {{ block.settings.color }} !important;
        text-align: {{ block.settings.text_align }};
      }
      .hero-ac-{{ bid }} {
        font-family: '{{ block.settings.accent_font_family }}', sans-serif !important;
        color: {{ block.settings.accent_color }} !important;
        font-style: {{ block.settings.accent_font_style }} !important;
        font-size: inherit !important;
        font-weight: inherit !important;
        line-height: inherit !important;
        letter-spacing: inherit !important;
      }
      @media (max-width: 768px) {
        .hero-hl-{{ bid }} {
          font-size: {{ block.settings.mobile_font_size }}px !important;
          line-height: {{ block.settings.mobile_line_height }} !important;
          text-align: {{ block.settings.mobile_text_align }} !important;
        }
      }
    {% elsif block.type == 'subheading' %}
      .hero-sl-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.font_size }}px;
        font-weight: {{ block.settings.font_weight }} !important;
        color: {{ block.settings.color }} !important;
        text-align: {{ block.settings.text_align }};
      }
      @media (max-width: 768px) {
        .hero-sl-{{ bid }} {
          font-size: {{ block.settings.mobile_font_size }}px !important;
          text-align: {{ block.settings.mobile_text_align }} !important;
        }
      }
    {% elsif block.type == 'description' %}
      .hero-desc-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.font_size }}px;
        font-weight: {{ block.settings.font_weight }} !important;
        color: {{ block.settings.color }} !important;
        text-align: {{ block.settings.text_align }};
        max-width: {{ block.settings.max_width }}px;
      }
      @media (max-width: 768px) {
        .hero-desc-{{ bid }} {
          font-size: {{ block.settings.mobile_font_size }}px !important;
          text-align: {{ block.settings.mobile_text_align }} !important;
          max-width: 100% !important;
        }
      }
    {% elsif block.type == 'image' %}
      .hero-imgc-{{ bid }} {
        position: relative;
        width: 100%;
      }
      .hero-imgw-{{ bid }} {
        width: 100%;
        overflow: hidden;
        border-radius: {{ block.settings.border_radius }}px;
        height: {{ block.settings.height }}px;
        line-height: 0;
      }
      .hero-img-{{ bid }} {
        width: 100%; height: 100%;
        object-fit: {{ block.settings.object_fit }};
        object-position: {{ block.settings.object_position }};
        display: block;
      }
      {% if block.settings.badge_enabled %}
        {%- assign badge_ray       = block.settings.badge_size | divided_by: 2 | plus: 14 -%}
        {%- assign badge_diag      = block.settings.badge_size | divided_by: 3 | plus: 4 -%}
        {%- assign rot_total       = block.settings.badge_rotate_glow_size | times: 2 | plus: block.settings.badge_size -%}
        {%- assign rot_inner_pct   = block.settings.badge_size | times: 100 | divided_by: rot_total -%}
        {%- assign rot_inner_end   = rot_inner_pct | plus: 3 -%}

        .hero-badge-{{ bid }} {
          position: absolute;
          overflow: visible;
          width: {{ block.settings.badge_size }}px;
          height: {{ block.settings.badge_size }}px;
          border-radius: 50%;
          background-color: {{ block.settings.badge_bg_color }};
          color: {{ block.settings.badge_text_color }};
          display: flex;
          align-items: center;
          justify-content: center;
          text-align: center;
          font-family: '{{ block.settings.badge_font_family }}', sans-serif;
          font-size: {{ block.settings.badge_font_size }}px;
          font-weight: 700;
          line-height: 1.25;
          letter-spacing: 0.03em;
          text-transform: uppercase;
          padding: 10px;
          box-sizing: border-box;
          z-index: 2;
          pointer-events: none;
          user-select: none;
          {% if block.settings.badge_corner_v == 'top' %}top: {{ block.settings.badge_offset_y }}px;{% else %}bottom: {{ block.settings.badge_offset_y }}px;{% endif %}
          {% if block.settings.badge_corner_h == 'left' %}left: {{ block.settings.badge_offset_x }}px;{% else %}right: {{ block.settings.badge_offset_x }}px;{% endif %}
          /* pulse: animates box-shadow outward — always outside the element border */
          {% if block.settings.badge_effect_pulse %}
            animation: hero-pulse-{{ bid }} {{ block.settings.badge_pulse_speed }}s ease-out infinite;
          {% endif %}
          /* static box-shadow when pulse not animating it */
          {% unless block.settings.badge_effect_pulse %}
            box-shadow: inset 0 0 0 3px rgba(255,255,255,0.25){% if block.settings.badge_effect_glow %}, 0 0 {{ block.settings.badge_glow_size }}px {{ block.settings.badge_glow_size | divided_by: 2 }}px {{ block.settings.badge_glow_color }}{% endif %};
          {% endunless %}
        }

        {% if block.settings.badge_effect_pulse %}
          @keyframes hero-pulse-{{ bid }} {
            0%, 100% {
              box-shadow: inset 0 0 0 3px rgba(255,255,255,0.25){% if block.settings.badge_effect_glow %}, 0 0 {{ block.settings.badge_glow_size }}px {{ block.settings.badge_glow_size | divided_by: 2 }}px {{ block.settings.badge_glow_color }}{% endif %}, 0 0 0 0px {{ block.settings.badge_pulse_color }};
            }
            60% {
              box-shadow: inset 0 0 0 3px rgba(255,255,255,0.25){% if block.settings.badge_effect_glow %}, 0 0 {{ block.settings.badge_glow_size }}px {{ block.settings.badge_glow_size | divided_by: 2 }}px {{ block.settings.badge_glow_color }}{% endif %}, 0 0 0 {{ block.settings.badge_pulse_size }}px color-mix(in srgb, {{ block.settings.badge_pulse_color }} 0%, transparent);
            }
          }
        {% endif %}

        /* rotating glow: ::before with radial mask to punch out the badge center
           so only the outer ring is visible — no z-index trickery needed */
        {% if block.settings.badge_effect_rotate_glow %}
          .hero-badge-{{ bid }}::before {
            content: '';
            position: absolute;
            inset: -{{ block.settings.badge_rotate_glow_size }}px;
            border-radius: 50%;
            background: conic-gradient(from 0deg,
              transparent 0%,
              {{ block.settings.badge_rotate_glow_color }} 8%,
              {{ block.settings.badge_rotate_glow_color }} 65%,
              transparent 88%
            );
            animation: hero-rot-{{ bid }} {{ block.settings.badge_rotate_speed }}s linear infinite {{ block.settings.badge_rotate_dir }};
            filter: blur({{ block.settings.badge_rotate_glow_size | divided_by: 3 }}px);
            -webkit-mask: radial-gradient(circle at center, transparent 0%, transparent {{ rot_inner_pct }}%, white {{ rot_inner_end }}%, white 100%);
            mask: radial-gradient(circle at center, transparent 0%, transparent {{ rot_inner_pct }}%, white {{ rot_inner_end }}%, white 100%);
            pointer-events: none;
          }
          @keyframes hero-rot-{{ bid }} {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
          }
        {% endif %}

        /* twinkle: 8-ray starburst on ::after */
        {% if block.settings.badge_effect_shine %}
          .hero-badge-{{ bid }}::after {
            content: '';
            position: absolute;
            width: 4px;
            height: 4px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            pointer-events: none;
            animation: hero-twinkle-{{ bid }} {{ block.settings.badge_shine_speed }}s ease-in-out infinite;
          }
          @keyframes hero-twinkle-{{ bid }} {
            0%, 35%, 65%, 100% { opacity: 0; box-shadow: none; }
            50% {
              opacity: 1;
              box-shadow:
                0 -{{ badge_ray }}px 0 2px rgba(255,255,255,0.95),
                0 {{ badge_ray }}px 0 2px rgba(255,255,255,0.95),
                {{ badge_ray }}px 0 0 2px rgba(255,255,255,0.95),
                -{{ badge_ray }}px 0 0 2px rgba(255,255,255,0.95),
                {{ badge_diag }}px -{{ badge_diag }}px 0 1.5px rgba(255,255,255,0.7),
                -{{ badge_diag }}px -{{ badge_diag }}px 0 1.5px rgba(255,255,255,0.7),
                {{ badge_diag }}px {{ badge_diag }}px 0 1.5px rgba(255,255,255,0.7),
                -{{ badge_diag }}px {{ badge_diag }}px 0 1.5px rgba(255,255,255,0.7),
                0 0 12px 5px rgba(255,255,255,0.45);
            }
          }
        {% endif %}
      {% endif %}
      @media (max-width: 768px) {
        .hero-imgw-{{ bid }} {
          height: {{ block.settings.mobile_height }}px !important;
          {% if block.settings.mobile_full_width %}border-radius: 0 !important;{% endif %}
        }
      }
    {% elsif block.type == 'buttons' %}
      .hero-btns-{{ bid }} {
        display: flex;
        flex-wrap: wrap;
        gap: {{ block.settings.gap }}px;
        align-items: center;
      }
      .hero-btnp-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.primary_font_size }}px;
        transition: opacity 0.2s ease;
        white-space: nowrap;
      }
      .hero-btnp-{{ bid }}:hover { opacity: 0.85; }
      .hero-popup-trigger-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        font-size: {{ block.settings.popup_font_size }}px !important;
        background: none !important;
        border: none !important;
        border-bottom: 1.5px solid {{ block.settings.popup_color }} !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        outline: none !important;
        padding: 0 !important;
        margin: 0 !important;
        cursor: pointer !important;
        display: inline !important;
        line-height: 1.4 !important;
        text-decoration: none !important;
        transition: opacity 0.2s ease;
        -webkit-appearance: none !important;
        appearance: none !important;
      }
      .hero-popup-trigger-{{ bid }}:hover { opacity: 0.75; }
      .hero-popup-overlay-{{ bid }} {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.75);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 16px;
      }
      .hero-popup-overlay-{{ bid }}.is-open { display: flex; }
      .hero-popup-modal-{{ bid }} {
        background: {{ block.settings.modal_bg_color }};
        color: {{ block.settings.modal_text_color }};
        border-radius: 12px;
        max-width: 700px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        padding: 32px;
        position: relative;
        font-family: '{{ block.settings.modal_font_family }}', sans-serif;
      }
      .hero-popup-close-{{ bid }} {
        position: absolute;
        top: 16px; right: 16px;
        background: none; border: none;
        color: {{ block.settings.modal_text_color }};
        font-size: 24px; cursor: pointer;
        line-height: 1; padding: 4px 8px; opacity: 0.7;
      }
      .hero-popup-close-{{ bid }}:hover { opacity: 1; }
      .hero-popup-title-{{ bid }} {
        font-size: {{ block.settings.modal_title_size }}px;
        font-weight: 700; margin: 0 0 8px; padding-right: 48px;
        font-family: '{{ block.settings.modal_font_family }}', sans-serif;
        color: {{ block.settings.modal_text_color }};
      }
      .hero-popup-intro-{{ bid }} { font-size: 14px; opacity: 0.7; margin: 0 0 24px; line-height: 1.5; }
      .hero-popup-table-{{ bid }} { width: 100%; border-collapse: collapse; font-size: 13px; }
      .hero-popup-table-{{ bid }} th {
        text-align: left; padding: 8px 10px; font-size: 11px;
        text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.5;
        border-bottom: 1px solid rgba(255,255,255,0.12); white-space: nowrap;
      }
      .hero-popup-table-{{ bid }} td {
        padding: 12px 10px; border-bottom: 1px solid rgba(255,255,255,0.07);
        vertical-align: top; line-height: 1.45;
      }
      .hero-popup-table-{{ bid }} tr:last-child td { border-bottom: none; }
      .hero-popup-ingname-{{ bid }} { font-weight: 600; color: {{ block.settings.modal_accent_color }}; white-space: nowrap; }
      .hero-popup-yourdose-{{ bid }} { font-weight: 600; }
      @media (max-width: 768px) {
        {% if block.settings.mobile_stack %}.hero-btns-{{ bid }} { flex-direction: column; align-items: flex-start; }{% endif %}
        .hero-btnp-{{ bid }} { font-size: {{ block.settings.mobile_primary_font_size }}px !important; }
        .hero-popup-trigger-{{ bid }} { font-size: {{ block.settings.mobile_popup_font_size }}px !important; }
        .hero-popup-modal-{{ bid }} { padding: 20px 16px; }
        .hero-popup-table-{{ bid }} { font-size: 12px; }
        .hero-popup-table-{{ bid }} th, .hero-popup-table-{{ bid }} td { padding: 8px 6px; }
      }
    {% elsif block.type == 'pills' %}
      .hero-pills-{{ bid }} {
        display: flex; flex-wrap: wrap;
        gap: {{ block.settings.gap }}px; align-items: center;
      }
      .hero-pill-{{ bid }} {
        font-family: '{{ block.settings.font_family }}', sans-serif !important;
        display: inline-flex; align-items: center; line-height: 1.2; white-space: nowrap;
      }
      {% for i in (1..5) %}
        {% assign fs_key = 'pill_' | append: i | append: '_font_size' %}
        .hero-pill-{{ i }}-{{ bid }} { font-size: {{ block.settings[fs_key] }}px; }
      {% endfor %}
      @media (max-width: 768px) {
        .hero-pills-{{ bid }} { gap: {{ block.settings.mobile_gap }}px; }
        {% for i in (1..5) %}
          {% assign mfs_key = 'pill_' | append: i | append: '_mobile_font_size' %}
          .hero-pill-{{ i }}-{{ bid }} { font-size: {{ block.settings[mfs_key] }}px !important; }
        {% endfor %}
      }
    {% endif %}
  {% endfor %}
</style>

<div class="hero-section-{{ sid }}">
  <div class="hero-inner-{{ sid }}">

    <div class="hero-text-col-{{ sid }}">
      {% for block in section.blocks %}
        {%- assign bid = block.id | replace: '_', '-' -%}
        {% unless block.type == 'image' or block.type == 'flavor' %}
          <div class="hero-bw-{{ bid }}" {{ block.shopify_attributes }}>
            {% case block.type %}

              {% when 'eyebrow' %}
                {% if block.settings.text != blank %}
                  <span
                    class="hero-eb-{{ bid }}"
                    style="letter-spacing:{{ block.settings.letter_spacing }}px;text-transform:{{ block.settings.text_transform }};line-height:1.4;margin:0;padding:0;display:block;"
                  >{{ block.settings.text }}</span>
                {% endif %}

              {% when 'heading' %}
                {% if block.settings.text != blank %}
                  {%- assign heading_parts = block.settings.text | split: '|' -%}
                  {%- capture heading_html -%}
                    {%- if heading_parts.size > 1 -%}
                      {{ heading_parts[0] }}<span class="hero-ac-{{ bid }}">{{ heading_parts[1] }}</span>{% if heading_parts[2] != blank %}{{ heading_parts[2] }}{% endif %}
                    {%- else -%}
                      {{ block.settings.text }}
                    {%- endif -%}
                  {%- endcapture -%}
                  <div
                    class="hero-hl-{{ bid }}"
                    style="letter-spacing:{{ block.settings.letter_spacing }}px;line-height:{{ block.settings.line_height }};word-break:break-word;overflow-wrap:break-word;margin:0;padding:0;"
                  >{{ heading_html }}</div>
                {% endif %}

              {% when 'subheading' %}
                {% if block.settings.text != blank %}
                  <div
                    class="hero-sl-{{ bid }}"
                    style="letter-spacing:{{ block.settings.letter_spacing }}px;line-height:{{ block.settings.line_height }};word-break:break-word;margin:0;padding:0;"
                  >{{ block.settings.text }}</div>
                {% endif %}

              {% when 'description' %}
                {% if block.settings.text != blank %}
                  <p
                    class="hero-desc-{{ bid }}"
                    style="line-height:{{ block.settings.line_height }};max-width:{{ block.settings.max_width }}px;margin:0;padding:0;word-break:break-word;"
                  >{{ block.settings.text }}</p>
                {% endif %}

              {% when 'buttons' %}
                <div class="hero-btns-{{ bid }}">
                  {% if block.settings.primary_text != blank %}
                    <a
                      href="{{ block.settings.primary_url }}"
                      class="hero-btnp-{{ bid }}"
                      style="font-family:'{{ block.settings.font_family }}',sans-serif;font-weight:{{ block.settings.primary_font_weight }};color:{{ block.settings.primary_text_color }};background-color:{{ block.settings.primary_bg_color }};border:{{ block.settings.primary_border_width }}px solid {{ block.settings.primary_border_color }};border-radius:{{ block.settings.primary_border_radius }}px;padding:{{ block.settings.primary_padding_y }}px {{ block.settings.primary_padding_x }}px;text-decoration:none;display:inline-block;line-height:1;white-space:nowrap;cursor:pointer;"
                      {% if block.settings.primary_new_tab %}target="_blank" rel="noopener"{% endif %}
                    >{{ block.settings.primary_text }}</a>
                  {% endif %}
                  {% if block.settings.popup_trigger_text != blank %}
                    <button
                      class="hero-popup-trigger-{{ bid }}"
                      style="font-family:'{{ block.settings.font_family }}',sans-serif;font-weight:{{ block.settings.popup_font_weight }};color:{{ block.settings.popup_color }};"
                      onclick="document.getElementById('hero-popup-{{ bid }}').classList.add('is-open')"
                      type="button"
                    >{{ block.settings.popup_trigger_text }}</button>
                    <div class="hero-popup-overlay-{{ bid }}" id="hero-popup-{{ bid }}" onclick="if(event.target===this)this.classList.remove('is-open')">
                      <div class="hero-popup-modal-{{ bid }}">
                        <button class="hero-popup-close-{{ bid }}" onclick="document.getElementById('hero-popup-{{ bid }}').classList.remove('is-open')" type="button" aria-label="Close">&#x2715;</button>
                        <p class="hero-popup-title-{{ bid }}">{{ block.settings.modal_title }}</p>
                        {% if block.settings.modal_intro != blank %}<p class="hero-popup-intro-{{ bid }}">{{ block.settings.modal_intro }}</p>{% endif %}
                        <table class="hero-popup-table-{{ bid }}">
                          <thead>
                            <tr>
                              <th>Ingredient</th>
                              <th>Our Dose</th>
                              {% if block.settings.show_clinical %}<th>Clinical Dose</th>{% endif %}
                              {% if block.settings.show_competitor %}<th>Competitor Dose</th>{% endif %}
                              <th>What It Does</th>
                            </tr>
                          </thead>
                          <tbody>
                            {% for i in (1..6) %}
                              {%- assign name_key = 'ing_' | append: i | append: '_name' -%}
                              {%- assign ing_name = block.settings[name_key] -%}
                              {% if ing_name != blank %}
                                {%- assign your_key = 'ing_' | append: i | append: '_your_dose' -%}
                                {%- assign clin_key = 'ing_' | append: i | append: '_clinical_dose' -%}
                                {%- assign comp_key = 'ing_' | append: i | append: '_competitor_dose' -%}
                                {%- assign desc_key = 'ing_' | append: i | append: '_description' -%}
                                <tr>
                                  <td class="hero-popup-ingname-{{ bid }}">{{ ing_name }}</td>
                                  <td class="hero-popup-yourdose-{{ bid }}">{{ block.settings[your_key] }}</td>
                                  {% if block.settings.show_clinical %}<td>{{ block.settings[clin_key] }}</td>{% endif %}
                                  {% if block.settings.show_competitor %}<td>{{ block.settings[comp_key] }}</td>{% endif %}
                                  <td>{{ block.settings[desc_key] }}</td>
                                </tr>
                              {% endif %}
                            {% endfor %}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  {% endif %}
                </div>

              {% when 'pills' %}
                <div class="hero-pills-{{ bid }}">
                  {% for i in (1..5) %}
                    {% assign label_key = 'pill_' | append: i | append: '_label' %}
                    {% assign label     = block.settings[label_key] %}
                    {% if label != blank %}
                      {% assign bg_key  = 'pill_' | append: i | append: '_bg' %}
                      {% assign tc_key  = 'pill_' | append: i | append: '_text_color' %}
                      {% assign bc_key  = 'pill_' | append: i | append: '_border_color' %}
                      {% assign bw_key  = 'pill_' | append: i | append: '_border_width' %}
                      {% assign br_key  = 'pill_' | append: i | append: '_border_radius' %}
                      {% assign px_key  = 'pill_' | append: i | append: '_padding_x' %}
                      {% assign py_key  = 'pill_' | append: i | append: '_padding_y' %}
                      {% assign op_key  = 'pill_' | append: i | append: '_bg_opacity' %}
                      <span
                        class="hero-pill-{{ bid }} hero-pill-{{ i }}-{{ bid }}"
                        style="font-family:'{{ block.settings.font_family }}',sans-serif;font-weight:{{ block.settings.font_weight }};background-color:color-mix(in srgb, {{ block.settings[bg_key] }} {{ block.settings[op_key] }}%, transparent);color:{{ block.settings[tc_key] }};border:{{ block.settings[bw_key] }}px solid {{ block.settings[bc_key] }};border-radius:{{ block.settings[br_key] }}px;padding:{{ block.settings[py_key] }}px {{ block.settings[px_key] }}px;"
                      >{{ label }}</span>
                    {% endif %}
                  {% endfor %}
                </div>

            {% endcase %}
          </div>
        {% endunless %}
      {% endfor %}
    </div>

    <div class="hero-image-col-{{ sid }}">
      {% for block in section.blocks %}
        {%- assign bid = block.id | replace: '_', '-' -%}
        {% if block.type == 'image' %}
          <div class="hero-bw-{{ bid }}" {{ block.shopify_attributes }}>
            <div class="hero-imgc-{{ bid }}">
              <div class="hero-imgw-{{ bid }}">
                {% if block.settings.image != blank %}
                  <img
                    class="hero-img-{{ bid }}"
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                    sizes="(max-width: 768px) 100vw, 50vw"
                    alt="{{ block.settings.image.alt | default: block.settings.alt | escape }}"
                    loading="{{ block.settings.loading }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {% else %}
                  <div class="hero-img-{{ bid }}" style="background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;height:100%;">
                    <span style="color:rgba(255,255,255,0.3);font-size:14px;">Select an image</span>
                  </div>
                {% endif %}
              </div>
              {% if block.settings.badge_enabled %}
                <div class="hero-badge-{{ bid }}">{{ block.settings.badge_text }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>

  {%- comment -%} ============ QUICK-ADD STRIP ============ {%- endcomment -%}
  {%- if section.settings.qa_enabled -%}
    {%- assign qa_flavor_blocks = section.blocks | where: 'type', 'flavor' -%}
    {%- assign qa_inner_alpha = section.settings.qa_inner_bg_opacity | times: 0.01 -%}
    {%- assign qa_inner_bg_rgba = section.settings.qa_inner_bg_color | color_modify: 'alpha', qa_inner_alpha -%}

    <div id="qa-strip-{{ section.id }}" class="qa" data-section-id="{{ section.id }}">
      <div class="qa-inner{% if section.settings.qa_products_on_left %} swapped{% endif %}" data-qa-inner>

        <div class="qa-copy">
          {%- if section.settings.qa_eyebrow != blank -%}
            <span class="qa-eyebrow">{{ section.settings.qa_eyebrow }}</span>
          {%- endif -%}
          <h2 class="qa-title">
            {{ section.settings.qa_heading_lead }}
            {%- if section.settings.qa_heading_accent != blank -%}
              <span class="qa-accent">{{ section.settings.qa_heading_accent }}</span>
            {%- endif -%}
          </h2>
          {%- if section.settings.qa_lead != blank -%}
            <p class="qa-lead">{{ section.settings.qa_lead }}</p>
          {%- endif -%}
          {%- if section.settings.qa_show_swap -%}
            <button class="qa-swap" type="button" data-qa-swap aria-label="Swap sides">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
              {{ section.settings.qa_swap_label | default: 'Swap sides' }}
            </button>
          {%- endif -%}
        </div>

        <div class="qa-shop" data-qa-shop>
          {%- for block in qa_flavor_blocks -%}
            {%- assign prod = block.settings.product -%}
            {%- if prod != blank -%}
              {%- assign pv = prod.selected_or_first_available_variant | default: prod.variants.first -%}
              {%- if block.settings.variant_title != blank -%}
                {%- for v in prod.variants -%}
                  {%- if v.title == block.settings.variant_title -%}{%- assign pv = v -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- assign display_price   = pv.price -%}
              {%- assign display_compare = pv.compare_at_price -%}
              {%- assign sp_id_str = section.settings.qa_selling_plan_id | strip -%}
              {%- if sp_id_str == blank -%}{%- assign sp_id_str = '5713658087' -%}{%- endif -%}
              {%- for alloc in pv.selling_plan_allocations -%}
                {%- assign alloc_id_str = alloc.selling_plan.id | append: '' -%}
                {%- if alloc_id_str == sp_id_str -%}
                  {%- assign display_price   = alloc.price -%}
                  {%- assign display_compare = alloc.compare_at_price -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if block.settings.con_override -%}
                {%- assign tile_con_enabled = block.settings.con_enabled -%}
                {%- assign tile_color1      = block.settings.con_color -%}
                {%- assign tile_grad        = block.settings.con_gradient -%}
                {%- assign tile_color2      = block.settings.con_color2 -%}
                {%- assign tile_angle       = block.settings.con_angle -%}
              {%- else -%}
                {%- assign tile_con_enabled = section.settings.qa_con_enabled -%}
                {%- assign tile_color1      = section.settings.qa_con_color -%}
                {%- assign tile_grad        = section.settings.qa_con_gradient -%}
                {%- assign tile_color2      = section.settings.qa_con_color2 -%}
                {%- assign tile_angle       = section.settings.qa_con_angle -%}
              {%- endif -%}
              {%- if tile_con_enabled -%}
                {%- if tile_grad -%}
                  {%- assign con_bg = 'linear-gradient(' | append: tile_angle | append: 'deg, ' | append: tile_color1 | append: ', ' | append: tile_color2 | append: ')' -%}
                {%- else -%}
                  {%- assign con_bg = tile_color1 -%}
                {%- endif -%}
              {%- else -%}
                {%- assign con_bg = 'transparent' -%}
              {%- endif -%}
              {%- assign flavor_raw   = block.settings.label | default: pv.title | default: prod.title -%}
              {%- assign flavor_parts = flavor_raw | split: '||' -%}
              {%- assign brand_parts  = prod.title | split: "'" -%}

              <div class="qa-prod{% unless tile_con_enabled %} con-off{% endunless %}"
                   {{ block.shopify_attributes }}
                   data-qa-prod
                   data-variant-id="{{ pv.id }}"
                   data-product-url="{{ prod.url }}"
                   role="button" tabindex="0"
                   aria-label="Add {{ flavor_raw | escape }} to cart"
                   style="--con-bg:{{ con_bg }};--con-radius:{{ block.settings.img_radius }}px;--con-size:{{ block.settings.img_size }}%;--img-x:{{ block.settings.img_x }}px;--img-y:{{ block.settings.img_y }}px;">
                <span class="qa-photo">
                  {%- if block.settings.custom_image != blank -%}
                    {{ block.settings.custom_image | image_url: width: 300 | image_tag: class: 'qa-img', alt: flavor_raw, loading: 'lazy' }}
                  {%- elsif pv.image -%}
                    {{ pv.image | image_url: width: 300 | image_tag: class: 'qa-img', alt: flavor_raw, loading: 'lazy' }}
                  {%- elsif prod.featured_media -%}
                    {{ prod.featured_media | image_url: width: 300 | image_tag: class: 'qa-img', alt: flavor_raw, loading: 'lazy' }}
                  {%- elsif section.settings.qa_mark_image != blank -%}
                    {{ section.settings.qa_mark_image | image_url: width: 240 | image_tag: class: 'qa-mark', alt: '' }}
                  {%- endif -%}
                  <button class="qa-remove" type="button" data-qa-remove aria-label="Remove one {{ flavor_raw | escape }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M5 12h14"/></svg>
                  </button>
                  <span class="qa-qty" data-qa-qty>0</span>
                  <span class="qa-add">{{ section.settings.qa_add_label | default: '+ Add' }}</span>
                </span>
                <span class="qa-brand">
                  {%- if brand_parts.size > 1 -%}
                    {{ brand_parts[0] }}<span class="qa-apos">'</span>{{ brand_parts[1] }}
                  {%- else -%}
                    {{ prod.title }}
                  {%- endif -%}
                </span>
                <span class="qa-name">
                  {%- assign fp0_words = flavor_parts[0] | split: ' ' -%}
                  {{ fp0_words | join: '<br>' }}
                  {%- if flavor_parts.size > 1 -%}
                    {%- assign fp1_words = flavor_parts[1] | split: ' ' -%}
                    <br><span class="qa-accent">{{ fp1_words | join: '<br>' }}</span>
                  {%- endif -%}
                </span>
                <span class="qa-price">
                  {%- if display_compare and display_compare > display_price -%}
                    <span class="qa-was">{{ display_compare | money }}</span>
                  {%- endif -%}
                  <span class="qa-now">{{ display_price | money }}</span>
                </span>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if qa_flavor_blocks.size == 0 -%}
            <p style="grid-column:1/-1;text-align:center;color:#8A7E76;font-size:13px;">Add "Flavor tile" blocks in the theme editor to populate this strip.</p>
          {%- endif -%}
        </div>

      </div>
    </div>

    <style>
      #qa-strip-{{ section.id }}{
        --qa-navy:#1B3A5C; --qa-rose:{{ section.settings.qa_accent_color }}; --qa-cream:#FAF5F0;
        --qa-mist:#E8DDD5; --qa-stone:#8A7E76;
        --qa-serif:'Playfair Display','Georgia',serif;
        --qa-display:'Cormorant Garamond','Georgia',serif;
        --qa-sans:'DM Sans','Helvetica Neue',sans-serif;
        --qa-shadow-sm:0 2px 12px rgba(27,58,92,.08);
        --qa-shadow-md:0 4px 24px rgba(27,58,92,.10);
        --qa-shadow-lg:0 8px 40px rgba(27,58,92,.12);
        background:{{ section.settings.qa_bg_color }}; color:var(--qa-navy);
        font-family:var(--qa-sans); display:block; overflow-x:clip;
        padding:{{ section.settings.qa_section_pad_top }}px {{ section.settings.qa_section_pad_lr }}px {{ section.settings.qa_section_pad_bottom }}px;
      }
      #qa-strip-{{ section.id }} *{ box-sizing:border-box; }
      #qa-strip-{{ section.id }} .qa-inner{
        max-width:1180px; margin:0 auto;
        display:grid; grid-template-columns:{{ section.settings.qa_col_split }}fr {{ 100 | minus: section.settings.qa_col_split }}fr; gap:{{ section.settings.qa_col_gap }}px; align-items:center;
        padding:{{ section.settings.qa_inner_pad }}px 32px;
        {%- if section.settings.qa_inner_min_height > 0 %} min-height:{{ section.settings.qa_inner_min_height }}px;{%- endif %}
        {%- if section.settings.qa_inner_bg_image != blank -%}
          background: linear-gradient({{ qa_inner_bg_rgba }},{{ qa_inner_bg_rgba }}), url('{{ section.settings.qa_inner_bg_image | image_url: width: 1600 }}') {{ section.settings.qa_inner_bg_position }}/{{ section.settings.qa_inner_bg_size }} no-repeat;
        {%- else -%}
          background: {{ qa_inner_bg_rgba }};
        {%- endif -%}
        border:{{ section.settings.qa_inner_border_width }}px {{ section.settings.qa_inner_border_style }} {{ section.settings.qa_inner_border_color }}; border-radius:28px;
        box-shadow:var(--qa-shadow-sm);
      }
      #qa-strip-{{ section.id }} .qa-inner.swapped .qa-copy{ order:2; }
      #qa-strip-{{ section.id }} .qa-inner.swapped .qa-shop{ order:1; }
      #qa-strip-{{ section.id }} .qa-eyebrow{ display:inline-block; font-size:{{ section.settings.qa_eyebrow_size }}px; font-weight:600; letter-spacing:{{ section.settings.qa_eyebrow_ls }}px; text-transform:uppercase; color:{{ section.settings.qa_eyebrow_color }}; margin-bottom:{{ section.settings.qa_eyebrow_mb }}px; }
      #qa-strip-{{ section.id }} .qa-title{ font-family:var(--qa-serif); font-weight:900; font-size:{{ section.settings.qa_heading_size }}px; line-height:{{ section.settings.qa_heading_lh }}%; letter-spacing:-.02em; color:{{ section.settings.qa_heading_color }}; margin:0 0 {{ section.settings.qa_heading_mb }}px; overflow-wrap:break-word; word-break:break-word; }
      #qa-strip-{{ section.id }} .qa-accent{ color:{{ section.settings.qa_heading_accent_color }}; }
      #qa-strip-{{ section.id }} .qa-title .qa-accent{ display:block; }
      #qa-strip-{{ section.id }} .qa-lead{ font-family:var(--qa-display); font-weight:300; font-size:{{ section.settings.qa_lead_size }}px; letter-spacing:.02em; line-height:{{ section.settings.qa_lead_lh }}%; color:{{ section.settings.qa_lead_color }}; margin:0; }
      #qa-strip-{{ section.id }} .qa-swap{ margin-top:18px; display:inline-flex; align-items:center; gap:7px; padding:7px 14px; border-radius:999px; background:rgba(27,58,92,.04); border:1px solid rgba(27,58,92,.18); color:var(--qa-navy); font-family:var(--qa-sans); font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; transition:background .15s,border-color .15s,color .15s; }
      #qa-strip-{{ section.id }} .qa-swap:hover{ background:rgba(232,96,122,.12); border-color:var(--qa-rose); color:var(--qa-rose); }
      #qa-strip-{{ section.id }} .qa-swap svg{ width:14px; height:14px; }
      #qa-strip-{{ section.id }} .qa-shop{ display:grid; grid-template-columns:repeat({{ qa_flavor_blocks.size | at_least: 1 }},1fr); gap:{{ section.settings.qa_tile_gap }}px; align-items:start; }
      #qa-strip-{{ section.id }} .qa-prod{ position:relative; display:flex; flex-direction:column; align-items:center; gap:7px; padding:0; border:none; background:none; cursor:pointer; text-align:center; font-family:var(--qa-sans); transition:transform .18s; width:100%; max-width:{{ section.settings.qa_tile_size }}px; margin:0 auto; }
      #qa-strip-{{ section.id }} .qa-prod:hover{ transform:translateY(-3px); }
      #qa-strip-{{ section.id }} .qa-photo{ position:relative; width:100%; aspect-ratio:1/1; border-radius:var(--con-radius,18px); overflow:hidden; background:var(--con-bg,transparent); display:flex; align-items:center; justify-content:center; box-shadow:var(--qa-shadow-md); transition:box-shadow .18s,outline-color .18s; outline:2px solid transparent; outline-offset:2px; }
      #qa-strip-{{ section.id }} .qa-prod.con-off .qa-photo{ box-shadow:none; }
      #qa-strip-{{ section.id }} .qa-prod.in-cart .qa-photo{ outline-color:var(--qa-rose); }
      #qa-strip-{{ section.id }} .qa-prod:hover .qa-photo{ box-shadow:var(--qa-shadow-lg); }
      #qa-strip-{{ section.id }} .qa-prod.con-off:hover .qa-photo{ box-shadow:none; }
      #qa-strip-{{ section.id }} .qa-img{ position:relative; z-index:1; width:var(--con-size,78%); height:var(--con-size,78%); object-fit:contain; filter:drop-shadow(0 6px 12px rgba(27,58,92,.20)); transform:translateX(var(--img-x,0px)) translateY(var(--img-y,0px)); }
      #qa-strip-{{ section.id }} .qa-mark{ position:relative; z-index:1; width:58%; height:auto; filter:drop-shadow(0 4px 8px rgba(27,58,92,.18)); }
      #qa-strip-{{ section.id }} .qa-add{ position:absolute; z-index:2; bottom:8px; left:50%; transform:translateX(-50%); display:inline-flex; align-items:center; gap:4px; padding:4px 11px; border-radius:999px; background:var(--qa-navy); color:var(--qa-cream); font-size:9px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; opacity:0; transition:opacity .18s; white-space:nowrap; }
      #qa-strip-{{ section.id }} .qa-prod:hover .qa-add{ opacity:1; }
      #qa-strip-{{ section.id }} .qa-remove{ position:absolute; top:7px; left:7px; z-index:4; width:24px; height:24px; border-radius:50%; border:none; cursor:pointer; background:#fff; color:var(--qa-navy); box-shadow:0 3px 8px rgba(0,0,0,.22); display:none; align-items:center; justify-content:center; font-size:16px; line-height:1; padding:0; }
      #qa-strip-{{ section.id }} .qa-remove svg{ width:12px; height:12px; }
      #qa-strip-{{ section.id }} .qa-remove:hover{ background:var(--qa-navy); color:#fff; }
      #qa-strip-{{ section.id }} .qa-qty{ position:absolute; top:7px; right:7px; z-index:4; min-width:24px; height:24px; padding:0 6px; border-radius:999px; background:var(--qa-rose); color:#fff; font-size:12px; font-weight:700; display:none; align-items:center; justify-content:center; box-shadow:0 3px 8px rgba(232,96,122,.4); }
      #qa-strip-{{ section.id }} .qa-prod.in-cart .qa-remove,
      #qa-strip-{{ section.id }} .qa-prod.in-cart .qa-qty{ display:inline-flex; }
      #qa-strip-{{ section.id }} .qa-brand{ font-family:'{{ section.settings.qa_brand_font }}','Playfair Display','Georgia',serif; font-weight:800; font-size:{{ section.settings.qa_brand_size }}px; line-height:1.1; color:{{ section.settings.qa_brand_color }}; margin-bottom:-2px; }
      #qa-strip-{{ section.id }} .qa-apos{ color:var(--qa-rose); }
      #qa-strip-{{ section.id }} .qa-name{ font-family:'{{ section.settings.qa_flavor_font }}','Playfair Display','Georgia',serif; font-size:{{ section.settings.qa_flavor_size }}px; font-weight:500; line-height:1.2; color:{{ section.settings.qa_flavor_color }}; }
      #qa-strip-{{ section.id }} .qa-price{ margin-top:-2px; display:flex; flex-direction:column; align-items:center; gap:1px; }
      #qa-strip-{{ section.id }} .qa-was{ font-family:'{{ section.settings.qa_price_orig_font }}','Playfair Display','Georgia',serif; font-size:{{ section.settings.qa_price_orig_size }}px; color:{{ section.settings.qa_price_orig_color }}; text-decoration:line-through; }
      #qa-strip-{{ section.id }} .qa-now{ font-family:'{{ section.settings.qa_price_sale_font }}','Playfair Display','Georgia',serif; font-size:{{ section.settings.qa_price_sale_size }}px; color:{{ section.settings.qa_price_sale_color }}; font-weight:700; }
      #qa-strip-{{ section.id }} .qa-prod.is-busy{ opacity:.6; pointer-events:none; }
      #qa-strip-{{ section.id }} .qa-copy{ text-align:{{ section.settings.qa_copy_align }}; }
      @media (max-width:900px){
        #qa-strip-{{ section.id }}{ padding:{{ section.settings.qa_section_pad_top }}px {{ section.settings.qa_mobile_pad_lr }}px {{ section.settings.qa_section_pad_bottom }}px; }
        #qa-strip-{{ section.id }} .qa-inner{ width:100%; max-width:100%; box-sizing:border-box; grid-template-columns:1fr; gap:28px; padding:22px {{ section.settings.qa_mobile_pad_lr }}px; }
        #qa-strip-{{ section.id }} .qa-inner.swapped .qa-copy{ order:1; }
        #qa-strip-{{ section.id }} .qa-inner.swapped .qa-shop{ order:2; }
        #qa-strip-{{ section.id }} .qa-shop{ grid-template-columns:repeat(2,1fr); column-gap:{{ section.settings.qa_mobile_col_gap }}px; row-gap:{{ section.settings.qa_mobile_row_gap }}px; }
        #qa-strip-{{ section.id }} .qa-title{ font-size:{{ section.settings.qa_mobile_heading_size }}px; }
        #qa-strip-{{ section.id }} .qa-eyebrow{ font-size:{{ section.settings.qa_mobile_eyebrow_size }}px; }
        #qa-strip-{{ section.id }} .qa-lead{ font-size:{{ section.settings.qa_mobile_lead_size }}px; }
        #qa-strip-{{ section.id }} .qa-prod{ max-width:{{ section.settings.qa_mobile_tile_size }}px; }
        #qa-strip-{{ section.id }} .qa-add{ display:none; }
      }
    </style>

    <script>
    (function(){
      var root = document.getElementById('qa-strip-{{ section.id }}');
      if(!root) return;
      var inner = root.querySelector('[data-qa-inner]');
      var swapBtn = root.querySelector('[data-qa-swap]');
      if(swapBtn){ swapBtn.addEventListener('click', function(){ inner.classList.toggle('swapped'); }); }
      var tiles = Array.prototype.slice.call(root.querySelectorAll('[data-qa-prod]'));
      var rawSP = '{{ section.settings.qa_selling_plan_id | strip }}';
      if(rawSP === '') rawSP = '5713658087';
      var spNum = null;
      var parsed = parseInt(rawSP, 10);
      if(!isNaN(parsed) && parsed > 0) spNum = parsed;
      function setTile(tile, qty){
        qty = Math.max(0, qty|0);
        tile.dataset.qty = qty;
        tile.classList.toggle('in-cart', qty > 0);
        var b = tile.querySelector('[data-qa-qty]');
        if(b) b.textContent = qty;
      }
      function notifyTheme(cart){
        try {
          document.querySelectorAll('.cart-count-bubble span:first-child, [data-cart-count]').forEach(function(el){
            if(typeof cart.item_count === 'number') el.textContent = cart.item_count;
          });
          document.dispatchEvent(new CustomEvent('qa:cart-updated', { detail: cart, bubbles: true }));
          if(window.Shopify && Shopify.onCartUpdate) Shopify.onCartUpdate(cart);
        } catch(e){}
      }
      function refreshCounts(){
        fetch('/cart.js', { headers: { 'Accept':'application/json' } })
          .then(function(r){ return r.json(); })
          .then(function(cart){
            var counts = {}, lineKeys = {};
            (cart.items || []).forEach(function(it){
              counts[it.variant_id] = (counts[it.variant_id]||0) + it.quantity;
              lineKeys[it.variant_id] = it.key;
            });
            tiles.forEach(function(t){
              var vid = parseInt(t.dataset.variantId, 10);
              setTile(t, counts[vid] || 0);
              if(lineKeys[vid]) t.dataset.lineKey = lineKeys[vid];
            });
            notifyTheme(cart);
          })
          .catch(function(e){ console.warn('qa refreshCounts error', e); });
      }
      function addOne(tile){
        var id = tile.dataset.variantId;
        if(!id) return;
        var prevQty = parseInt(tile.dataset.qty, 10) || 0;
        setTile(tile, prevQty + 1);
        tile.classList.add('is-busy');
        var item = { id: parseInt(id, 10), quantity: 1 };
        if(spNum !== null) item.selling_plan = spNum;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
          body: JSON.stringify({ items: [item] })
        })
        .then(function(r){
          if(!r.ok){ return r.json().then(function(e){ throw e; }); }
          return r.json();
        })
        .then(function(){ refreshCounts(); })
        .catch(function(err){ console.error('[QA] add failed', err); setTile(tile, prevQty); })
        .then(function(){ tile.classList.remove('is-busy'); });
      }
      function removeOne(tile){
        var current = parseInt(tile.dataset.qty, 10) || 0;
        if(current <= 0) return;
        setTile(tile, current - 1);
        tile.classList.add('is-busy');
        var lineId = tile.dataset.lineKey || tile.dataset.variantId;
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
          body: JSON.stringify({ id: lineId, quantity: current - 1 })
        })
        .then(function(r){
          if(!r.ok) return r.json().then(function(e){ throw e; });
          return r.json();
        })
        .then(function(){ refreshCounts(); })
        .catch(function(err){ console.error('[QA] remove failed', err); setTile(tile, current); })
        .then(function(){ tile.classList.remove('is-busy'); });
      }
      tiles.forEach(function(tile){
        tile.addEventListener('click', function(){ addOne(tile); });
        tile.addEventListener('keydown', function(e){
          if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); addOne(tile); }
        });
        var rm = tile.querySelector('[data-qa-remove]');
        if(rm){ rm.addEventListener('click', function(e){ e.stopPropagation(); removeOne(tile); }); }
      });
      refreshCounts();
    })();
    </script>
  {%- endif -%}

