{%- comment -%}
  ============================================================
  WELLER CO. — Shop Page · Drink Mix Feature Card
  ------------------------------------------------------------
  One configurable drink-mix card. Per section instance you can:
    • pick the PRODUCT
    • add FLAVOR blocks (the variants you want shown) and reorder them
    • choose THEME  -> Light (cream) or Dark (navy)
    • choose LAYOUT -> Image left or Image right
  Clicking a flavor selects it; the "View product" button links to
  the product page with that variant pre-selected (?variant=…).
  Add the section twice (e.g. Her'dration light/left, Pro'dration
  dark/right) to recreate the full lineup.
  Namespaced under #sdm-{{ section.id }}.
  ============================================================
{%- endcomment -%}

{%- assign p = section.settings.product | default: product -%}
{%- assign sym = section.settings.currency_symbol | default: '$' -%}
{%- assign theme = section.settings.theme -%}
{%- assign orient = section.settings.orientation -%}

{%- comment -%} Resolve Subscribe & Save pricing from first selling plan {%- endcomment -%}
{%- assign sub_price = blank -%}
{%- assign sub_save_pct = 0 -%}
{%- if p != blank and p.selling_plan_groups.size > 0 -%}
  {%- assign sp_first = p.selling_plan_groups.first.selling_plans.first -%}
  {%- if sp_first != blank -%}
    {%- assign sp_adj = sp_first.price_adjustments.first -%}
    {%- if sp_adj != blank -%}
      {%- if sp_adj.value_type == 'percentage' -%}
        {%- assign sub_save_pct = sp_adj.value -%}
        {%- assign sp_remaining = 100 | minus: sub_save_pct -%}
        {%- assign sub_price = p.price | times: sp_remaining | divided_by: 100 -%}
      {%- elsif sp_adj.value_type == 'fixed_amount' -%}
        {%- assign sub_price = p.price | minus: sp_adj.value -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- assign disp_name = section.settings.product_name -%}
{%- if disp_name == blank and p != blank -%}{%- assign disp_name = p.title -%}{%- endif -%}
{%- capture apos_span -%}<span class="sdm-apos">’</span>{%- endcapture -%}
{%- assign name_html = disp_name | replace: "’", apos_span | replace: "’", apos_span -%}

{%- assign hero_img = section.settings.hero_image -%}
{%- if hero_img == blank and p != blank -%}{%- assign hero_img = p.featured_image -%}{%- endif -%}

{%- assign flavor_count = 0 -%}
{%- for block in section.blocks -%}{%- if block.type == 'flavor' -%}{%- assign flavor_count = flavor_count | plus: 1 -%}{%- endif -%}{%- endfor -%}

<section
  id="sdm-{{ section.id }}"
  class="sdm sdm--{{ theme }} sdm--img-{{ orient }}"
  data-product-url="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}"
  {{ section.shopify_attributes }}>

  {%- if p == blank and hero_img == blank -%}
    <div class="sdm-empty">Select a product in the section settings.</div>
  {%- else -%}

  <article class="sdm-card">

    <div class="sdm-visual">
      {%- if section.settings.show_blobs -%}
        <span class="sdm-blob sdm-blob1"></span>
        <span class="sdm-blob sdm-blob2"></span>
        <span class="sdm-blob sdm-blob3"></span>
      {%- endif -%}
      {%- if hero_img != blank -%}
        <img class="sdm-hero{% if section.settings.hero_contain %} sdm-hero--logo{% endif %}"
             src="{{ hero_img | image_url: width: 700 }}"
             alt="{{ disp_name | escape }}" width="700" height="700" loading="lazy">
      {%- endif -%}
    </div>

    <div class="sdm-body">
      {%- if section.settings.show_flag and section.settings.flag_text != blank -%}
        <span class="sdm-flag">{{ section.settings.flag_text }}</span>
      {%- endif -%}
      {%- if section.settings.wordmark != blank -%}
        <div class="sdm-wordmark">{{ section.settings.wordmark }}</div>
      {%- endif -%}
      <h3 class="sdm-name">{{ name_html }}</h3>
      {%- if section.settings.tagline != blank -%}
        <div class="sdm-tag">{{ section.settings.tagline }}</div>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="sdm-desc">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- comment -%} ---- benefit pills ---- {%- endcomment -%}
      {%- assign pill_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'pill' -%}{%- assign pill_count = pill_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if pill_count > 0 -%}
        <div class="sdm-pills">
          {%- for block in section.blocks -%}{%- if block.type == 'pill' -%}
            <span class="sdm-pill" style="--pill:{{ block.settings.color }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
          {%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ---- flavor variants ---- {%- endcomment -%}
      {%- if flavor_count > 0 -%}
        <div class="sdm-flavor-pick">
          <div class="sdm-flavor-label">
            <span class="sdm-lab">{{ section.settings.flavor_heading }}</span>
            <span class="sdm-chosen" data-chosen></span>
          </div>
          <div class="sdm-swatch-row" data-swatches>
            {%- for block in section.blocks -%}{%- if block.type == 'flavor' -%}
              <button type="button" class="sdm-swatch"
                      data-variant="{{ block.settings.variant_id }}"
                      data-name="{{ block.settings.name | escape }}"
                      style="--sc:{{ block.settings.color }};--fi-size:{{ block.settings.img_size | default: 70 }}%;--fi-x:{{ block.settings.img_x | default: 50 }}%;--fi-y:{{ block.settings.img_y | default: 50 }}%"
                      aria-label="{{ block.settings.name | escape }}"
                      {{ block.shopify_attributes }}>
                <span class="sdm-disc">
                  <span class="sdm-sblob"></span>
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 200 }}" alt="" width="200" height="200" loading="lazy">
                  {%- endif -%}
                </span>
                <span class="sdm-swatch-name">{{ block.settings.name }}</span>
              </button>
            {%- endif -%}{%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="sdm-buy">
        <div class="sdm-price">
          {%- if section.settings.price_label != blank -%}
            <span class="sdm-from">{{ section.settings.price_label }}</span>
          {%- endif -%}
          <span class="sdm-price-row">
            {%- if p != blank -%}
              {%- if sub_price != blank -%}
                <span class="sdm-was">{{ p.price | money }}</span>
                <span class="sdm-now">{{ sub_price | money }}</span>
                <span class="sdm-free-ship">+ Free Shipping Always</span>
              {%- else -%}
                <span class="sdm-now">{{ p.price | money }}</span>
                {%- if p.compare_at_price > p.price -%}
                  <span class="sdm-was">{{ p.compare_at_price | money }}</span>
                {%- endif -%}
              {%- endif -%}
            {%- else -%}
              <span class="sdm-now">{{ sym }}0.00</span>
            {%- endif -%}
          </span>
        </div>
        <a class="sdm-btn" data-view href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}">
          {{ section.settings.view_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>
      </div>
    </div>

  </article>
  {%- endif -%}
</section>

<style>
  #sdm-{{ section.id }}{
    /* Brand palette */
    --blush:#F2C4CE; --peach:#E8A87C; --sage:#8A9B6E; --sky:#4A90B8;
    --navy:#1B3A5C; --cream:#FAF5F0; --cream-dk:#F0E8E0;
    --lime:#7DB642; --fog:#F5EEE8; --mist:#E8DDD5; --stone:#8A7E76;
    --serif:'Playfair Display','Georgia',serif;
    --display:'Cormorant Garamond','Georgia',serif;
    --script:'Dancing Script',cursive;
    --sans:'DM Sans','Helvetica Neue',sans-serif;
    --shadow-md:0 4px 24px rgba(27,58,92,.10);
    --shadow-rose:0 6px 24px rgba(232,96,122,.28);

    /* Schema-controlled tokens */
    --rose:{{ section.settings.color_rose | default: '#E8607A' }};
    --card-bg:{{ section.settings.color_card_bg | default: '#ffffff' }};
    --visual-bg:{{ section.settings.color_visual_bg | default: '#FAF5F0' }};
    --txt:{{ section.settings.color_txt | default: '#1B3A5C' }};
    --txt-muted:{{ section.settings.color_txt_muted | default: '#8A7E76' }};
    --wordmark:{{ section.settings.color_txt_muted | default: '#8A7E76' }};
    --disc-bg:{{ section.settings.color_visual_bg | default: '#FAF5F0' }};
    --swname:{{ section.settings.color_txt_muted | default: '#8A7E76' }};
    --swname-on:{{ section.settings.color_txt | default: '#1B3A5C' }};
    --flag-bg:{{ section.settings.color_flag_bg | default: '#1B3A5C' }};
    --flag-txt:{{ section.settings.color_flag_txt | default: '#FAF5F0' }};

    /* Size tokens */
    --sz-wordmark:{{ section.settings.size_wordmark | default: 13 }}px;
    --sz-name-d:{{ section.settings.size_name | default: 38 }}px;
    --sz-name-m:{{ section.settings.size_name_mobile | default: 30 }}px;
    --sz-tagline:{{ section.settings.size_tagline | default: 17 }}px;
    --sz-desc:{{ section.settings.size_desc | default: 14 }}px;
    --sz-pill:{{ section.settings.size_pill | default: 10 }}px;
    --sz-flavor-lab:{{ section.settings.size_flavor_lab | default: 11 }}px;
    --sz-flavor-chosen:{{ section.settings.size_flavor_chosen | default: 22 }}px;
    --sz-swatch-name:{{ section.settings.size_swatch_name | default: 10 }}px;
    --sz-sub-save:{{ section.settings.size_sub_save | default: 16 }}px;
    --sz-price-was:{{ section.settings.size_price_was | default: 26 }}px;
    --sz-price-now:{{ section.settings.size_price_now | default: 26 }}px;
    --sz-free-ship:{{ section.settings.size_free_ship | default: 12 }}px;
    --sz-btn:{{ section.settings.size_btn | default: 13 }}px;

    /* Spacing tokens */
    --mt-wordmark:{{ section.settings.pad_top_wordmark | default: 0 }}px;
    --mb-wordmark:{{ section.settings.pad_bot_wordmark | default: 6 }}px;
    --mt-name:{{ section.settings.pad_top_name | default: 0 }}px;
    --mb-name:{{ section.settings.pad_bot_name | default: 0 }}px;
    --mt-tagline:{{ section.settings.pad_top_tagline | default: 7 }}px;
    --mb-tagline:{{ section.settings.pad_bot_tagline | default: 4 }}px;
    --mt-desc:{{ section.settings.pad_top_desc | default: 12 }}px;
    --mb-desc:{{ section.settings.pad_bot_desc | default: 0 }}px;
    --mt-pills:{{ section.settings.pad_top_pills | default: 18 }}px;
    --mb-pills:{{ section.settings.pad_bot_pills | default: 0 }}px;
    --mt-flavor:{{ section.settings.pad_top_flavor | default: 20 }}px;
    --mb-flavor-lab:{{ section.settings.pad_bot_flavor_lab | default: 16 }}px;
    --mt-buy:{{ section.settings.pad_top_buy | default: 22 }}px;
    --mb-sub-save:{{ section.settings.pad_bot_sub_save | default: 4 }}px;

    /* Layout tokens */
    --img-col:{{ section.settings.img_col_pct | default: 45 }}%;
    --hero-w:{{ section.settings.hero_size | default: 70 }}%;
    --hero-max:{{ section.settings.hero_max_w | default: 250 }}px;
    --hero-radius:{{ section.settings.hero_radius | default: 0 }}px;
    --hero-va:{{ section.settings.hero_valign | default: 'center' }};
    --hero-ha:{{ section.settings.hero_halign | default: 'center' }};
    --sw-size:{{ section.settings.swatch_size | default: 64 }}px;
    --body-pad:{{ section.settings.body_pad | default: 34 }}px;
    --visual-min-h:{{ section.settings.visual_min_h | default: 280 }}px;

    display:block; font-family:var(--sans); color:var(--txt);
    max-width:1180px; margin:0 auto;
    padding:{{ section.settings.section_pad_top | default: 16 }}px 16px {{ section.settings.section_pad_bottom | default: 16 }}px;
  }
  #sdm-{{ section.id }}.sdm--dark{
    --card-bg:{{ section.settings.color_dark_card_bg | default: '#1B3A5C' }};
    --visual-bg:{{ section.settings.color_dark_visual_bg | default: '#16324f' }};
    --txt:{{ section.settings.color_dark_txt | default: '#FAF5F0' }};
    --txt-muted:rgba(250,245,240,.62);
    --wordmark:rgba(250,245,240,.55);
    --disc-bg:rgba(255,255,255,.06);
    --swname:rgba(250,245,240,.55);
    --swname-on:{{ section.settings.color_dark_txt | default: '#FAF5F0' }};
  }
  #sdm-{{ section.id }} *{ box-sizing:border-box; }

  #sdm-{{ section.id }} .sdm-empty{ padding:48px; text-align:center; color:var(--stone); background:var(--fog); border-radius:24px; }

  #sdm-{{ section.id }} .sdm-card{
    display:grid;
    grid-template-columns:var(--img-col) calc(100% - var(--img-col));
    background:var(--card-bg); border-radius:28px; overflow:hidden;
    box-shadow:var(--shadow-md);
  }
  #sdm-{{ section.id }}.sdm--img-right .sdm-visual{ order:2; }
  #sdm-{{ section.id }}.sdm--img-right .sdm-body{ order:1; }

  #sdm-{{ section.id }} .sdm-visual{
    position:relative; overflow:hidden; background:var(--visual-bg);
    min-height:var(--visual-min-h); display:flex;
    align-items:var(--hero-va); justify-content:var(--hero-ha);
  }
  #sdm-{{ section.id }} .sdm-blob{ position:absolute; border-radius:50%; }
  #sdm-{{ section.id }} .sdm-blob1{ width:300px; height:300px; background:var(--blush); opacity:.5; top:-40px; left:-40px; }
  #sdm-{{ section.id }} .sdm-blob2{ width:180px; height:180px; background:var(--peach); opacity:.35; bottom:-30px; right:-20px; }
  #sdm-{{ section.id }} .sdm-blob3{ width:120px; height:120px; background:var(--sage); opacity:.25; top:40px; right:30px; }
  #sdm-{{ section.id }}.sdm--dark .sdm-blob1{ background:var(--sky); opacity:.18; }
  #sdm-{{ section.id }}.sdm--dark .sdm-blob2{ background:var(--blush); opacity:.5; }
  #sdm-{{ section.id }}.sdm--dark .sdm-blob3{ background:var(--rose); opacity:.18; }

  #sdm-{{ section.id }} .sdm-hero{ position:relative; z-index:2; width:var(--hero-w); max-width:var(--hero-max); height:auto; border-radius:var(--hero-radius); filter:drop-shadow(0 18px 32px rgba(27,58,92,.18)); }
  #sdm-{{ section.id }} .sdm-hero--logo{ width:calc(var(--hero-w) * .66); max-width:calc(var(--hero-max) * .7); border-radius:var(--hero-radius); }
  #sdm-{{ section.id }} .sdm-flag{
    display:inline-flex; align-items:center; gap:6px; padding:5px 14px; border-radius:999px;
    background:var(--flag-bg); color:var(--flag-txt);
    font-size:10px; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
    margin-bottom:14px; align-self:flex-start;
  }

  #sdm-{{ section.id }} .sdm-body{ padding:32px var(--body-pad) 30px; display:flex; flex-direction:column; }
  #sdm-{{ section.id }} .sdm-wordmark{ font-family:var(--display); font-weight:400; font-size:var(--sz-wordmark); letter-spacing:.24em; text-transform:uppercase; color:var(--wordmark); margin-top:var(--mt-wordmark); margin-bottom:var(--mb-wordmark); }
  #sdm-{{ section.id }} .sdm-name{ font-family:var(--serif); font-weight:900; font-size:clamp(var(--sz-name-m),3vw,var(--sz-name-d)); line-height:1; letter-spacing:-.02em; color:var(--txt); margin-top:var(--mt-name); margin-bottom:var(--mb-name); }
  #sdm-{{ section.id }}.sdm--dark .sdm-name{ color:var(--txt) !important; }
  #sdm-{{ section.id }} .sdm-apos{ color:var(--rose); }
  #sdm-{{ section.id }}.sdm--dark .sdm-apos{ color:var(--rose) !important; }
  #sdm-{{ section.id }} .sdm-tag{ font-family:var(--display); font-weight:400; font-size:var(--sz-tagline); letter-spacing:.02em; color:var(--txt); margin-top:var(--mt-tagline); margin-bottom:var(--mb-tagline); }
  #sdm-{{ section.id }} .sdm-desc{ font-size:var(--sz-desc); line-height:1.6; color:var(--txt-muted); margin-top:var(--mt-desc); margin-bottom:var(--mb-desc); max-width:440px; }

  #sdm-{{ section.id }} .sdm-pills{ display:flex; gap:7px; flex-wrap:wrap; margin-top:var(--mt-pills); margin-bottom:var(--mb-pills); }
  #sdm-{{ section.id }} .sdm-pill{
    display:inline-flex; align-items:center; padding:6px 14px; border-radius:999px;
    font-size:var(--sz-pill); font-weight:600; letter-spacing:.12em; text-transform:uppercase;
    background:color-mix(in srgb, var(--pill) 16%, transparent);
    color:color-mix(in srgb, var(--pill) 70%, var(--navy));
  }
  #sdm-{{ section.id }}.sdm--dark .sdm-pill{
    background:color-mix(in srgb, var(--pill) 34%, transparent);
    color:color-mix(in srgb, var(--pill) 55%, #ffffff);
  }

  #sdm-{{ section.id }} .sdm-flavor-pick{ margin-top:var(--mt-flavor); }
  #sdm-{{ section.id }} .sdm-flavor-label{ display:flex; align-items:baseline; gap:8px; margin-bottom:var(--mb-flavor-lab); flex-wrap:wrap; }
  #sdm-{{ section.id }} .sdm-lab{ font-size:var(--sz-flavor-lab); font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--txt); }
  #sdm-{{ section.id }} .sdm-chosen{ font-family:var(--script); font-weight:700; font-size:var(--sz-flavor-chosen); line-height:1; color:var(--rose); white-space:nowrap; }
  #sdm-{{ section.id }} .sdm-swatch-row{ display:flex; gap:12px; flex-wrap:wrap; }
  #sdm-{{ section.id }} .sdm-swatch{ position:relative; display:flex; flex-direction:column; align-items:center; gap:6px; background:none; border:none; padding:0; cursor:pointer; width:calc(var(--sw-size) + 8px); font-family:var(--sans); }
  #sdm-{{ section.id }} .sdm-disc{ position:relative; width:var(--sw-size); height:var(--sw-size); border-radius:50%; background:var(--disc-bg); display:flex; align-items:center; justify-content:center; overflow:hidden; transition:transform .2s cubic-bezier(.34,1.56,.64,1), box-shadow .2s; outline:2.5px solid transparent; outline-offset:2px; }
  #sdm-{{ section.id }} .sdm-sblob{ position:absolute; inset:0; border-radius:50%; background:var(--sc,var(--blush)); opacity:.22; }
  #sdm-{{ section.id }} .sdm-disc img{ position:absolute; z-index:1; width:var(--fi-size,70%); height:auto; left:var(--fi-x,50%); top:var(--fi-y,50%); transform:translate(-50%,-50%); object-fit:contain; }
  #sdm-{{ section.id }} .sdm-swatch:hover .sdm-disc{ transform:translateY(-3px) scale(1.05); box-shadow:0 2px 12px rgba(27,58,92,.12); }
  #sdm-{{ section.id }} .sdm-swatch.sdm-active .sdm-disc{ outline-color:var(--sc,var(--rose)); box-shadow:0 2px 12px rgba(27,58,92,.12); }
  #sdm-{{ section.id }} .sdm-swatch.sdm-active .sdm-sblob{ opacity:.4; }
  #sdm-{{ section.id }} .sdm-swatch-name{ font-size:var(--sz-swatch-name); font-weight:600; line-height:1.2; color:var(--swname); text-align:center; }
  #sdm-{{ section.id }} .sdm-swatch.sdm-active .sdm-swatch-name{ color:var(--swname-on); }

  #sdm-{{ section.id }} .sdm-buy{ margin-top:auto; padding-top:var(--mt-buy); display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
  #sdm-{{ section.id }} .sdm-price{ display:flex; flex-direction:column; align-items:center; }
  #sdm-{{ section.id }} .sdm-from{ font-size:var(--sz-sub-save); font-weight:700; letter-spacing:.04em; color:var(--txt); text-align:center; width:100%; margin-bottom:var(--mb-sub-save); }
  #sdm-{{ section.id }} .sdm-price-row{ display:inline-flex; align-items:baseline; gap:8px; flex-wrap:wrap; justify-content:center; }
  #sdm-{{ section.id }} .sdm-now{ font-family:var(--serif); font-weight:800; font-size:var(--sz-price-now); color:var(--txt); letter-spacing:-.01em; }
  #sdm-{{ section.id }} .sdm-was{ font-family:var(--serif); font-weight:800; font-size:var(--sz-price-was); color:var(--txt-muted); text-decoration:line-through; }
  #sdm-{{ section.id }} .sdm-free-ship{ font-size:var(--sz-free-ship); font-weight:600; color:var(--rose); letter-spacing:.02em; white-space:nowrap; }

  #sdm-{{ section.id }} .sdm-btn{
    display:inline-flex; align-items:center; gap:8px; border:none; border-radius:999px; cursor:pointer;
    font-family:var(--sans); font-weight:600; font-size:var(--sz-btn); letter-spacing:.08em; text-transform:uppercase;
    padding:14px 28px; background:var(--rose); color:#fff; box-shadow:var(--shadow-rose);
    transition:transform .2s, box-shadow .2s; text-decoration:none;
  }
  #sdm-{{ section.id }} .sdm-btn:hover{ transform:translateY(-2px); box-shadow:0 10px 32px rgba(232,96,122,.35); }
  #sdm-{{ section.id }} .sdm-btn svg{ width:16px; height:16px; }

  @media (max-width:900px){
    #sdm-{{ section.id }} .sdm-card{ grid-template-columns:1fr; }
    #sdm-{{ section.id }} .sdm-visual{ min-height:240px; order:1 !important; }
    #sdm-{{ section.id }} .sdm-body{ order:2 !important; }
  }
  @media (max-width:560px){ #sdm-{{ section.id }} .sdm-body{ padding:28px 24px 26px; } }
</style>

<script>
(function(){
  var root = document.getElementById('sdm-{{ section.id }}');
  if(!root) return;
  var base = root.dataset.productUrl || '#';
  var row = root.querySelector('[data-swatches]');
  var chosenEl = root.querySelector('[data-chosen]');
  var viewLink = root.querySelector('[data-view]');
  if(!row) return;
  var swatches = Array.prototype.slice.call(row.querySelectorAll('.sdm-swatch'));
  if(!swatches.length) return;

  function syncLink(sw){
    if(!viewLink) return;
    var v = sw.dataset.variant;
    viewLink.href = (v && base !== '#') ? (base + '?variant=' + v) : base;
  }
  function select(sw){
    swatches.forEach(function(s){ s.classList.toggle('sdm-active', s === sw); });
    if(chosenEl){
      chosenEl.textContent = sw.dataset.name || '';
      chosenEl.style.color = (sw.style.getPropertyValue('--sc') || '').trim() || 'var(--rose)';
    }
    syncLink(sw);
  }
  swatches.forEach(function(sw){ sw.addEventListener('click', function(){ select(sw); }); });
  select(swatches[0]);
})();
</script>

{% schema %}
