{%- comment -%}
  ============================================================
  WELLER CO. — Her'dration Cart Drawer  (Shopify Section)
  ------------------------------------------------------------
  A slide-out drawer that summarizes the cart: free-shipping
  progress bar, line items with qty steppers + remove, free
  welcome gifts, discount code field, savings banner, totals,
  and a secure checkout button.

  HOW TO INSTALL (global drawer):
    1. Upload this file to /sections as
       `herdrationcartdrawer.liquid`.
    2. In `layout/theme.liquid`, just before </body>, add:
         {% section 'herdrationcartdrawer' %}
    3. The drawer auto-binds to any cart trigger on the page:
         • <a href="/cart"> links
         • elements with [data-cart-drawer-open]
         • a window event:  document.dispatchEvent(
             new CustomEvent('cart-drawer:open'))
         • JS API:  window.HerdrationCartDrawer.open()
       To make your existing "add to cart" buttons pop the
       drawer, call HerdrationCartDrawer.open() after a
       successful /cart/add.js (or dispatch 'cart-drawer:open').

  • Updates use /cart/change.js + the Section Rendering API,
    so every price re-renders through Liquid `| money` and stays
    correct in any currency.
  • Styles + JS are namespaced under #cd-{{ section.id }}.
  ============================================================
{%- endcomment -%}

{%- assign threshold_cents = section.settings.free_ship_threshold | times: 100 -%}
{%- assign remaining = threshold_cents | minus: cart.total_price -%}

{%- comment -%} savings + subscription detection {%- endcomment -%}
{%- assign savings = 0 -%}
{%- assign has_sub = false -%}
{%- for item in cart.items -%}
  {%- if item.original_price > item.final_price -%}
    {%- assign diff = item.original_price | minus: item.final_price | times: item.quantity -%}
    {%- assign savings = savings | plus: diff -%}
  {%- endif -%}
  {%- if item.selling_plan_allocation -%}{%- assign has_sub = true -%}{%- endif -%}
{%- endfor -%}

<div
  id="cd-{{ section.id }}"
  class="cd-overlay"
  data-section-id="{{ section.id }}"
  data-threshold="{{ threshold_cents }}"
  aria-hidden="true">

  <aside class="cd-panel" role="dialog" aria-modal="true" aria-label="Your cart">

    <div class="cd-head">
      <h3>{{ section.settings.heading | default: 'Your cart' }}</h3>
      <span class="cd-count">{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</span>
      <button class="cd-close" type="button" data-cd-close aria-label="Close cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    {%- comment -%} Everything below re-renders via the Section Rendering API {%- endcomment -%}
    <div class="cd-scroll" data-cd-rerender>

      {%- if cart.item_count > 0 -%}

        {%- comment -%} ===== free shipping progress ===== {%- endcomment -%}
        {%- if section.settings.show_free_ship -%}
          <div class="cd-ship">
            <div class="cd-ship-txt">
              {%- if remaining > 0 -%}
                You're <b>{{ remaining | money }}</b> away from free shipping.
              {%- else -%}
                <span class="won">✓ You've unlocked free shipping!</span>
              {%- endif -%}
            </div>
            <div class="cd-ship-bar">
              {%- if remaining > 0 -%}
                {%- assign pct = cart.total_price | times: 100 | divided_by: threshold_cents -%}
                <div class="cd-ship-fill" style="width:{{ pct | at_most: 100 }}%"></div>
              {%- else -%}
                <div class="cd-ship-fill full" style="width:100%"></div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="cd-body">
          <div class="cd-lines">
            {%- for item in cart.items -%}
              <div class="cd-line" data-cd-key="{{ item.key }}">
                <a class="cd-line-img" href="{{ item.url }}" style="--lc:{{ item.product.metafields.custom.tile_color | default: '#E8607A' }}">
                  <span class="lblob"></span>
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 160 | image_tag: alt: item.product.title, loading: 'lazy' }}
                  {%- endif -%}
                </a>
                <div class="cd-line-info">
                  <div class="cd-line-name">{{ item.product.title }}</div>
                  <div class="cd-line-tag">
                    {%- if item.selling_plan_allocation -%}
                      {{ item.selling_plan_allocation.selling_plan.name }}
                    {%- elsif item.variant.title != 'Default Title' -%}
                      {{ item.variant.title }}
                    {%- else -%}
                      One-time purchase
                    {%- endif -%}
                  </div>
                  <div class="cd-line-controls">
                    <span class="cd-stepper">
                      <button type="button" data-cd-dec data-cd-key="{{ item.key }}" data-cd-qty="{{ item.quantity }}" aria-label="Decrease">−</button>
                      <span class="q">{{ item.quantity }}</span>
                      <button type="button" data-cd-inc data-cd-key="{{ item.key }}" data-cd-qty="{{ item.quantity }}" aria-label="Increase">+</button>
                    </span>
                    <button type="button" class="cd-rm" data-cd-remove data-cd-key="{{ item.key }}" aria-label="Remove {{ item.product.title | escape }}">Remove</button>
                  </div>
                </div>
                <div class="cd-line-price">
                  <span class="now">{{ item.final_line_price | money }}</span>
                  {%- if item.original_line_price > item.final_line_price -%}
                    <span class="was">{{ item.original_line_price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- comment -%} ===== free welcome gifts ===== {%- endcomment -%}
          {%- if section.settings.show_gifts and section.blocks.size > 0 -%}
            <div class="cd-gifts">
              <div class="cd-gifts-h">{{ section.settings.gifts_title | default: 'Free welcome gifts · 1st box' }}</div>
              {%- for block in section.blocks -%}
                {%- if block.type == 'gift' -%}
                  <div class="cd-gift" {{ block.shopify_attributes }}>
                    <span class="cd-gift-ic">
                      {%- if block.settings.icon != blank -%}
                        {{ block.settings.icon | image_url: width: 48 | image_tag: alt: '' }}
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 21V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7Z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7Z"/></svg>
                      {%- endif -%}
                    </span>
                    <span class="cd-gift-info">
                      <span class="cd-gift-name">{{ block.settings.name | default: 'Welcome gift' }}</span>
                      <span class="cd-gift-tag">{{ block.settings.desc }}</span>
                    </span>
                    <span class="cd-gift-val">
                      {%- if block.settings.value != blank -%}<span class="strike">{{ block.settings.value }}</span>{%- endif -%}
                      <span class="free">Free</span>
                    </span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <div class="cd-foot">
          {%- if savings > 0 -%}
            <div class="cd-savings">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 11.3 12 20l-8.8-8.7a4 4 0 0 1 5.6-5.6L12 8l3.2-2.3a4 4 0 0 1 5.6 5.6Z"/></svg>
              <span class="s-txt">You're saving <b>{{ savings | money }}</b> today.</span>
            </div>
          {%- endif -%}

          <div class="cd-totals">
            <div class="cd-trow">
              <span class="lbl">Subtotal</span>
              <span class="val">{{ cart.original_total_price | money }}</span>
            </div>
            {%- if savings > 0 -%}
              <div class="cd-trow save">
                <span class="lbl">Discount</span>
                <span class="val">−{{ savings | money }}</span>
              </div>
            {%- endif -%}
            <div class="cd-trow">
              <span class="lbl">Shipping</span>
              {%- if remaining > 0 -%}
                <span class="val">Calculated at checkout</span>
              {%- else -%}
                <span class="val free">FREE</span>
              {%- endif -%}
            </div>
          </div>

          {%- if section.settings.show_discount -%}
            <form class="cd-promo" data-cd-promo method="get" action="{{ routes.cart_url }}">
              <input type="text" name="discount" placeholder="Discount code" aria-label="Discount code" autocomplete="off">
              <button type="submit">Apply</button>
            </form>
            <div class="cd-promo-note">Codes apply at checkout. Tap a code to save it to your cart.</div>
          {%- endif -%}

          <div class="cd-grand">
            <span class="lbl">Total</span>
            <span class="val">{{ cart.total_price | money }} <small>{{ cart.currency.iso_code }}</small></span>
          </div>

          <a href="{{ routes.cart_url }}/checkout" class="cd-checkout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            {{ section.settings.checkout_label | default: 'Checkout securely' }}
          </a>
          <button class="cd-continue" type="button" data-cd-close>or continue shopping</button>

          {%- if section.settings.trust_text != blank -%}
            <div class="cd-trust-mini">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3Z"/><path d="M9 12l2 2 4-4"/></svg>
              {{ section.settings.trust_text }}
            </div>
          {%- endif -%}
        </div>

      {%- else -%}
        {%- comment -%} ===== empty state ===== {%- endcomment -%}
        <div class="cd-empty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <p>{{ section.settings.empty_text | default: 'Your cart is feeling light.' }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="cd-empty-btn" data-cd-close>Keep shopping</a>
        </div>
      {%- endif -%}

    </div>
  </aside>
</div>

{%- comment -%} ============ STYLES (namespaced) ============ {%- endcomment -%}
<style>
  #cd-{{ section.id }}{
    --cd-cream:#FAF5F0; --cd-fog:#F5EEE8; --cd-mist:#E8DDD5; --cd-stone:#8A7E76;
    --cd-navy:#1B3A5C; --cd-rose:#E8607A; --cd-sage:#8A9B6E; --cd-peach:#E8A87C; --cd-lime:#7DB642; --cd-blush:#F2C4CE;
    --cd-serif:'Playfair Display','Georgia',serif; --cd-sans:'DM Sans','Helvetica Neue',sans-serif;
    position:fixed; inset:0; z-index:9999; background:rgba(27,58,92,.32); backdrop-filter:blur(3px);
    opacity:0; visibility:hidden; transition:opacity .35s ease, visibility .35s ease; font-family:var(--cd-sans);
  }
  #cd-{{ section.id }}.open{ opacity:1; visibility:visible; }
  #cd-{{ section.id }} *{ box-sizing:border-box; }
  #cd-{{ section.id }} .cd-panel{
    position:fixed; top:0; right:0; height:100%; width:430px; max-width:92vw;
    background:var(--cd-cream); box-shadow:-18px 0 60px rgba(27,58,92,.20);
    display:flex; flex-direction:column; transform:translateX(100%);
    transition:transform .42s cubic-bezier(.34,1.1,.4,1);
  }
  #cd-{{ section.id }}.open .cd-panel{ transform:translateX(0); }

  #cd-{{ section.id }} .cd-head{ flex-shrink:0; padding:24px 26px 18px; display:flex; align-items:center; gap:12px; border-bottom:1px solid var(--cd-mist); }
  #cd-{{ section.id }} .cd-head h3{ font-family:var(--cd-serif); font-weight:800; font-size:22px; color:var(--cd-navy); margin:0; letter-spacing:-.01em; white-space:nowrap; flex-shrink:0; }
  #cd-{{ section.id }} .cd-count{ font-size:12px; font-weight:600; letter-spacing:.04em; color:var(--cd-stone); }
  #cd-{{ section.id }} .cd-close{ margin-left:auto; width:38px; height:38px; border-radius:50%; border:1px solid var(--cd-mist); background:#fff; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; color:var(--cd-navy); transition:transform .2s, border-color .2s, color .2s; }
  #cd-{{ section.id }} .cd-close:hover{ transform:rotate(90deg); border-color:var(--cd-rose); color:var(--cd-rose); }
  #cd-{{ section.id }} .cd-close svg{ width:18px; height:18px; }

  #cd-{{ section.id }} .cd-scroll{ flex:1; display:flex; flex-direction:column; min-height:0; }

  #cd-{{ section.id }} .cd-ship{ flex-shrink:0; padding:16px 26px; background:#fff; border-bottom:1px solid var(--cd-mist); }
  #cd-{{ section.id }} .cd-ship-txt{ font-size:12.5px; color:var(--cd-navy); margin-bottom:9px; line-height:1.4; }
  #cd-{{ section.id }} .cd-ship-txt b{ color:var(--cd-rose); }
  #cd-{{ section.id }} .cd-ship-txt .won{ color:var(--cd-sage); font-weight:700; }
  #cd-{{ section.id }} .cd-ship-bar{ height:7px; border-radius:999px; background:var(--cd-mist); overflow:hidden; }
  #cd-{{ section.id }} .cd-ship-fill{ height:100%; border-radius:999px; background:linear-gradient(90deg,var(--cd-rose),var(--cd-peach)); transition:width .5s cubic-bezier(.4,0,.2,1); }
  #cd-{{ section.id }} .cd-ship-fill.full{ background:linear-gradient(90deg,var(--cd-sage),var(--cd-lime)); }

  #cd-{{ section.id }} .cd-body{ flex:1; overflow-y:auto; padding:20px 26px; }
  #cd-{{ section.id }} .cd-lines{ display:flex; flex-direction:column; gap:18px; }
  #cd-{{ section.id }} .cd-line{ display:flex; gap:14px; }
  #cd-{{ section.id }} .cd-line-img{ width:66px; height:66px; border-radius:16px; flex-shrink:0; position:relative; background:var(--cd-fog); display:flex; align-items:center; justify-content:center; overflow:hidden; }
  #cd-{{ section.id }} .cd-line-img .lblob{ position:absolute; width:130%; height:130%; border-radius:50%; background:var(--lc,var(--cd-blush)); opacity:.5; top:-15%; left:-15%; }
  #cd-{{ section.id }} .cd-line-img img{ position:relative; z-index:1; width:78%; height:78%; object-fit:contain; filter:drop-shadow(0 4px 8px rgba(27,58,92,.18)); }
  #cd-{{ section.id }} .cd-line-info{ flex:1; min-width:0; }
  #cd-{{ section.id }} .cd-line-name{ font-family:var(--cd-serif); font-weight:700; font-size:15px; color:var(--cd-navy); line-height:1.15; }
  #cd-{{ section.id }} .cd-line-tag{ font-size:11.5px; color:var(--cd-stone); margin-top:3px; }
  #cd-{{ section.id }} .cd-line-controls{ display:flex; align-items:center; gap:12px; margin-top:10px; }
  #cd-{{ section.id }} .cd-stepper{ display:inline-flex; align-items:center; gap:2px; background:#fff; border:1px solid var(--cd-mist); border-radius:999px; padding:3px; }
  #cd-{{ section.id }} .cd-stepper button{ width:26px; height:26px; border-radius:50%; border:none; cursor:pointer; background:transparent; color:var(--cd-navy); font-size:16px; font-weight:700; line-height:1; display:inline-flex; align-items:center; justify-content:center; transition:background .15s, color .15s, transform .1s; }
  #cd-{{ section.id }} .cd-stepper button:hover{ background:var(--cd-rose); color:#fff; }
  #cd-{{ section.id }} .cd-stepper button:active{ transform:scale(.88); }
  #cd-{{ section.id }} .cd-stepper .q{ min-width:22px; text-align:center; font-weight:700; font-size:13px; color:var(--cd-navy); }
  #cd-{{ section.id }} .cd-rm{ background:none; border:none; cursor:pointer; color:var(--cd-stone); font-size:11px; font-weight:600; letter-spacing:.04em; padding:4px 2px; transition:color .15s; }
  #cd-{{ section.id }} .cd-rm:hover{ color:var(--cd-rose); }
  #cd-{{ section.id }} .cd-line-price{ text-align:right; flex-shrink:0; }
  #cd-{{ section.id }} .cd-line-price .now{ font-weight:700; font-size:15px; color:var(--cd-navy); }
  #cd-{{ section.id }} .cd-line-price .was{ display:block; font-size:11.5px; color:var(--cd-stone); text-decoration:line-through; }

  #cd-{{ section.id }} .cd-gifts{ margin-top:22px; padding-top:18px; border-top:1px dashed var(--cd-mist); }
  #cd-{{ section.id }} .cd-gifts-h{ display:flex; align-items:center; gap:8px; margin-bottom:12px; font-size:11px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--cd-rose); }
  #cd-{{ section.id }} .cd-gifts-h::after{ content:""; flex:1; height:1px; background:rgba(232,96,122,.25); }
  #cd-{{ section.id }} .cd-gift{ display:flex; gap:12px; align-items:center; padding:8px 0; }
  #cd-{{ section.id }} .cd-gift + .cd-gift{ border-top:1px dashed var(--cd-mist); }
  #cd-{{ section.id }} .cd-gift-ic{ width:40px; height:40px; border-radius:12px; flex-shrink:0; background:rgba(232,96,122,.12); color:var(--cd-rose); display:inline-flex; align-items:center; justify-content:center; overflow:hidden; }
  #cd-{{ section.id }} .cd-gift-ic svg{ width:20px; height:20px; }
  #cd-{{ section.id }} .cd-gift-ic img{ width:100%; height:100%; object-fit:cover; }
  #cd-{{ section.id }} .cd-gift-info{ flex:1; }
  #cd-{{ section.id }} .cd-gift-name{ font-weight:600; font-size:13px; color:var(--cd-navy); line-height:1.2; }
  #cd-{{ section.id }} .cd-gift-tag{ font-size:11px; color:var(--cd-stone); margin-top:1px; }
  #cd-{{ section.id }} .cd-gift-val .strike{ font-size:11px; color:var(--cd-stone); text-decoration:line-through; }
  #cd-{{ section.id }} .cd-gift-val .free{ display:block; font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--cd-sage); text-align:right; }

  #cd-{{ section.id }} .cd-empty{ text-align:center; padding:64px 24px; margin:auto; }
  #cd-{{ section.id }} .cd-empty svg{ width:52px; height:52px; color:var(--cd-mist); margin:0 auto 18px; }
  #cd-{{ section.id }} .cd-empty p{ font-size:15px; color:var(--cd-stone); margin:0 0 22px; }
  #cd-{{ section.id }} .cd-empty-btn{ display:inline-block; background:var(--cd-rose); color:#fff; text-decoration:none; padding:13px 26px; border-radius:999px; font-weight:600; font-size:13px; letter-spacing:.04em; }

  #cd-{{ section.id }} .cd-foot{ flex-shrink:0; padding:20px 26px 24px; background:#fff; border-top:1px solid var(--cd-mist); }
  #cd-{{ section.id }} .cd-savings{ display:flex; align-items:center; gap:10px; margin-bottom:16px; background:rgba(125,182,66,.12); border:1px solid rgba(125,182,66,.28); border-radius:12px; padding:11px 14px; }
  #cd-{{ section.id }} .cd-savings svg{ width:20px; height:20px; color:var(--cd-sage); flex-shrink:0; }
  #cd-{{ section.id }} .cd-savings .s-txt{ font-size:12.5px; line-height:1.4; color:var(--cd-navy); }
  #cd-{{ section.id }} .cd-savings .s-txt b{ color:#4e7d1f; }
  #cd-{{ section.id }} .cd-totals{ display:flex; flex-direction:column; gap:8px; margin-bottom:14px; }
  #cd-{{ section.id }} .cd-trow{ display:flex; align-items:center; justify-content:space-between; font-size:13.5px; color:var(--cd-navy); }
  #cd-{{ section.id }} .cd-trow .lbl{ color:var(--cd-stone); }
  #cd-{{ section.id }} .cd-trow.save .lbl{ color:var(--cd-rose); font-weight:600; }
  #cd-{{ section.id }} .cd-trow.save .val{ color:var(--cd-rose); font-weight:700; }
  #cd-{{ section.id }} .cd-trow .free{ color:var(--cd-sage); font-weight:700; }
  #cd-{{ section.id }} .cd-promo{ display:flex; gap:8px; margin-bottom:8px; }
  #cd-{{ section.id }} .cd-promo input{ flex:1; min-width:0; height:44px; padding:0 14px; border-radius:11px; background:#fff; border:1.5px solid var(--cd-mist); color:var(--cd-navy); font-family:var(--cd-sans); font-size:14px; text-transform:uppercase; letter-spacing:.04em; }
  #cd-{{ section.id }} .cd-promo input::placeholder{ text-transform:none; letter-spacing:0; color:var(--cd-stone); }
  #cd-{{ section.id }} .cd-promo input:focus{ outline:none; border-color:var(--cd-rose); }
  #cd-{{ section.id }} .cd-promo button{ flex-shrink:0; height:44px; padding:0 18px; border-radius:11px; border:1.5px solid var(--cd-mist); background:var(--cd-fog); color:var(--cd-navy); font-family:var(--cd-sans); font-weight:700; font-size:12px; letter-spacing:.06em; text-transform:uppercase; cursor:pointer; transition:background .15s, border-color .15s, color .15s; }
  #cd-{{ section.id }} .cd-promo button:hover{ border-color:var(--cd-rose); color:var(--cd-rose); }
  #cd-{{ section.id }} .cd-promo-note{ font-size:11px; color:var(--cd-stone); margin-bottom:14px; }
  #cd-{{ section.id }} .cd-grand{ display:flex; align-items:baseline; justify-content:space-between; padding-top:14px; margin-bottom:16px; border-top:2px solid var(--cd-mist); }
  #cd-{{ section.id }} .cd-grand .lbl{ font-family:var(--cd-serif); font-weight:800; font-size:17px; color:var(--cd-navy); }
  #cd-{{ section.id }} .cd-grand .val{ font-family:var(--cd-serif); font-weight:900; font-size:26px; color:var(--cd-navy); letter-spacing:-.01em; }
  #cd-{{ section.id }} .cd-grand .val small{ font-size:12px; font-weight:600; color:var(--cd-stone); margin-left:3px; }
  #cd-{{ section.id }} .cd-checkout{ display:flex; align-items:center; justify-content:center; gap:8px; width:100%; padding:17px 24px; border:none; border-radius:999px; background:var(--cd-rose); color:#fff; text-decoration:none; font-family:var(--cd-sans); font-weight:600; font-size:13px; letter-spacing:.06em; text-transform:uppercase; cursor:pointer; box-shadow:0 4px 20px rgba(232,96,122,.20); transition:transform .2s, box-shadow .2s; }
  #cd-{{ section.id }} .cd-checkout:hover{ transform:translateY(-2px); box-shadow:0 10px 32px rgba(232,96,122,.35); }
  #cd-{{ section.id }} .cd-checkout svg{ width:16px; height:16px; }
  #cd-{{ section.id }} .cd-continue{ display:block; width:100%; text-align:center; margin-top:12px; background:none; border:none; cursor:pointer; font-family:var(--cd-sans); font-size:12px; font-weight:600; letter-spacing:.04em; color:var(--cd-stone); text-decoration:underline; text-underline-offset:3px; text-decoration-color:var(--cd-mist); transition:color .15s; }
  #cd-{{ section.id }} .cd-continue:hover{ color:var(--cd-rose); }
  #cd-{{ section.id }} .cd-trust-mini{ display:flex; align-items:center; justify-content:center; gap:7px; margin-top:14px; font-size:10.5px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--cd-stone); }
  #cd-{{ section.id }} .cd-trust-mini svg{ width:13px; height:13px; color:var(--cd-sage); }

  #cd-{{ section.id }}.is-busy .cd-scroll{ opacity:.55; pointer-events:none; transition:opacity .15s; }

  @media (max-width:480px){
    #cd-{{ section.id }} .cd-head, #cd-{{ section.id }} .cd-ship,
    #cd-{{ section.id }} .cd-body, #cd-{{ section.id }} .cd-foot{ padding-left:18px; padding-right:18px; }
  }
</style>

{%- comment -%} ============ BEHAVIOUR ============ {%- endcomment -%}
<script>
(function(){
  var SID = '{{ section.id }}';
  var overlay = document.getElementById('cd-' + SID);
  if(!overlay) return;

  function open(){ overlay.classList.add('open'); overlay.setAttribute('aria-hidden','false'); document.documentElement.style.overflow='hidden'; }
  function close(){ overlay.classList.remove('open'); overlay.setAttribute('aria-hidden','true'); document.documentElement.style.overflow=''; }

  function refresh(){
    return fetch(window.location.pathname + '?section_id=' + SID, { headers:{ 'Accept':'text/html' } })
      .then(function(r){ return r.text(); })
      .then(function(html){
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('[data-cd-rerender]');
        var cur = overlay.querySelector('[data-cd-rerender]');
        if(fresh && cur){ cur.innerHTML = fresh.innerHTML; }
        var count = doc.querySelector('.cd-count');
        var curCount = overlay.querySelector('.cd-count');
        if(count && curCount){ curCount.textContent = count.textContent; }
      });
  }

  function changeLine(key, qty){
    overlay.classList.add('is-busy');
    fetch('{{ routes.cart_change_url }}', {
      method:'POST',
      headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
    .then(function(){ return refresh(); })
    .then(function(){
      overlay.classList.remove('is-busy');
      document.dispatchEvent(new CustomEvent('cart-drawer:updated', { bubbles:true }));
    })
    .catch(function(){ overlay.classList.remove('is-busy'); });
  }

  overlay.addEventListener('click', function(e){
    var close_ = e.target.closest('[data-cd-close]');
    if(close_){ e.preventDefault(); close(); return; }
    if(e.target === overlay){ close(); return; }

    var inc = e.target.closest('[data-cd-inc]');
    if(inc){ changeLine(inc.getAttribute('data-cd-key'), (parseInt(inc.getAttribute('data-cd-qty'),10)||0) + 1); return; }
    var dec = e.target.closest('[data-cd-dec]');
    if(dec){ changeLine(dec.getAttribute('data-cd-key'), Math.max(0,(parseInt(dec.getAttribute('data-cd-qty'),10)||0) - 1)); return; }
    var rm = e.target.closest('[data-cd-remove]');
    if(rm){ changeLine(rm.getAttribute('data-cd-key'), 0); return; }
  });

  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && overlay.classList.contains('open')) close(); });

  document.addEventListener('click', function(e){
    var t = e.target.closest('a[href$="/cart"], a[href*="/cart?"], [data-cart-drawer-open]');
    if(t){ e.preventDefault(); refresh().then(open); }
  });
  document.addEventListener('cart-drawer:open', function(){ refresh().then(open); });

  window.HerdrationCartDrawer = {
    open: function(){ return refresh().then(open); },
    close: close,
    refresh: refresh
  };
})();
</script>

