{%- comment -%} ============ BEHAVIOUR ============ {%- endcomment -%}
<script>
(function(){
  var SID = '{{ section.id }}';
  var overlay = document.getElementById('cd-' + SID);
  if(!overlay) return;

  function open(){ overlay.classList.add('open'); overlay.setAttribute('aria-hidden','false'); document.documentElement.style.overflow='hidden'; }
  function close(){ overlay.classList.remove('open'); overlay.setAttribute('aria-hidden','true'); document.documentElement.style.overflow=''; }

  function updateHeaderBubble(){
    /* cache-bust + no-store: the Section Rendering response gets cached by the
       browser otherwise, and a stale (often empty) bubble overwrites the live one */
    fetch('/?sections=cart-icon-bubble&t=' + Date.now(),{cache:'no-store',headers:{'Accept':'application/json'}})
      .then(function(r){return r.json();})
      .then(function(data){
        var html=data['cart-icon-bubble'];if(!html)return;
        var target=document.getElementById('cart-icon-bubble');if(!target)return;
        var doc=new DOMParser().parseFromString(html,'text/html');
        var fresh=doc.getElementById('cart-icon-bubble');
        if(fresh){target.innerHTML=fresh.innerHTML;}
      }).catch(function(){});
  }

  function updateHeaderCount(n){
    var s = String(n);
    /* covers Dawn, Debut, and most custom themes */
    document.querySelectorAll('[data-cart-count],[data-header-cart-count],.cart-count,.header-cart-count,#CartCount,.cart__count,.cart-icon__bubble-count').forEach(function(el){ el.textContent = s; });
    /* Dawn's cart-icon-bubble custom element */
    document.querySelectorAll('cart-icon-bubble').forEach(function(el){
      var b = el.querySelector('.visually-hidden'); if(b) b.textContent = n + ' items';
      var c = el.querySelector('[aria-hidden]'); if(c) c.textContent = s;
    });
    /* show/hide zero-state on elements that hide when empty */
    document.querySelectorAll('[data-cart-count-bubble]').forEach(function(el){ el.style.display = n > 0 ? '' : 'none'; el.textContent = s; });
    /* Re-render Dawn's cart bubble via Section Rendering API so it appears/disappears correctly */
    updateHeaderBubble();
  }

  function refresh(){
    return fetch(window.location.pathname + '?section_id=' + SID, { headers:{ 'Accept':'text/html' } })
      .then(function(r){ return r.text(); })
      .then(function(html){
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('[data-cd-rerender]');
        var cur = overlay.querySelector('[data-cd-rerender]');
        if(fresh && cur){ cur.innerHTML = fresh.innerHTML; }
        var count = doc.querySelector('.cd-count');
        var curCount = overlay.querySelector('.cd-count');
        if(count && curCount){ curCount.textContent = count.textContent; }
        if(savedDiscount){ showAppliedBadge(savedDiscount); }
        /* update header cart icon count */
        fetch('/cart.js', { cache:'no-store', headers:{ 'Accept':'application/json' } })
          .then(function(r){ return r.json(); })
          .then(function(c){ updateHeaderCount(c.item_count); })
          .catch(function(){});
      });
  }

  function changeLine(key, qty){
    overlay.classList.add('is-busy');
    fetch('{{ routes.cart_change_url }}', {
      method:'POST',
      headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
    .then(function(){ return refresh(); })
    .then(function(){
      overlay.classList.remove('is-busy');
      document.dispatchEvent(new CustomEvent('cart-drawer:updated', { bubbles:true }));
    })
    .catch(function(){ overlay.classList.remove('is-busy'); });
  }

  /* Discount code — hits /discount/<code> to set session cookie,
     then stores code so checkout URL includes ?discount=<code>.
     Shopify only applies discount codes at checkout, not in the cart API. */
  var savedDiscount = '';

  function updateCheckoutHref(){
    var link = overlay.querySelector('[data-cd-checkout]');
    if(!link) return;
    link.href = savedDiscount ? '/checkout?discount=' + encodeURIComponent(savedDiscount) : '/checkout';
  }

  function showAppliedBadge(code){
    var form = overlay.querySelector('[data-cd-promo]');
    var applied = overlay.querySelector('[data-cd-promo-applied]');
    var label = overlay.querySelector('[data-cd-promo-code-label]');
    var msg = overlay.querySelector('[data-cd-promo-msg]');
    if(form) form.style.display = 'none';
    if(msg) { msg.textContent = ''; msg.className = 'cd-promo-msg'; }
    if(applied) applied.style.display = 'flex';
    if(label) label.textContent = code;
  }

  function clearAppliedBadge(){
    var form = overlay.querySelector('[data-cd-promo]');
    var applied = overlay.querySelector('[data-cd-promo-applied]');
    var msg = overlay.querySelector('[data-cd-promo-msg]');
    if(form) form.style.display = 'flex';
    if(applied) applied.style.display = 'none';
    if(msg) { msg.textContent = ''; msg.className = 'cd-promo-msg'; }
    savedDiscount = '';
    updateCheckoutHref();
  }

  overlay.addEventListener('submit', function(e){
    var form = e.target.closest('[data-cd-promo]');
    if(!form) return;
    e.preventDefault();
    var input = form.querySelector('input[name="discount"]');
    var msg = overlay.querySelector('[data-cd-promo-msg]');
    var code = (input.value || '').trim();
    if(!code){ if(msg){ msg.textContent='Please enter a code.'; msg.className='cd-promo-msg err'; } return; }
    var btn = form.querySelector('button');
    btn.textContent = '...';
    btn.disabled = true;

    fetch('/discount/' + encodeURIComponent(code), { method:'GET', redirect:'manual' })
      .then(function(r){
        if(r.status === 0 || r.ok || r.status === 302 || r.type === 'opaqueredirect'){
          savedDiscount = code;
          updateCheckoutHref();
          input.value = '';
          showAppliedBadge(code);
          return refresh();
        } else {
          if(msg){ msg.textContent='Code not found. Check spelling and try again.'; msg.className='cd-promo-msg err'; }
        }
      })
      .catch(function(){
        savedDiscount = code;
        updateCheckoutHref();
        input.value = '';
        showAppliedBadge(code);
        return refresh();
      })
      .finally(function(){
        btn.textContent = 'Apply';
        btn.disabled = false;
      });
  });

  overlay.addEventListener('click', function(e){
    var close_ = e.target.closest('[data-cd-close]');
    if(close_){ e.preventDefault(); close(); return; }
    if(e.target === overlay){ close(); return; }

    var inc = e.target.closest('[data-cd-inc]');
    if(inc){ changeLine(inc.getAttribute('data-cd-key'), (parseInt(inc.getAttribute('data-cd-qty'),10)||0) + 1); return; }
    var dec = e.target.closest('[data-cd-dec]');
    if(dec){ changeLine(dec.getAttribute('data-cd-key'), Math.max(0,(parseInt(dec.getAttribute('data-cd-qty'),10)||0) - 1)); return; }
    var rm = e.target.closest('[data-cd-remove]');
    if(rm){ changeLine(rm.getAttribute('data-cd-key'), 0); return; }

    var removeCode = e.target.closest('[data-cd-promo-remove]');
    if(removeCode){ clearAppliedBadge(); return; }

    var clearCode = e.target.closest('[data-cd-clear-code]');
    if(clearCode){
      var code = clearCode.getAttribute('data-cd-clear-code');
      overlay.classList.add('is-busy');
      fetch('/discount/' + encodeURIComponent(''), { method:'GET', redirect:'manual' })
        .finally(function(){
          return fetch('/cart/update.js', {
            method:'POST',
            headers:{'Content-Type':'application/json','Accept':'application/json'},
            body: JSON.stringify({ discount: '' })
          });
        })
        .then(function(){ return refresh(); })
        .then(function(){ overlay.classList.remove('is-busy'); })
        .catch(function(){ overlay.classList.remove('is-busy'); });
      if(savedDiscount && savedDiscount.toUpperCase() === code.toUpperCase()){
        clearAppliedBadge();
      }
      return;
    }
  });

  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && overlay.classList.contains('open')) close(); });

  document.addEventListener('click', function(e){
    var t = e.target.closest('a[href$="/cart"], a[href*="/cart?"], [data-cart-drawer-open]');
    if(t){ e.preventDefault(); refresh().then(open); }
  });
  document.addEventListener('cart-drawer:open', function(){ refresh().then(open); });

  /* Listen for any theme or app that signals a successful cart add */
  document.addEventListener('cart:add', function(){ refresh().then(open); });
  document.addEventListener('cart-drawer:refresh', function(){ refresh(); });

  /* Intercept native add-to-cart form submissions so the drawer opens */
  document.addEventListener('submit', function(e){
    var form = e.target;
    if(!form || form.getAttribute('action') !== '/cart/add' && !form.dataset.productForm) return;
    if(form.hasAttribute('data-ritual-form')) return;
    var hasFile = Array.from(form.elements).some(function(el){ return el.type === 'file'; });
    if(hasFile) return;
    e.preventDefault();
    var data = new FormData(form);
    fetch('/cart/add.js',{
      method:'POST',
      headers:{'Accept':'application/json'},
      body: data
    }).then(function(r){
      if(r.ok){ refresh().then(open); }
    });
  });

  window.HerdrationCartDrawer = {
    open: function(){ return refresh().then(open); },
    close: close,
    refresh: refresh
  };
})();
</script>

{%- comment -%} ============ THEME EDITOR SCHEMA ============ {%- endcomment -%}
{% schema %}
{
  "name": "Her'dration Cart Drawer",
  "tag": "section",
  "class": "shopify-section--herdration-cart-drawer",
  "settings": [
    { "type": "paragraph", "content": "Cart drawer with subscription-aware gifts, discount validation, and full style controls." },

    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Drawer title", "default": "Your cart" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button label", "default": "Checkout securely" },
    { "type": "text", "id": "empty_text", "label": "Empty-cart message", "default": "Your cart is feeling light." },
    { "type": "text", "id": "trust_text", "label": "Trust line (footer)", "default": "30-day money-back guarantee" },

    { "type": "header", "content": "Free shipping bar" },
    { "type": "checkbox", "id": "show_free_ship", "label": "Show free-shipping progress bar", "default": true },
    { "type": "number", "id": "free_ship_threshold", "label": "Free shipping over (whole units)", "default": 45 },

    { "type": "header", "content": "Discount code" },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount-code field", "default": true },

    { "type": "header", "content": "Welcome gifts" },
    { "type": "checkbox", "id": "show_gifts", "label": "Show free welcome gifts", "default": true },
    { "type": "text", "id": "gifts_sub_title", "label": "Gifts heading (subscription)", "default": "Items Free With First Subscription Order" },
    { "type": "text", "id": "gifts_total_value", "label": "Total gift value in locked message", "default": "$10" },

    { "type": "header", "content": "── Colors ──" },
    { "type": "color", "id": "color_bg", "label": "Drawer background", "default": "#FAF5F0" },
    { "type": "color", "id": "color_text", "label": "Text color", "default": "#1B3A5C" },
    { "type": "color", "id": "color_accent", "label": "Accent (rose)", "default": "#E8607A" },
    { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#8A7E76" },
    { "type": "color", "id": "color_border", "label": "Borders / dividers", "default": "#E8DDD5" },
    { "type": "color", "id": "color_fog", "label": "Subtle background", "default": "#F5EEE8" },
    { "type": "color", "id": "color_btn_bg", "label": "Checkout button background", "default": "#E8607A" },
    { "type": "color", "id": "color_btn_text", "label": "Checkout button text", "default": "#ffffff" },

    { "type": "header", "content": "── Desktop Sizes ──" },
    { "type": "range", "id": "dt_panel_width", "label": "Drawer width (px)", "min": 320, "max": 600, "step": 10, "default": 430 },
    { "type": "range", "id": "dt_title_size", "label": "Title font size (px)", "min": 14, "max": 36, "step": 1, "default": 22 },
